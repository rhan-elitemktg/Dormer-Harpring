# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Python bytecode from the diff/audit scripts
__pycache__/

# one-off migration payloads (the SCRIPT is the record, not its output)
scratch/

# Build output from @astrojs/vercel — the deploy artifact, regenerated every
# build. Sibling of `dist/`, ignored above.
.vercel/

# EVERY dotenv form, not just the `.env` / `.env.production` pair above — which
# did NOT cover `.env.local`, the file `vercel env pull` writes. That one holds a
# live VERCEL_OIDC_TOKEN and whatever else is pulled. Added by `vercel link`.
.env*
