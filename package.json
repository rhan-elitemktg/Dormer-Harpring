{
  "name": "dormer-harpring",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:redirects && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:styles": "python3 scripts/check-scoped-styles.py $(find dist -name '*.html' -not -path 'dist/admin/*')",
    "prep:assets": "node scripts/prep-assets.mjs",
    "check:tokens": "python3 scripts/check-tokens.py",
    "check:links": "python3 scripts/check-links.py",
    "check:types": "astro check --minimumSeverity error",
    "check": "npm run check:types && npm run check:styles && npm run check:tokens && npm run check:links",
    "typegen": "sanity schema extract --path=./src/sanity/schema.json --enforce-required-fields --force && sanity typegen generate",
    "build:redirects": "tsx scripts/build-redirects.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@sanity/astro": "^3.5.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.1.6",
    "astro-portabletext": "^0.13.0",
    "groq": "^6.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "sanity": "^6.9.0",
    "styled-components": "^6.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-is": "^19.2.0",
    "node-html-parser": "^9.0.1",
    "typescript": "^6.0.3"
  }
}
