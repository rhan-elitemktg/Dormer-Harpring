---
// THREE PAGE SHAPES, ONE ROUTE FILE: blog posts, the heavy practice-area
// detail page, and the light practice-area template.
//
// THIS FILE IS AT THE SITE ROOT, and that is not a shortcut. `blogPath()` is
// `/${slug}` — the legacy WordPress site is flat at the root and ~300 live URLs
// depend on staying there, so a post cannot live under `/blog/`. Astro gives
// static routes priority over dynamic ones, so `/about`, `/news` and the rest
// still win, and only the paths `getStaticPaths` returns are ever built.
//
// `practiceAreaPath()` is ALSO `/${slug}`, and Astro allows exactly one
// `[slug].astro` per directory — so the two collections have to share this one.
// `getStaticPaths` unions them and every record carries a `kind`, which the
// template branches on, the same way `meet-our-attorneys/[slug].astro` branches
// on `member.kind`. Adding `src/pages/practice/[slug].astro` instead would
// change the URL, which is the one thing the flat shape exists to prevent.
//
// A slug collision between the two collections would silently build one page
// and drop the other, so it is checked below and throws instead.
//
// THE TWO PRACTICE-AREA SHAPES ARE NOT VARIANTS OF EACH OTHER. `area-detail`
// is the hand-authored 17-section kit in `components/practice/detail/`,
// reserved for special cases; `area-page` is the imported one — a title, a body
// and a FAQ, built like the blog post. One of the first exists; 109 of the
// second do. They share this route because they share a URL shape, nothing
// more.
//
// SURFACE ORDER, which nothing in the build checks (see HANDOFF):
//   post        cream `.post`  → forest `.related` → cream `.ct`
//   area-page   cream `.parea` → sunk `.awards`    → cream `.ct`
// Both alternate. Reordering either branch means re-checking that they still
// do — three cream sections in a row is invisible in review and obvious on the
// page. `.awards` is `tone="sunk"` for exactly that reason: `lifted` is
// cream-50, which is 1.009:1 against `.parea`'s cream-100 and so invisible.
// It is also what stands where the city band used to.
//
// NEITHER BRANCH HAS A PAGE HEADER, and the area-page branch briefly had two
// different ones — Testimonials' photo band, then `/results/`' forest band —
// before both were dropped by request. Both templates now open the way the post
// comp does: the site header runs straight into the cream article, whose own
// eyebrow and title stand in for a header. Adding one back means moving the H1
// again, because two <h1>s cannot happen.
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import PostArticle from "../components/blog/PostArticle.astro";
import RelatedPosts from "../components/blog/RelatedPosts.astro";
import ContactDetails from "../components/contact/ContactDetails.astro";
import DetailPage from "../components/practice/detail/DetailPage.astro";
import AreaArticle from "../components/practice/area/AreaArticle.astro";
import AwardsBar from "../components/AwardsBar.astro";
import {
  getBlogCategories,
  getBlogPostArticles,
  getBlogPostPage,
  getBlogPosts,
  getFeaturedPost,
  getRelatedPosts,
  getRelatedPostsForArea,
} from "../data/blog";
import {
  getPracticeAreaArticles,
  getPracticeAreaPageCopy,
  getPracticeAreaSidebarLinks,
} from "../data/practiceAreaPages";
import { CA_SECTION_IDS, getPracticeAreaDetails } from "../data/carAccidents";
import { getContactBand, getContactDetails } from "../data/contact";
import { getCarAccidentFaqSection, getCarAccidentFaqs } from "../data/faqs";
import { getAwards } from "../data/awards";
import { getFirmDetails } from "../data/site";
import { getTeam } from "../data/team";
import {
  getHomeTestimonials,
  getReviewSummary,
  getVideoReviews,
} from "../data/testimonials";

export const getStaticPaths = (async () => {
  const [articles, featured, posts, details, areaPages] = await Promise.all([
    getBlogPostArticles(),
    getFeaturedPost(),
    getBlogPosts(),
    getPracticeAreaDetails(),
    getPracticeAreaArticles(),
  ]);

  // ONE LIST OF ARTICLES, ONE FEED. Both used to be unions: the articles were
  // the hand-authored one plus the import, and the feed had been three lists
  // before that. Phase 3b made every post a document, so `getBlogPostArticles()`
  // is all 186 and `getBlogPosts()` is the 185 the panel does not already show.
  //
  // The feed still has the featured post PREPENDED rather than queried in — it
  // is excluded from `getBlogPosts()` on purpose, because /news renders it in
  // its own panel above the grid, and the join below needs every article to
  // find its card.
  const feed = [featured, ...posts];

  // Walk the ARTICLES, not the feed — the same contract
  // `meet-our-attorneys/[slug].astro` holds. A post with no body has no page,
  // and its card on the index keeps pointing at the legacy URL it already
  // points at, rather than at a route that was never built.
  const postPaths = await Promise.all(
    articles.map(async (article) => {
      const post = feed.find((entry) => entry._key === article._key);
      if (!post) {
        throw new Error(`blog: article "${article.slug}" has no post in the feed`);
      }

      return {
        params: { slug: article.slug },
        props: {
          kind: "post" as const,
          article,
          post,
          // Resolved here rather than in the component so the page stays one
          // await of everything it renders. 5 for the sidebar, 3 for the band.
          sidebarRelated: await getRelatedPosts(article._key, 5),
          bandRelated: await getRelatedPosts(article._key, 3),
        },
      };
    })
  );

  const detailPaths = details.map((detail) => ({
    params: { slug: detail.slug },
    props: { kind: "area-detail" as const, detail },
  }));

  // Everything the light template renders is resolved HERE, the same way the
  // post branch resolves its two related lists — so the page stays one await of
  // what it shows and no component fetches behind its back.
  const areaPaths = await Promise.all(
    areaPages.map(async (article) => {
      const [sidebarAreas, related] = await Promise.all([
        getPracticeAreaSidebarLinks(article.city, article.slug),
        getRelatedPostsForArea(article.slug, 5),
      ]);
      return {
        params: { slug: article.slug },
        props: { kind: "area-page" as const, article, sidebarAreas, related },
      };
    })
  );

  // NAMES BOTH CLAIMANTS. The message used to say "a blog post and a practice
  // area" whatever the actual pair was, which sent the first post-vs-post
  // collision — a hand-authored article and its own imported copy — looking in
  // the wrong place entirely.
  //
  // A LOOKUP, NOT A TERNARY. With two kinds a ternary was exact; with three it
  // silently mislabels the newest one — which is the very failure the message
  // was rewritten to prevent, reintroduced by the change that added a shape.
  const KIND_LABEL: Record<"post" | "area-detail" | "area-page", string> = {
    post: "a blog post",
    "area-detail": "a practice-area detail page",
    "area-page": "an imported practice-area page",
  };

  const seen = new Map<string, string>();
  for (const entry of [...postPaths, ...detailPaths, ...areaPaths]) {
    const kind = KIND_LABEL[entry.props.kind];
    const prior = seen.get(entry.params.slug);
    if (prior) {
      throw new Error(
        `/${entry.params.slug} is claimed by ${prior} AND ${kind}. Astro would ` +
          `build one and silently drop the other.`
      );
    }
    seen.set(entry.params.slug, kind);
  }

  return [...postPaths, ...detailPaths, ...areaPaths];
}) satisfies GetStaticPaths;

const props = Astro.props;

// Each branch awaits only what its own shape renders. Both are resolved in one
// `Promise.all` for the same reason every other page here is: one await of
// everything the page shows, and no component fetching behind the page's back.
const blog =
  props.kind === "post"
    ? await (async () => {
        const [page, categories, band, details] = await Promise.all([
          getBlogPostPage(),
          getBlogCategories(),
          getContactBand(),
          getContactDetails(),
        ]);
        return { page, categories, band, details };
      })()
    : null;

const area =
  props.kind === "area-detail"
    ? await (async () => {
        const [
          firm,
          team,
          videoReviews,
          awardList,
          testimonials,
          reviewSummary,
          faqs,
          faqSection,
          contact,
          band,
        ] = await Promise.all([
          getFirmDetails(),
          getTeam(),
          getVideoReviews(),
          getAwards(),
          getHomeTestimonials(),
          getReviewSummary(),
          getCarAccidentFaqs(),
          getCarAccidentFaqSection(`#${CA_SECTION_IDS.contact}`),
          getContactDetails(),
          getContactBand(),
        ]);

        // The lawyers band names four people by key, and pairs each with a
        // credential line the PAGE owns — `team.ts` has the portrait and the
        // role, this document has what they do on crash cases. Resolved in the
        // data's order rather than the roster's.
        const byKey = new Map(team.map((member) => [member._key, member]));
        const lawyers = props.detail.lawyers.attorneys.map((entry) => {
          const member = byKey.get(entry.key);
          if (!member) {
            throw new Error(
              `${props.detail.slug}: no team member with _key "${entry.key}". ` +
                `Fix the key in data/carAccidents.ts or add them to data/team.ts.`
            );
          }
          return { ...member, cred: entry.cred };
        });

        // Each credential badge names an award record; the caption and the link
        // beside it are the page's.
        const awardByKey = new Map(awardList.map((award) => [award._key, award]));
        const awards = Object.fromEntries(
          props.detail.credentials.badges.map((badge) => {
            const award = awardByKey.get(badge.awardKey);
            if (!award) {
              throw new Error(
                `${props.detail.slug}: badge "${badge._key}" names award ` +
                  `"${badge.awardKey}", which is not in getAwards().`
              );
            }
            return [badge.awardKey, award];
          })
        );

        // The one result story that is a video keys into a real client review.
        const reviews = Object.fromEntries(
          props.detail.results.stories
            .filter((story) => story.reviewKey)
            .map((story) => {
              const review = videoReviews.find((r) => r._key === story.reviewKey);
              if (!review) {
                throw new Error(
                  `${props.detail.slug}: result "${story._key}" names review ` +
                    `"${story.reviewKey}", which is not in getVideoReviews().`
                );
              }
              return [story.reviewKey as string, review];
            })
        );

        return {
          firm,
          lawyers,
          awards,
          reviews,
          testimonials,
          reviewSummary,
          faqs,
          faqSection,
          contact,
          contactForm: band.form,
        };
      })()
    : null;

const areaPage =
  props.kind === "area-page"
    ? await (async () => {
        const [page, awards, contact, band] = await Promise.all([
          getPracticeAreaPageCopy(),
          getAwards(),
          getContactDetails(),
          getContactBand(),
        ]);
        return { page, awards, contact, form: band.form };
      })()
    : null;

const title =
  props.kind === "post"
    ? props.post.title
    : props.kind === "area-detail"
      ? props.detail.metaTitle
      : props.article.metaTitle;
const description =
  props.kind === "post"
    ? props.post.excerpt
    : props.kind === "area-detail"
      ? props.detail.metaDescription
      : props.article.metaDescription;

// The detail page's `Attorney` structured data needs absolute urls. Same
// fallback Layout.astro uses, for the same reason: `astro dev` can run without
// `site` set and the template literal would otherwise interpolate "undefined".
const siteUrl = (Astro.site?.href ?? "https://www.denvertrial.com/").replace(/\/+$/, "");
---

<Layout title={title} description={description}>
  {
    props.kind === "post" && blog && (
      <>
        <PostArticle
          post={props.post}
          article={props.article}
          page={blog.page}
          categories={blog.categories}
          related={props.sidebarRelated}
        />

        <RelatedPosts
          title={blog.page.relatedTitle}
          posts={props.bandRelated}
          readMoreLabel={blog.page.readMoreLabel}
        />

        {/* The same contact block /news and every interior page already close on. */}
        <ContactDetails details={blog.details} form={blog.band.form} />
      </>
    )
  }

  {
    props.kind === "area-detail" && area && (
      <DetailPage
        detail={props.detail}
        firm={area.firm}
        lawyers={area.lawyers}
        awards={area.awards}
        reviews={area.reviews}
        testimonials={area.testimonials}
        reviewSummary={area.reviewSummary}
        faqs={area.faqs}
        faqSection={area.faqSection}
        contact={area.contact}
        contactForm={area.contactForm}
        siteUrl={siteUrl}
      />
    )
  }

  {
    props.kind === "area-page" && areaPage && (
      <>
        <AreaArticle
          article={props.article}
          page={areaPage.page}
          areas={props.sidebarAreas}
          related={props.related}
          faqId="faqs"
        />

        {/* Where the post page runs its "Related blog posts" band, and where
            the city band used to be — removed by request, since the sidebar's
            Practice Areas card answers the same question. The homepage's
            awards bar takes the slot; `sunk`, not the default `lifted`, or it
            would be invisible against the cream above it. */}
        <AwardsBar awards={areaPage.awards} tone="sunk" />

        {/* The same contact block /news and every interior page already close on. */}
        <ContactDetails details={areaPage.contact} form={areaPage.form} />
      </>
    )
  }
</Layout>
