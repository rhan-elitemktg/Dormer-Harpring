---
// The practice-area hub. Seven sections, five of which are bands this site
// already builds elsewhere — only the featured grid and the directory are new.
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FeaturedAreas from "../components/practice/FeaturedAreas.astro";
import AreaDirectory from "../components/practice/AreaDirectory.astro";
import StatsBand from "../components/StatsBand.astro";
import WhyUs from "../components/home/WhyUs.astro";
import AttorneysBand from "../components/home/AttorneysBand.astro";
import ContactDetails from "../components/contact/ContactDetails.astro";
import {
  getPracticeAreasPage,
  getFeaturedPracticeAreas,
  getPracticeAreaGroups,
} from "../data/practiceAreas";
import { getFirmStats } from "../data/stats";
import { getHomeWhyUs } from "../data/home";
import { getAttorneysSection, getHomeAttorneys } from "../data/attorneys";
import { getContactBand, getContactDetails } from "../data/contact";
import { assertDirectoryJoin } from "../data/practiceAreaPages";

// `getHomeWhyUs` and the attorneys band are read straight from the homepage's
// modules rather than copied: the comp carries both sections here WORD FOR WORD,
// so they are shared singletons, not this page's content. If they ever diverge
// the fix is a second document in the CMS, not a second copy of the strings.
const [page, featured, groups, stats, why, attorneysSection, attorneys, band, details] =
  await Promise.all([
    getPracticeAreasPage(),
    getFeaturedPracticeAreas(),
    getPracticeAreaGroups(),
    getFirmStats(),
    getHomeWhyUs(),
    getAttorneysSection(),
    getHomeAttorneys(),
    getContactBand(),
    getContactDetails(),
  ]);

/* THE DIRECTORY AND THE COLLECTION ARE TWO HAND-MAINTAINED LISTS OF ONE THING,
   and drift between them is silent in both directions: an entry with no page is
   a 404 this build would happily ship, and a page in no group is a page nothing
   links to. Asserted here, at the one place that renders the directory, because
   throwing at build time is what the rest of this codebase does with a broken
   cross-reference — see the three resolve-and-throw joins in `[slug].astro`. */
await assertDirectoryJoin(groups);
---

<Layout
  title="Practice Areas"
  description="The injury cases Dormer Harpring takes on across Colorado — car and truck crashes, premises liability, catastrophic injury and wrongful death."
>
  <PageHeader
    eyebrow={page.eyebrow}
    title={page.title}
    lede={page.lede}
    tone="photo"
    photo={page.photo}
    photoMobile={page.photoMobile}
    photoAlt={page.photoAlt}
    minHeight={560}
  >
    <div class="hero-cta">
      <a class="btn btn--red btn--lg" href="#contact">{page.ctaLabel}</a>
      <span class="hero-cta__note">{page.ctaNote}</span>
    </div>
  </PageHeader>

  <FeaturedAreas section={page.featured} areas={featured} />
  <AreaDirectory section={page.directory} groups={groups} />
  <StatsBand stats={stats} />
  <WhyUs why={why} />
  <AttorneysBand section={attorneysSection} attorneys={attorneys} />
  <ContactDetails details={details} form={band.form} />
</Layout>

