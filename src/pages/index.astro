---
// The homepage. Sections are added in the comp's order; this file fetches and
// passes props, and never holds content of its own.
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import RecentResults from "../components/home/RecentResults.astro";
import FirmIntro from "../components/home/FirmIntro.astro";
import AwardsBar from "../components/AwardsBar.astro";
import Testimonials from "../components/home/Testimonials.astro";
import {
  getHomeHero,
  getHomeStats,
  getRecentResults,
  getHomeFirmIntro,
  getHomeWhyUs,
  getHomePromise,
} from "../data/home";
import PracticeSelector from "../components/home/PracticeSelector.astro";
import WhyUs from "../components/home/WhyUs.astro";
import AttorneysBand from "../components/home/AttorneysBand.astro";
import CoreValues from "../components/CoreValues.astro";
import PromiseBand from "../components/home/PromiseBand.astro";
import FaqBand from "../components/home/FaqBand.astro";
import { getAwards } from "../data/awards";
import { getAttorneysSection, getHomeAttorneys } from "../data/attorneys";
import { getCoreValues, getCoreValuesSection } from "../data/coreValues";
import { getFaqSection, getHomeFaqs } from "../data/faqs";
import { getHomeTestimonials, getReviewSummary } from "../data/testimonials";
import {
  getPracticeSection,
  getHomePracticeAreas,
  getPracticePromise,
  getCatastrophicAreas,
} from "../data/practiceAreas";

const [
  hero,
  stats,
  results,
  intro,
  awards,
  testimonials,
  reviews,
  practiceSection,
  areas,
  practicePromise,
  catastrophic,
  why,
  attorneysSection,
  attorneys,
  valuesSection,
  values,
  promise,
  faqSection,
  faqs,
] = await Promise.all([
  getHomeHero(),
  getHomeStats(),
  getRecentResults(),
  getHomeFirmIntro(),
  getAwards(),
  getHomeTestimonials(),
  getReviewSummary(),
  getPracticeSection(),
  getHomePracticeAreas(),
  getPracticePromise(),
  getCatastrophicAreas(),
  getHomeWhyUs(),
  getAttorneysSection(),
  getHomeAttorneys(),
  getCoreValuesSection(),
  getCoreValues(),
  getHomePromise(),
  getFaqSection(),
  getHomeFaqs(),
]);
---

<Layout
  title="Denver Personal Injury Lawyers"
  description="Dormer Harpring is a boutique Denver personal injury law firm. We take on fewer cases — so yours gets our full attention, and our full fight."
  headerVariant="transparent"
>
  <Hero hero={hero} stats={stats} />
  <RecentResults results={results} />
  <FirmIntro intro={intro} />
  <AwardsBar awards={awards} />
  <Testimonials testimonials={testimonials} reviews={reviews} />
  <PracticeSelector
    section={practiceSection}
    areas={areas}
    promise={practicePromise}
    catastrophic={catastrophic}
  />
  <WhyUs why={why} />
  <AttorneysBand section={attorneysSection} attorneys={attorneys} />
  <CoreValues section={valuesSection} values={values} />
  <PromiseBand promise={promise} />
  <FaqBand section={faqSection} faqs={faqs} />
</Layout>
