---
// The homepage. Sections are added in the comp's order; this file fetches and
// passes props, and never holds content of its own.
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import RecentResults from "../components/home/RecentResults.astro";
import FirmIntro from "../components/home/FirmIntro.astro";
import AwardsBar from "../components/AwardsBar.astro";
import TestimonialRail from "../components/TestimonialRail.astro";
import {
  getHomeHero,
  getRecentResults,
  getHomeFirmIntro,
  getHomeWhyUs,
  getHomePromise,
  getResultsStrip,
  getAwardsBar,
  getTestimonialRail,
} from "../data/home";
import PracticeSelector from "../components/home/PracticeSelector.astro";
import WhyUs from "../components/home/WhyUs.astro";
import AttorneysBand from "../components/home/AttorneysBand.astro";
import CoreValues from "../components/CoreValues.astro";
import PromiseBand from "../components/home/PromiseBand.astro";
import FaqBand from "../components/home/FaqBand.astro";
import ContactBand from "../components/contact/ContactBand.astro";
import NewsInsights from "../components/home/NewsInsights.astro";
import CommunityBand from "../components/home/CommunityBand.astro";
import { getAwards } from "../data/awards";
import { getSeo } from "../data/seo";
import { getFirmStats } from "../data/stats";
import { getAttorneysSection, getHomeAttorneys } from "../data/attorneys";
import { getCoreValues, getCoreValuesSection } from "../data/coreValues";
import { getFaqSection, getHomeFaqs } from "../data/faqs";
import { getContactBand } from "../data/contact";
import { getFeedSection, getPressMentions, getInsightTeasers } from "../data/news";
import {
  getCommunitySection,
  getCommunityPhotos,
  getCharityPartners,
} from "../data/community";
import { getHomeTestimonials, getReviewSummary } from "../data/testimonials";
import {
  getPracticeSection,
  getHomePracticeAreas,
  getCatastrophicAreas,
} from "../data/practiceAreas";

const [
  pageSeo,
  hero,
  stats,
  results,
  resultsStrip,
  intro,
  awards,
  awardsBar,
  testimonials,
  reviews,
  railCopy,
  practiceSection,
  areas,
  catastrophic,
  why,
  attorneysSection,
  attorneys,
  valuesSection,
  values,
  promise,
  faqSection,
  faqs,
  contactBand,
  feedSection,
  newsItems,
  insights,
  communitySection,
  communityPhotos,
  ngoPartners,
] = await Promise.all([
  getSeo("homePage"),
  getHomeHero(),
  getFirmStats(),
  getRecentResults(),
  getResultsStrip(),
  getHomeFirmIntro(),
  getAwards(),
  getAwardsBar(),
  getHomeTestimonials(),
  getReviewSummary(),
  getTestimonialRail(),
  getPracticeSection(),
  getHomePracticeAreas(),
  getCatastrophicAreas(),
  getHomeWhyUs(),
  getAttorneysSection(),
  getHomeAttorneys(),
  getCoreValuesSection(),
  getCoreValues(),
  getHomePromise(),
  getFaqSection(),
  getHomeFaqs(),
  getContactBand(),
  getFeedSection(),
  getPressMentions(),
  getInsightTeasers(),
  getCommunitySection(),
  getCommunityPhotos(),
  getCharityPartners(),
]);
---

<Layout
  seo={pageSeo}
  title="Denver Personal Injury Lawyers"
  description="Dormer Harpring is a boutique Denver personal injury law firm. We take on fewer cases — so yours gets our full attention, and our full fight."
  headerVariant="transparent"
>
  <Hero hero={hero} stats={stats} />
  <RecentResults results={results} copy={resultsStrip} />
  <FirmIntro intro={intro} />
  <AwardsBar awards={awards} eyebrow={awardsBar.eyebrow} />
  <TestimonialRail testimonials={testimonials} reviews={reviews} copy={railCopy} />
  <PracticeSelector
    section={practiceSection}
    areas={areas}
    catastrophic={catastrophic}
  />
  <WhyUs why={why} />
  <AttorneysBand section={attorneysSection} attorneys={attorneys} />
  <CoreValues section={valuesSection} values={values} />
  <PromiseBand promise={promise} />
  <FaqBand section={faqSection} faqs={faqs} />
  <ContactBand band={contactBand} />
  <NewsInsights section={feedSection} news={newsItems} insights={insights} />
  <CommunityBand
    section={communitySection}
    photos={communityPhotos}
    partners={ngoPartners}
  />
</Layout>
