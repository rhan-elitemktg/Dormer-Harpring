---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactDetails from "../components/contact/ContactDetails.astro";
import FindUs from "../components/contact/FindUs.astro";
import { getContactPage } from "../data/contactPage";
import { getContactBand, getContactDetails } from "../data/contact";

// The form's copy and the contact block are shared singletons, not page content
// — they are the same on a dozen pages, and they should read the same on all of
// them. Only the header and the map below are this page's own.
const [page, band, details] = await Promise.all([
  getContactPage(),
  getContactBand(),
  getContactDetails(),
]);
---

<Layout
  title="Contact Us"
  description="Talk to a Denver personal injury attorney. Free, confidential case review — call, text, email, or visit our RiNo office."
>
  <PageHeader
    eyebrow={page.eyebrow}
    title={page.title}
    lede={page.lede}
    tone="forest"
  />
  <ContactDetails details={details} form={band.form} />
  <FindUs find={page.find} />
</Layout>
