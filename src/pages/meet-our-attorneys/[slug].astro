---
// One page per profile — the seven attorneys and the eighteen staff the live
// site publishes a bio for. `getStaticPaths` walks the profiles rather than the
// roster, so a person without one has no page; `getTeam` derives their card's
// href from the same set, so nothing links to a route that was never built.
//
// Two layouts, picked on `kind`: two thousand words against a card rail for
// the attorneys, one centred column for everyone else. See StaffBio.astro for
// why that is a separate component rather than the same one with more of its
// blocks absent.
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import AttorneyBio from "../../components/team/AttorneyBio.astro";
import StaffBio from "../../components/team/StaffBio.astro";
import TestimonialRail from "../../components/TestimonialRail.astro";
import ContactDetails from "../../components/contact/ContactDetails.astro";
import { getTeamProfiles, getTeam } from "../../data/team";
import { getFirmDetails } from "../../data/site";
import { getContactBand, getContactDetails } from "../../data/contact";
import { getHomeTestimonials, getReviewSummary } from "../../data/testimonials";

export const getStaticPaths = (async () => {
  const [profiles, team] = await Promise.all([getTeamProfiles(), getTeam()]);
  const partners = team.filter((m) => m.kind === "partner");

  return profiles.map((profile) => {
    const member = team.find((m) => m._key === profile.slug)!;
    // Whoever signed off the profile — a founding partner, and never the
    // subject of it. The comp shows K.C. approving Sean's.
    const reviewer = partners.find((p) => p._key !== profile.slug);
    return {
      params: { slug: profile.slug },
      props: {
        profile,
        member,
        reviewer: reviewer && { name: reviewer.name, href: reviewer.href },
      },
    };
  });
}) satisfies GetStaticPaths;

const { profile, member, reviewer } = Astro.props;
const [firm, band, details, testimonials, reviews] = await Promise.all([
  getFirmDetails(),
  getContactBand(),
  getContactDetails(),
  getHomeTestimonials(),
  getReviewSummary(),
]);

const isAttorney = member.kind === "partner" || member.kind === "attorney";
---

<Layout
  title={member.name}
  description={`${member.name}, ${member.role} at Dormer Harpring — Denver personal injury trial lawyers.`}
>
  {
    isAttorney ? (
      <AttorneyBio member={member} profile={profile} firm={firm} reviewer={reviewer} />
    ) : (
      <StaffBio member={member} profile={profile} />
    )
  }
  {
    /* The comp puts the rail on the attorney bio only. Firm-wide reviews under
       a paralegal's profile would read as that person's, so the staff layout
       goes straight to the contact band. */
  }
  {isAttorney && <TestimonialRail testimonials={testimonials} reviews={reviews} />}
  <ContactDetails details={details} form={band.form} />
</Layout>
