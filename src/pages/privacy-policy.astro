---
// The privacy policy, transcribed from the live page. See
// `getPrivacyPolicyPage()` for the three deliberate departures from it — the
// phone number, the duplicated heading, and which date is stamped.
//
// SURFACE ORDER, which nothing in the build checks (see HANDOFF):
//   cream `.spage` → sunk `.awards` → cream `.ct`
// The light practice-area template's own order, and for its reason: `.ct` is
// cream, so something visibly not-cream has to sit between them. `lifted` is
// `--dh-cream-50` at 1.009:1 against cream-100 — the invisible-surface trap —
// so the awards bar takes `sunk` here exactly as it does there and on About.
//
// This page WAS a dead link on all 328 pages of the site until now: the footer
// linked `ROUTES.privacy` and nothing built it. `scripts/check-links.py`
// declared it in KNOWN_DEAD; that entry is gone with this file.
import Layout from "../layouts/Layout.astro";
import PageArticle from "../components/page/PageArticle.astro";
import AreaSidebar from "../components/practice/area/AreaSidebar.astro";
import AwardsBar from "../components/AwardsBar.astro";
import ContactDetails from "../components/contact/ContactDetails.astro";
import { getPrivacyPolicyPage } from "../data/sitePages";
import { getAwards } from "../data/awards";
import { getContactBand, getContactDetails } from "../data/contact";
import {
  getPracticeAreaPageCopy,
  getPracticeAreaSidebarLinks,
} from "../data/practiceAreaPages";
import { getBlogPosts } from "../data/blog";

const [page, awards, details, band, areaCopy, sidebarAreas, posts] = await Promise.all([
  getPrivacyPolicyPage(),
  getAwards(),
  getContactDetails(),
  getContactBand(),
  getPracticeAreaPageCopy(),
  getPracticeAreaSidebarLinks("denver", ""),
  getBlogPosts(),
]);

/* THE PRACTICE-AREA SIDEBAR, by request — the same three cards those pages
   carry. Two of its inputs have no natural value on a page that is not a
   practice area, so both are chosen rather than invented:

   - `getPracticeAreaSidebarLinks("denver", "")`. The second argument is the
     CURRENT slug, used to centre the twelve-entry window and highlight the row
     you are on. There is no current page here, and the getter already handles
     that: `at < 0` starts the window at the head and nothing gets `current`,
     so the card reads as a plain list with its "View All Practice Areas" link.
     Denver because it is the firm's own city and its 50 pages are the ones a
     visitor is most likely to want.
   - `relatedSidebarLabel` is overridden. `PracticeAreaPageCopy` says "Related
     articles", which is a claim about subject-matching that `getRelatedPostsForArea`
     earns and a privacy policy cannot. These are the five most recent posts, so
     the card says so. */
const sidebarCopy = { ...areaCopy, relatedSidebarLabel: "Latest articles" };
const latest = posts.filter((post) => post.href).slice(0, 5);
---

<Layout
  title={page.title}
  description="How Dormer Harpring collects, uses and protects the information you share through this website."
>
  <PageArticle
    title={page.title}
    body={page.body}
    stamp={page.updatedAt}
    metaLabel={page.updatedLabel}
  >
    <AreaSidebar
      slot="sidebar"
      page={sidebarCopy}
      areas={sidebarAreas}
      related={latest}
    />
  </PageArticle>

  <AwardsBar awards={awards} tone="sunk" />
  <ContactDetails details={details} form={band.form} />
</Layout>
