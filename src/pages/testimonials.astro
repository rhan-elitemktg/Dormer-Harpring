---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import VideoReviews from "../components/testimonials/VideoReviews.astro";
import WrittenReviews from "../components/testimonials/WrittenReviews.astro";
import StatsBand from "../components/StatsBand.astro";
import ContactDetails from "../components/contact/ContactDetails.astro";
import {
  getTestimonialsPage,
  getVideoReviews,
  getWrittenReviews,
} from "../data/testimonials";
import { getFirmStats } from "../data/stats";
import { getSeo } from "../data/seo";
import { getContactBand, getContactDetails } from "../data/contact";
import { ROUTES } from "../lib/routePaths";

const [pageSeo, page, videos, written, stats, band, details] = await Promise.all([
  getSeo("testimonialsPage"),
  getTestimonialsPage(),
  getVideoReviews(),
  getWrittenReviews(),
  getFirmStats(),
  getContactBand(),
  getContactDetails(),
]);
---

<Layout
  seo={pageSeo}
  title="Client Testimonials"
  description="Read and watch what Dormer Harpring clients say about working with our Denver personal injury attorneys."
>
  <PageHeader
    eyebrow={page.eyebrow}
    title={page.title}
    lede={page.lede}
    tone="photo"
    photo={page.photo}
    photoMobile={page.photoMobile}
    photoAlt={page.photoAlt}
    minHeight={520}
  >
    <div class="hero-cta">
      <a class="btn btn--red btn--lg" href={ROUTES.contact}>{page.ctaLabel}</a>
      <span class="hero-cta__note">{page.ctaNote}</span>
    </div>
  </PageHeader>

  <VideoReviews section={page.videos} reviews={videos} />
  <WrittenReviews section={page.written} reviews={written} />
  <StatsBand stats={stats} />
  <ContactDetails details={details} form={band.form} />
</Layout>

