---
// The dark "by the numbers" band — four figures divided by hairlines.
//
// At src/components/ root because eight comps carry it: Testimonials, About,
// Case Results, Attorneys, Community, Co-Counsel, Practice Areas and the
// practice-area detail — where the same four figures appear under the heading
// "The firm at a glance" as `.ca-keys`.
import type { FirmStat } from "../data/stats";

interface Props {
  stats: FirmStat[];
  /**
   * `band` is the full-bleed dark band the seven page comps carry.
   *
   * `card` is the same figures as a contained, rounded card on whatever surface
   * it sits on. The practice-area detail needs it because the band there falls
   * between the white awards bar and the forest testimonials rail — full-bleed,
   * it merges with the rail below and the boundary between two sections
   * disappears. Same content, same markup, one less edge.
   */
  variant?: "band" | "card";
  /** Read out by a screen reader in place of the missing heading. */
  label?: string;
}

const { stats, variant = "band", label } = Astro.props;
---

<section class:list={["stats", `stats--${variant}`]} aria-label={label}>
  <dl class="stats__grid">
    {
      stats.map((stat) => (
        <div class="stats__cell">
          <span class="stats__rule" aria-hidden="true" />
          {/* <dd> before <dt>: the figure reads first and the label explains
              it, which is the visual order and the sensible reading order. A
              definition list allows either. */}
          <dd class="stats__big">{stat.big}</dd>
          <dt class="stats__label">{stat.label}</dt>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* The band is the DEFAULT and keeps the bare `.stats` selector, rather than
     both variants being modifiers off an empty base. `HeroStats.astro` styles a
     `.stats` of its own, and `check:styles` treats one class name as belonging
     to one component — leaving `.stats` unclaimed here reports every StatsBand
     on the site as unstyled. */
  .stats {
    background: var(--dh-forest-500);
    border-block: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* The card sits ON a section rather than being one, so it drops the band's
     fill and edges and supplies its own padding, taking the dark inwards. */
  .stats--card {
    background: none;
    border-block: 0;
    padding: 0 var(--container-pad) var(--space-18);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: var(--container-max);
    margin-inline: auto;
  }

  /* `--container-max` is a BORDER-box width, so the card matches `.container`'s
     content width only once the pad is taken back off it. */
  .stats--card .stats__grid {
    max-width: calc(var(--container-max) - var(--container-pad) * 2);
    background: var(--dh-forest-500);
    border-radius: var(--radius-4);
    overflow: hidden;
  }

  .stats__cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-13) var(--space-10);
  }

  /* Dividers BETWEEN cells only — the band's outer edges are closed by the
     section's own top and bottom rules, and a vertical rule at the left and
     right of the row reads as a box drawn around nothing. The adjacent-sibling
     selector gets this for free: the first cell has no preceding sibling. */
  .stats__cell + .stats__cell {
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stats__rule {
    width: 28px;
    height: 3px;
    margin-bottom: var(--space-5);
    background: var(--accent-gold);
  }

  .stats__big {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--display-3);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--dh-parchment);
  }

  .stats__label {
    margin-top: var(--space-4);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-label);
    line-height: 1.5;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dh-gold-label);
  }

  @media (max-width: 980px) {
    .stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats__cell {
      padding: var(--space-10) var(--space-8);
    }

    /* The third cell now STARTS a row, so "the cell before it" is on the line
       above and its left rule would land on the band's edge. Same specificity
       as the rule it undoes, so it has to come after it — which it does. */
    .stats__cell:nth-child(2n + 1) {
      border-left: 0;
    }

    .stats__cell:nth-child(n + 3) {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  @media (max-width: 560px) {
    .stats__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Written against the same selector rather than plain `.stats__cell`: one
       class would lose to `.stats__cell + .stats__cell` on specificity and the
       rules would survive into the single-column layout. */
    .stats__cell + .stats__cell {
      border-left: 0;
    }

    .stats__cell:nth-child(n + 2) {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
  }
</style>
