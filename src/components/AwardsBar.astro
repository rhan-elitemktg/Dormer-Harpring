---
// The "Recognized & awarded" trust bar.
//
// At src/components/ root rather than under home/ because the About page runs
// the same band with identical markup — the first of the four shared bands.
//
// A wrapped row on desktop, a two-up carousel below 760px. The wrap is what
// forces it: six badges on a phone break to 4 + 2, which reads as a leftover
// row rather than a set, and shrinking them far enough to fit one row makes
// the small print on the TopVerdict and Avvo seals unreadable.
import Picture from "./media/Picture.astro";
import type { Award } from "../data/awards";

interface Props {
  awards: Award[];
  eyebrow?: string;
}

const { awards, eyebrow = "Recognized & awarded" } = Astro.props;
---

<section class="awards">
  <div class="awards__inner">
    <p class="awards__eyebrow">{eyebrow}</p>

    {
      /* `role="group"` + tabindex so the rail is reachable and announced by a
         keyboard user, who has no swipe. The dots below are the pointer
         affordance; this is the other half. */
    }
    <div
      class="awards__rail noscroll"
      data-rail="awards"
      data-rail-step="2"
      tabindex="0"
      role="group"
      aria-label="Awards and recognition, scrollable"
    >
      <ul class="awards__list">
        {
          awards.map((award) => (
            <li class="awards__item" data-height={award.height}>
              <Picture src={award.image} alt={award.alt} class="awards__badge" />
            </li>
          ))
        }
      </ul>
    </div>

    {
      /* Dots only, no arrows: this rail carousels below 760px and is a static
         row above it, so the arrows it used to carry were mobile-only anyway
         and the dots replace them outright. Filled by scripts/rail.ts. */
    }
    <div class="rail-dots" data-rail-dots="awards"></div>
  </div>
</section>

<style>
  .awards {
    background: var(--dh-cream-50);
  }

  .awards__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    max-width: var(--measure-wide);
    margin-inline: auto;
    padding: var(--space-section-sm) var(--container-pad);
  }

  /* No gold rule here — this is a bar label, not a section opener, so it
     deliberately isn't the shared `.eyebrow`. */
  .awards__eyebrow {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-gold-deep);
  }

  /* `stretch`, not `width: 100%`: the inner is a centred column, and a 100%-wide
     item carrying the negative margins below would keep its width and simply
     shift left, overflowing the page by one --container-pad. */
  .awards__rail {
    align-self: stretch;
  }

  .awards__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-6) var(--space-12);
    list-style: none;
    padding: 0;
  }

  /* Height comes from a data attribute rather than an inline style: the badges
     are drawn at three different weights and need to be optically levelled, but
     it's a closed set of values, so CSS can enumerate it. */
  .awards__item[data-height="74"] {
    --badge-h: 74px;
  }

  .awards__item[data-height="80"] {
    --badge-h: 80px;
  }

  .awards__item[data-height="88"] {
    --badge-h: 88px;
  }

  .awards__list :global(.awards__badge) {
    height: var(--badge-h, 80px);
    width: auto;
  }

  /* Hidden until the rail can actually scroll. Kept in the DOM at every width
     rather than rendered conditionally, because the breakpoint is a CSS fact —
     the server has no idea how wide the viewport is. */
  @media (max-width: 980px) {
    .awards__list {
      gap: var(--space-6) var(--space-10);
    }

    .awards__list :global(.awards__badge) {
      height: calc(var(--badge-h, 80px) * 0.8);
    }
  }

  /* Two badges at a time, centred, inside the text column — not a rail that
     bleeds past the edges with the neighbours half-showing. Each item is half
     a slide, so the snap position is exact and every badge is on screen whole
     or not at all. */
  @media (max-width: 760px) {
    /* Capped and centred rather than filling the column. A slide is half the
       rail, so an uncapped rail at 760px puts the two badges 350px apart and
       they stop reading as a pair. Below ~470px the cap is moot and the rail
       is simply the column. */
    .awards__rail {
      max-width: 420px;
      margin-inline: auto;
      overflow-x: auto;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }

    /* No `width: max-content` here: the list must stay exactly as wide as the
       rail, because that is what the slides below take their 100% from. The
       overflow comes from six of them, not from the track being oversized. */
    /* `flex-start` is load-bearing, not tidiness: the base rule centres the
       row, and a centred nowrap flex line splits its overflow evenly to both
       sides. The first three slides would sit at a negative offset, which
       scrollLeft cannot reach — they would simply never be shown. */
    .awards__list {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 0;
    }

    .awards__item {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 50%;
      padding-inline: var(--space-3);
    }

    /* The snap points sit on the ODD items, so a swipe lands on a pair rather
       than sliding a single badge along and leaving one half-showing. The
       arrows agree because the rail declares data-rail-step="2". */
    .awards__item:nth-child(odd) {
      scroll-snap-align: start;
    }

    /* Full height, not the 0.8 the wrapped row needs at this width — with only
       two per slide there is no reason to shrink them, and the small print on
       the TopVerdict and Avvo seals is only legible at full size. `max-`
       rather than a fixed height so the one wide wordmark, which is 168px
       across, scales down to fit its half instead of overflowing it. */
    .awards__list :global(.awards__badge) {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: var(--badge-h, 80px);
    }
  }
</style>

<script>
  // Paging behaviour is shared with the testimonials and attorney rails.
  import "../scripts/rail";
</script>
