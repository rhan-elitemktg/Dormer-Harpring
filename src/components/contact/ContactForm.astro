---
// The consultation request form.
//
// A REAL form: method="post" to a real endpoint, with the browser's own
// validation and a server redirect to /thank-you on success.
//
// The comp does something different and worse — `onSubmit` calls
// preventDefault() and flips a state flag to show a "Thank you." panel. Nothing
// is ever sent. That is a prototype gesture, not a design: shipped, it would
// tell every injured person their case had been received while silently
// discarding it. So the success panel is not ported, and the page it would have
// faked is a real route.
//
// TODO(launch): /api/consult does not exist yet — it needs a server adapter and
// a mail provider (see the README's launch list). Until then this form will
// 404 on submit, which is the correct failure: visibly broken beats
// invisibly broken.
//
// The constraints below are a convenience, not a guarantee: any client can post
// straight past them. The endpoint MUST re-validate name, phone and email
// server-side and drop anything with the honeypot filled.
import type { ContactBand } from "../../data/contact";
import { ROUTES } from "../../lib/routePaths";

interface Props {
  form: ContactBand["form"];
  /**
   * `panel` is the white card beside the info column on Contact, Testimonials
   * and the rest. `sidebar` is the blog post's narrow dark card.
   *
   * A prop rather than a class the caller styles: these are scoped styles, so
   * a `.cform { … }` rule in the parent would compile and match nothing —
   * exactly the case `check:styles` exists to catch. Same shape as AwardsBar's
   * `tone` and AttorneyCard's `layout`.
   *
   * THE FIELDS DO NOT CHANGE between the two. The comp's sidebar form splits
   * the name in two and drops the honeypot; neither was adopted, so
   * `/api/consult` has one payload to validate rather than two, and the
   * sidebar keeps the phone mask, the patterns and the spam trap.
   */
  variant?: "panel" | "sidebar";
}

const { form, variant = "panel" } = Astro.props;

// The blog post renders this component TWICE — once in the sidebar, once in
// the contact block at the foot. A hardcoded id would appear twice on that
// page, which is invalid and silently resolves every `aria-describedby` to the
// first one. Keyed off the variant, since no page has ever shown two of the
// same variant.
const disclaimerId = `cform-disclaimer-${variant}`;

---

<div class:list={["cform", `cform--${variant}`]}>
  {
    /* In a panel this sits under the section's own h2, so h3 is the right
       level. In the sidebar there is no h2 above it — the card is one of three
       top-level blocks inside a `complementary` landmark, and the other two
       head themselves with h2. Matching them keeps that landmark navigable by
       heading level.

       Two literal tags rather than a `<Title>` variable: a dynamic tag is
       treated as a component, so Astro passes the scope as a PROP and it
       renders `data-astro-cid-…="true"` instead of a bare attribute. It still
       matches, but it is noise in the output of every page on the site. */
    variant === "sidebar" ? (
      <h2 class="cform__title">{form.title}</h2>
    ) : (
      <h3 class="cform__title">{form.title}</h3>
    )
  }
  <p class="cform__lede">{form.lede}</p>

  <form
    class="cform__form"
    method="post"
    action="/api/consult"
    aria-describedby={disclaimerId}
  >
    {/* Which form, where to send them, and which page asked — all read
        server-side. `kind` is how one endpoint tells a consultation request from
        a co-counsel referral. */}
    <input type="hidden" name="kind" value="consultation" />
    <input type="hidden" name="redirectTo" value={ROUTES.thankYou} />
    <input type="hidden" name="source" value={Astro.url.pathname} />

    <div class="cform__row">
      <label class="cform__field">
        <span class="cform__label">Full name</span>
        <input
          class="cform__input"
          type="text"
          name="name"
          autocomplete="name"
          placeholder="Jane Doe"
          minlength="2"
          maxlength="80"
          required
        />
      </label>

      <label class="cform__field">
        <span class="cform__label">Phone</span>
        {
          /* `type="tel"` constrains NOTHING on its own — the spec leaves the
             format open because international numbering varies — so "17736"
             validates happily without a pattern.

             This accepts ONE shape, the placeholder's. The mask below types it
             for you as you go, which is what makes a strict pattern reasonable
             rather than hostile: without it, entering "3037563812" would just
             be rejected with no way to tell what was wanted.

             No `maxlength`: it would truncate a pasted "+1 (303) 756-3812"
             before the mask ever saw it, mangling the digits. The mask caps
             the length instead. */
        }
        <input
          class="cform__input"
          type="tel"
          name="phone"
          autocomplete="tel"
          inputmode="tel"
          placeholder="(303) 555-0100"
          pattern="\(\d{3}\) \d{3}-\d{4}"
          title="Enter a phone number as (303) 555-0100"
          data-phone-mask
          required
        />
      </label>
    </div>

    <label class="cform__field">
      <span class="cform__label">Email</span>
      {
        /* `type="email"` accepts "jane@email" — it does not require a dotted
           domain. The pattern adds that, which catches the common typo of
           omitting the .com. */
      }
      <input
        class="cform__input"
        type="email"
        name="email"
        autocomplete="email"
        placeholder="jane@email.com"
        pattern="[^@\s]+@[^@\s]+\.[A-Za-z]{2,}"
        title="Enter a full email address, e.g. jane@email.com"
        maxlength="254"
        required
      />
    </label>

    <label class="cform__field">
      <span class="cform__label">What happened?</span>
      <textarea
        class="cform__input cform__input--area"
        name="message"
        rows="4"
        placeholder="A few sentences about your injury or accident…"></textarea>
    </label>

    {
      /* Honeypot. Hidden from sight and from assistive tech, and skipped by
         Tab — a human never fills it, so anything non-empty is a bot and the
         endpoint drops it. `hidden` is not used because some bots skip those. */
    }
    <div class="cform__trap" aria-hidden="true">
      <label>
        Company
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <button type="submit" class="btn btn--red cform__submit arrow-link">
      {form.submitLabel} <span class="arrow" aria-hidden="true">&rarr;</span>
    </button>

    <p class="cform__disclaimer" id={disclaimerId}>{form.disclaimer}</p>
  </form>
</div>

<style>
  .cform {
    padding: var(--space-14) var(--space-14) var(--space-12);
    background: var(--dh-white);
  }

  .cform__title {
    margin-bottom: var(--space-2);
    font-size: var(--display-5);
    line-height: 1.02;
    color: var(--dh-ink);
  }

  .cform__lede {
    margin-bottom: var(--space-8);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--dh-ink-3);
  }

  /* THE ROW OWNS THE GAP ONLY WHILE IT IS ACTUALLY TWO-UP. Side by side, the
     name and phone fields have no bottom margin of their own and the row
     carries it for both. Once the row collapses to one column — in the sidebar
     at every width, in the panel below 560px — each field takes its margin
     back, and a margin on the row as well lands UNDER THE PHONE FIELD ONLY,
     which is the one gap in the form that is two steps instead of one. Both
     collapse points below zero it out; a third has to do the same. */
  .cform__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .cform__field {
    display: block;
    margin-bottom: var(--space-4);
  }

  .cform__row .cform__field {
    margin-bottom: 0;
  }

  .cform__label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 700;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--dh-ink-3);
  }

  .cform__input {
    width: 100%;
    padding: var(--space-4);
    border: 1px solid #e4dcc8;
    border-radius: var(--radius-input);
    background: var(--surface-input);
    /* 16px minimum: iOS Safari zooms the viewport on focus below that, which
       throws the layout sideways mid-form. */
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.3;
    color: var(--dh-ink);
    transition: border-color var(--transition), background-color var(--transition);
  }

  .cform__input::placeholder {
    color: var(--dh-ink-5);
  }

  .cform__input:focus {
    border-color: var(--accent-gold);
    background: var(--dh-white);
    outline: none;
  }

  /* Flagged once the visitor has interacted with the field and left it wrong,
     rather than reddening every empty required field on load.
     `:user-invalid` means exactly that. It replaces
     `:not(:placeholder-shown):invalid`, which used the placeholder as a proxy
     for "has been typed in" — and silently inverts on any field that has no
     placeholder, since `:placeholder-shown` cannot match one. Every field here
     happens to have a placeholder; the co-counsel form's did not, and reddened
     on load. */
  .cform__input:user-invalid {
    border-color: var(--accent);
  }

  .cform__input--area {
    resize: vertical;
    line-height: 1.5;
  }

  .cform__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cform__submit {
    width: 100%;
    margin-top: var(--space-2);
    border-radius: var(--radius-input);
    font-size: var(--text-md);
  }

  .cform__disclaimer {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-align: center;
    color: #9a917e;
  }

  @media (max-width: 980px) {
    .cform {
      padding: var(--space-10) var(--space-8) var(--space-9);
    }
  }

  @media (max-width: 560px) {
    .cform__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      margin-bottom: 0;
    }

    .cform__row .cform__field {
      margin-bottom: var(--space-4);
    }
  }

  /* ---- The sidebar variant --------------------------------------------
     The blog post's dark card. Everything below is surface and spacing; the
     markup, the fields, the validation and the endpoint are the panel's. */

  .cform--sidebar {
    padding: var(--space-8) var(--space-7);
    border-radius: var(--radius-media);
    /* The gold rule is on the TOP border rather than a pseudo-element so it
       follows the radius, matching the two sidebar cards below it. */
    border-top: 3px solid var(--accent-gold);
    background: var(--surface-dark-card);
  }

  .cform--sidebar .cform__title {
    margin-top: var(--space-1);
    font-size: var(--display-6);
    color: var(--text-on-dark);
  }

  .cform--sidebar .cform__lede {
    margin-bottom: var(--space-5);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-on-dark-muted);
  }

  /* One column at EVERY width, not just below 560px: the sidebar is ~300px
     wide on the desktop frame this variant exists for, and two fields side by
     side there leaves each about 140px. */
  .cform--sidebar .cform__row {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin-bottom: 0;
  }

  .cform--sidebar .cform__row .cform__field {
    margin-bottom: var(--space-3);
  }

  .cform--sidebar .cform__field {
    margin-bottom: var(--space-3);
  }

  /* The comp gives these inputs no labels at all, relying on placeholders. The
     labels stay and are hidden from sight only — a placeholder disappears the
     moment someone types, which leaves anyone who looks away with four filled
     boxes and no idea which is which, and leaves a screen reader with the
     field's name only while it is empty. */
  .cform--sidebar .cform__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* White rather than the cream input surface: on forest, `--surface-input`
     reads as a muddy grey. This is the comp's own treatment. */
  .cform--sidebar .cform__input {
    background: var(--dh-white);
  }

  .cform--sidebar .cform__submit {
    margin-top: var(--space-1);
  }

  /* `disclaimer` carries the comp's "Free & confidential" note here rather
     than a sentence, so it is set as the label it is. */
  .cform--sidebar .cform__disclaimer {
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-gold-light);
  }
</style>

<script>
  // Shared with the co-counsel referral form.
  import "../../scripts/phoneMask";
</script>
