---
// The band that opens an interior page: eyebrow, h1, lede.
//
// SectionHead's sibling, not its variant — this one emits the page's single
// <h1> and owns the section element and its padding, where SectionHead is an
// <h2> opener dropped inside a section someone else laid out. Collapsing the
// two would mean a `level` prop that changes which element is emitted, and a
// component that can emit the wrong heading level is a component that
// eventually does.
//
// Three backgrounds, which is what the thirteen interior comps actually use:
//   cream   — flat, centred (Thank You, Blog)
//   forest  — the gradient, centred (Contact, Case Results, Community, Attorneys)
//   photo   — a photograph behind a left-weighted scrim, copy left (Testimonials,
//             About, Practice Areas, Co-Counsel)
//
// One component rather than a separate `PageHero`, because all three share the
// eyebrow / h1 / lede block and its prose styling; splitting them would
// duplicate that and let the two drift.
import Eyebrow from "./Eyebrow.astro";
import Prose from "./prose/Prose.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { PortableTextBlock } from "../data/portableText";

interface Props {
  eyebrow?: string;
  title: string;
  /**
   * Portable Text rather than a string: these ledes carry inline links — the
   * Thank You page puts a `tel:` link on the phone number mid-sentence.
   */
  lede?: PortableTextBlock[];
  tone?: "cream" | "forest" | "photo";
  align?: "center" | "left";
  /** Required by `tone="photo"`, ignored otherwise. */
  photo?: ImageMetadata;
  /**
   * A DIFFERENT CROP for narrow viewports, not a smaller copy of `photo`. The
   * team photograph is a 2.25:1 panorama with the attorneys in its right third,
   * and a portrait viewport slices most of them off. Optional: a header whose
   * photo has nothing off-centre to lose does not need one.
   */
  photoMobile?: ImageMetadata;
  photoAlt?: string;
  /**
   * The photo band's height at desktop. The comps run 520–620px depending on
   * how much copy the page carries; below 760 it collapses to content height.
   */
  minHeight?: number;
  class?: string;
}

const {
  eyebrow,
  title,
  lede,
  tone = "cream",
  align = tone === "photo" ? "left" : "center",
  photo,
  photoMobile,
  photoAlt = "",
  minHeight = 520,
  class: className,
} = Astro.props;

// A photo header with no photo would render as an unreadable scrim over
// nothing — fail loudly at build rather than shipping it.
if (tone === "photo" && !photo) {
  throw new Error('PageHeader: tone="photo" requires a `photo`.');
}

// Art direction, so this is a hand-built <picture> rather than <Picture>: the
// two sources are DIFFERENT CROPS, not two resolutions of one image, and only
// `media` can choose between them. Same reason and same shape as Hero.astro.
// `photoMobile` is optional, so with one source this collapses to a plain
// responsive <img>.
const [wide, narrow] = await Promise.all([
  photo ? getImage({ src: photo, widths: [900, 1400, 2000, 2400], format: "webp" }) : null,
  photoMobile
    ? getImage({ src: photoMobile, widths: [500, 800, 1100], format: "webp" })
    : null,
]);
// The narrow crop is the <img> and the panorama is the <source>, not the other
// way round: `media` on a <source> is evaluated before the fallback, so the
// default belongs to the harder case.
const fallback = narrow ?? wide;
---

{
  /* The one inline style on the page, and the same carve-out PlayButton takes:
     a custom property used as a PARAMETER, never a declaration. It is a
     continuous number set by the page author, not a closed set an attribute
     selector could enumerate. */
}
<section
  class:list={[
    "ph",
    `ph--${tone}`,
    align === "center" && "ph--center",
    narrow && "ph--art",
    className,
  ]}
  style={tone === "photo" ? `--ph-min: ${minHeight}px` : undefined}
>
  {
    tone === "photo" && fallback && wide && (
      <div class="ph__media">
        <picture>
          {narrow && (
            <source
              media="(min-width: 761px)"
              srcset={wide.srcSet.attribute}
              sizes="100vw"
            />
          )}
          <img
            src={fallback.src}
            srcset={fallback.srcSet.attribute}
            sizes="100vw"
            alt={photoAlt}
            width={fallback.attributes.width}
            height={fallback.attributes.height}
            fetchpriority="high"
            decoding="sync"
            class="ph__photo"
          />
        </picture>
        <span class="ph__scrim" aria-hidden="true" />
      </div>
    )
  }

  <div class="container ph__inner">
    {
      eyebrow && (
        <Eyebrow
          tone={tone === "cream" ? "gold" : "on-dark"}
          center={align === "center"}
          class="ph__eyebrow"
        >
          {eyebrow}
        </Eyebrow>
      )
    }
    <h1 class="ph__title">{title}</h1>
    <Prose value={lede} class="ph__lede" />
    <slot />
  </div>
</section>

<style>
  .ph--cream {
    background: var(--surface-page);
  }

  .ph--forest {
    background: var(--grad-forest);
    --forest-origin: 50%;
  }

  .ph--photo {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--ph-min, 520px);
    overflow: hidden;
    /* Behind the photo, so a slow connection shows dark-on-dark rather than
       cream text on white. */
    background: var(--surface-dark-card);
  }

  .ph__media {
    position: absolute;
    inset: 0;
  }

  /* <picture> is display:inline with no height of its own, so without this the
     img's `height: 100%` resolves against nothing and the photo collapses. */
  .ph__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* No `:global()` now that art direction means a hand-built <picture>: the img
     is in this component's own template and carries its cid. */
  .ph__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The four attorneys stand in the right third of the frame; the copy takes
       the left. */
    object-position: right top;
  }

  /* Near-solid until a third of the way across, then away quickly — the copy
     column ends around 54% and the faces start just after it. */
  .ph__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(18, 29, 22, 0.97) 0%,
      rgba(20, 32, 25, 0.92) 32%,
      rgba(24, 37, 29, 0.6) 50%,
      rgba(26, 39, 31, 0.16) 66%,
      rgba(26, 39, 31, 0) 80%
    );
  }

  .ph--photo .ph__inner {
    position: relative;
    width: 100%;
    padding-block: var(--space-section-sm);
  }

  /* The comp wraps the whole block at 720px. `ch` would be the wrong unit for
     the heading: 56ch at Anton's 70px is nearly 2000px, i.e. no cap at all,
     which is how the title came to run the full container. */
  .ph--photo .ph__title {
    max-width: 720px;
  }

  /* Asymmetric on purpose: the comps give the cream band 72px above and 44px
     below, because the 44px is not the band's own breathing room — it is the
     gap to whatever follows, which starts flush. The forest band sits above a
     section with its own full padding, so it is symmetrical. */
  .ph--cream .ph__inner {
    padding-block: var(--space-section-sm) var(--space-11);
  }

  .ph--forest .ph__inner {
    padding-block: clamp(2.5rem, 4.4vw, 3.75rem); /* 40 → 60 */
  }

  .ph--center .ph__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* `:global()` bounded by the scoped ancestor: both classes are passed as
     props to child components, so they land on markup that never carries this
     component's cid. Plain rules here would compile and match nothing. */
  .ph :global(.ph__eyebrow) {
    margin-bottom: var(--space-5);
  }

  .ph__title {
    font-size: var(--display-page);
    line-height: 0.94;
    /* Anton's caps sit tight at this size; the comps open the tracking back up
       rather than using the display default's negative value. */
    letter-spacing: 0.005em;
    color: var(--dh-ink);
    text-wrap: balance;
  }

  .ph--forest .ph__title,
  .ph--photo .ph__title {
    color: var(--text-on-dark);
  }

  /* The photo variants run a size down from the 76px statement titles — they
     carry more copy under them and sit over a picture. */
  .ph--photo .ph__title {
    font-size: var(--display-page-2);
    line-height: 0.96;
  }

  /* Wider than --measure-ch (62ch), which is the measure for a paragraph
     someone reads down. This one is a two-line standfirst under a 76px
     headline; at 62ch it broke to three ragged lines and read as body copy. */
  .ph :global(.ph__lede) {
    max-width: 76ch;
    margin-top: var(--space-5);
  }

  .ph :global(.ph__lede .prose__p) {
    font-size: var(--text-2xl);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    /* `balance`, not `pretty`: at two lines the job is to split them evenly,
       not to avoid a short last line. */
    text-wrap: balance;
  }

  .ph--forest :global(.ph__lede .prose__p),
  .ph--photo :global(.ph__lede .prose__p) {
    color: var(--text-on-dark-2);
  }

  /* Narrower than the cream/forest 76ch, and it has to be declared AFTER that
     rule: both selectors weigh the same, so source order is what decides. */
  .ph--photo :global(.ph__lede) {
    max-width: 56ch;
    margin-top: var(--space-7);
  }

  .ph--photo :global(.ph__lede .prose__p) {
    /* Left-aligned and ragged: `balance` is for centred display text, and here
       it would even up lines that have no reason to match. */
    text-wrap: pretty;
  }

  /* Below 760 the scrim's horizontal falloff puts the end of every line on the
     bright half of the picture. Swap to a vertical one and let the band size to
     its content. */
  @media (max-width: 760px) {
    .ph--photo {
      min-height: 0;
    }

    /* Centred, because below this width the source has ALREADY swapped to the
       crop framed on the team — there is no longer a right third to chase. A
       header with no `photoMobile` still gets the panorama here, so the offset
       stays as the fallback for that case. */
    .ph__photo {
      object-position: 68% top;
    }

    .ph--art .ph__photo {
      object-position: center;
    }

    .ph__scrim {
      background: linear-gradient(
        180deg,
        rgba(18, 29, 22, 0.72) 0%,
        rgba(20, 32, 25, 0.88) 45%,
        rgba(24, 37, 29, 0.96) 100%
      );
    }

    .ph--photo .ph__inner {
      padding-block: var(--space-section);
    }
  }

  /* The comps weight the inline link in these ledes — it is a phone number in
     an otherwise quiet paragraph, and the one thing on the page still worth
     acting on. */
  .ph :global(.ph__lede .prose__link) {
    font-weight: 700;
  }
</style>
