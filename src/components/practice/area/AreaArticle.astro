---
// The practice-area page's body and sidebar — its first and largest section.
//
// A SIBLING OF `blog/PostArticle`, NOT A REUSE OF IT. Three reasons, and the
// third is the one that settles it:
//
//  1. PostArticle's props are typed against BlogPost / BlogPostArticle /
//     BlogCategory. Sharing means widening those to carry `publishedAt`,
//     `author`, `reviewer`, `category` and `readTime` for a page that has none
//     of them — and each of those shapes is already the GROQ projection it will
//     be after the swap. In Sanity these are two document types.
//  2. PostArticle renders a category eyebrow, a four-part byline and the
//     fact-check band. Forking those by prop flags puts four conditionals in a
//     component whose whole job is a grid.
//  3. THE SCOPED-STYLE RULES MAKE SHARING THE GRID IMPOSSIBLE ANYWAY.
//     PostArticle places the sidebar with `.post :global(.pside)`, bounded by
//     an element in its OWN template as AGENTS.md requires. This file's `.parea`
//     wrapper cannot match that rule, and adding `.parea` to PostArticle's
//     stylesheet is precisely the ANCESTOR blind spot README.md documents that
//     `check:styles` cannot catch.
//
// What IS shared: `Prose`, `PostContents`, `ContactForm`, and the `.pside*`
// card chrome, which moved to global.css when this file arrived.
//
// No PageHeader, and the H1 is here — the same reasoning PostArticle records:
// the page's own eyebrow and title stand in for one, and a page header would
// put a second heading above the H1.
//
// IT WENT AWAY AND CAME BACK. This template carried a `PageHeader` for two
// rounds — Testimonials' photo band, then `/results/`' forest band — with the
// H1 moved into it both times. Both were dropped by request and the title came
// home. If a header is ever asked for again, the title MOVES rather than being
// duplicated: two <h1>s is the one thing that cannot happen.
import Prose from "../../prose/Prose.astro";
import PostContents from "../../blog/PostContents.astro";
import AreaSidebar from "./AreaSidebar.astro";
import AreaFaqs from "./AreaFaqs.astro";
import { formatPostDate } from "../../../lib/dates";
import type { BlogPost } from "../../../data/blog";
import type {
  PracticeAreaArticle,
  PracticeAreaPageCopy,
  SidebarAreas,
} from "../../../data/practiceAreaPages";

interface Props {
  article: PracticeAreaArticle;
  page: PracticeAreaPageCopy;
  areas: SidebarAreas;
  related: BlogPost[];
  faqId: string;
}

const { article, page, areas, related, faqId } = Astro.props;

/* WordPress's `modified` when there is one, `date` otherwise, each with its own
   label. Every imported page carries both today and the modified date is the
   truthful one — publishing dates run back to 2016 on evergreen service copy
   that was revised this year, and stamping 2016 on it would read as stale
   rather than settled. The fallback is not dead: `modifiedAt` is optional on
   the collection, so a hand-authored page need not carry one. */
const updated = Boolean(article.updatedAt);
const stamp = article.updatedAt ?? article.publishedAt;
---

<section class="parea">
  <div class="container">
    <div class="parea__grid">
      <article class="parea__main">
        {/* The post page's category line, in its place and with its rules —
            here it is the firm's tagline rather than a taxonomy, the same on
            all 109. It has been the city and "Practice Area" before this; the
            city stuttered against the 84 titles that open with one, and
            trimming the TITLE instead was declined as an SEO change on 109
            ranking pages. See `PracticeAreaPageCopy.eyebrow`. */}
        <p class="parea__cat">{page.eyebrow}</p>
        <h1 class="parea__title">{article.title}</h1>

        {
          /* THE POST PAGE'S META LINE, minus the reviewer — these pages have no
             reviewed-by data and inventing one would put a named attorney's
             approval on 109 pages nobody approved. `formatPostDate` pins the
             date to UTC so the build machine's timezone cannot shift it by a
             day; the machine-readable form stays on the <time>. Read time is
             derived from the body AFTER the two chrome sections are dropped —
             see `getPracticeAreaArticles()`. */
        }
        <p class="parea__meta">
          {page.meta.writtenByLabel}{" "}
          <a class="parea__person" href={page.meta.author.href}>
            {page.meta.author.name}
          </a>
          <span class="parea__sep" aria-hidden="true">
            ·
          </span>
          {updated ? page.meta.updatedLabel : page.meta.postedLabel}{" "}
          <time datetime={stamp}>{formatPostDate(stamp)}</time>
          <span class="parea__sep" aria-hidden="true">
            ·
          </span>
          {article.readTime}
        </p>

        <PostContents label={page.contentsLabel} body={article.body} />
        <Prose value={article.body} />

        {
          /* Inside the article column, after the body — where the live page
             puts it. 28 of the 109 pages carry one; the component renders
             nothing for the rest. */
        }
        <AreaFaqs title={page.faqsTitle} faqs={article.faqs} id={faqId} />
      </article>

      {
        /* PostArticle's fact-check band, same markup and same copy — it speaks
           for the whole page rather than for the article column, so it spans
           both. Placed BEFORE the sidebar in the DOM and pinned to row 2
           explicitly, so the single-column order reads article → fact-check →
           sidebar rather than burying it under the form. The same trap
           PostArticle records for its own three placements.

           A GUARD, NOT A CONDITION ANYTHING MEETS TODAY: `factCheck` is derived
           for all 109, so this is always true. It stays because an empty band
           renders as a checkmark, a heading and nothing else — which reads as a
           broken component rather than an absent one — and the field is
           editable per page once these live in Sanity. */
      }
      {
        article.factCheck.length > 0 && (
          <div class="parea__fact">
            <p class="parea__factlabel">
              <span class="parea__factmark" aria-hidden="true">
                &#10003;
              </span>
              {page.factCheckLabel}
            </p>
            <Prose value={article.factCheck} class="parea__factbody" />
          </div>
        )
      }

      <AreaSidebar page={page} areas={areas} related={related} />
    </div>
  </div>
</section>

<style>
  /* PostArticle's 72px top, and now for PostArticle's own reason again: this
     section opens the page, so the padding is the gap between the site header
     and the article. It briefly sat under a page header, where it was a section
     boundary instead; the figure did not change either way. */
  .parea {
    padding-block: var(--space-18) var(--space-section);
    background: var(--surface-page);
  }

  /* THE POST PAGE'S RATIO, deliberately identical. 1.8:1 puts the sidebar at
     ~419px inside the 1244px container and the body at ~753px, which lands on
     `--measure-prose: 760px` — and the two templates sit at the same URL depth
     and carry the same sidebar, so a reader moving between them should not feel
     the column widths shift. Kept proportional rather than a fixed `420px`
     track, which stops being proportional as the container shrinks. */
  .parea__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
    gap: var(--space-18);
    align-items: start;
  }

  .parea__main {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  /* Explicit placement rather than source order — see the note by the markup. */
  .parea__fact {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  /* `:global()` bounded by `.parea`, an element in this template — the class
     lands on AreaSidebar's own markup and carries ITS cid, not this file's. */
  .parea :global(.pside) {
    grid-column: 2;
    grid-row: 1;
  }

  /* `.post__fact`'s rules verbatim. Not shared to global.css: `.pside*` moved
     there because TWO sidebars render it and the block is 60 lines; this is
     four rules on a band whose two callers already justify their separation at
     length above. Revisit if a third template grows one. */
  .parea__fact {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    /* No top margin: this is its own grid ROW, so the grid's gap already sets
       it off. */
    padding: var(--space-7) var(--space-9);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-media);
    background: var(--surface-input);
  }

  .parea__factlabel {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-right: var(--space-8);
    border-right: 1px solid var(--dh-line-strong);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
    white-space: nowrap;
  }

  .parea__factmark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 46px;
    height: 46px;
    border: 1.5px solid var(--accent-gold);
    border-radius: var(--radius-full);
    font-size: var(--text-xl);
    color: var(--dh-gold-deep);
  }

  /* `:global()` bounded by an element in THIS template: the class is handed to
     Prose and lands on its own wrapper, carrying Prose's cid rather than this
     file's. A bare `.parea__factbody` rule here would compile and match nothing
     — the case `check:styles` exists to catch. */
  .parea__fact :global(.parea__factbody) {
    font-size: var(--text-md);
  }

  /* `.post__cat`, `.post__title` and `.post__meta`'s rules, deliberately
     identical — the two templates carry the same three lines in the same place
     and a reader moving between them should not see them change weight. Not
     shared to global.css: it is three short rules, and the two components
     already justify their separation at length above.

     `.parea__title` is mixed case at the interior page size rather than a
     display one, for PostArticle's reason and one of its own: these titles are
     long — "Denver Uninsured and Underinsured Motorcyclist Accident Lawyer" is
     the worst of the 109 — so `text-wrap: balance` keeps the last line from
     carrying a single word. */
  .parea__cat {
    font-weight: 800;
    font-size: var(--text-sm);
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dh-gold-deep);
  }

  .parea__title {
    margin-top: var(--space-4);
    font-size: var(--display-page-sm);
    line-height: 1.02;
    letter-spacing: 0.005em;
    text-transform: none;
    text-wrap: balance;
  }

  .parea__meta {
    margin-top: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-meta);
  }

  .parea__person {
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .parea__person:hover {
    color: var(--accent);
  }

  @media (max-width: 1180px) {
    .parea__grid {
      gap: var(--space-12);
    }
  }

  @media (max-width: 980px) {
    .parea {
      padding-block: var(--space-12) var(--space-section);
    }

    /* One column, and EVERY explicit placement released with it. A `grid-row: 1`
       left on the sidebar in a one-column grid puts it above the article, and a
       `grid-row: 2` left on the fact-check band leaves an empty first row — the
       same trap PostArticle records for its own three placements. */
    .parea__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-12);
    }

    .parea__main,
    .parea__fact,
    .parea :global(.pside) {
      grid-column: auto;
      grid-row: auto;
    }

    .parea__fact {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    /* The divider was a vertical rule between two columns; stacked, it becomes
       a horizontal one under the label. */
    .parea__factlabel {
      padding-right: 0;
      padding-bottom: var(--space-5);
      border-right: 0;
      border-bottom: 1px solid var(--dh-line-strong);
    }
  }
</style>
