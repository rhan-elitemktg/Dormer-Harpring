---
// "Every case we handle, by location." — the full practice-area directory,
// grouped by city and set in four columns of chevroned links.
//
// The nine groups are wildly uneven (Denver has 48 entries, Grand Junction 4),
// which is why each group is its own grid rather than one grid the groups flow
// through: a shared grid would let a short group's links sit beside Denver's
// tail and read as part of it. Every group is a CITY now — the comp's two
// topical groups folded into Denver, so the section heading's "by location" is
// finally true of all of it.
//
// The link rows themselves are `AreaLinkList`. It was shared with `CityAreas`,
// the band at the foot of every practice-area page, until that band was removed
// by request; this is its only caller now. `cocounsel/PracticeAreaLinks` is a
// third copy of the same affordance and is knowingly still separate; see the
// note in AreaLinkList.
import Eyebrow from "../Eyebrow.astro";
import AreaLinkList from "./AreaLinkList.astro";
import type { AreaGroup, PracticeAreasPage } from "../../data/practiceAreas";

interface Props {
  section: PracticeAreasPage["directory"];
  groups: AreaGroup[];
}

const { section, groups } = Astro.props;
---

<section class="dir">
  <div class="container">
    <header class="dir__head">
      <Eyebrow class="dir__eyebrow">{section.eyebrow}</Eyebrow>
      <h2 class="dir__title">{section.title}</h2>
    </header>

    {
      groups.map((group) => (
        <div class="dir__group">
          <h3 class="dir__group-title">{group.title}</h3>
          <AreaLinkList items={group.items} />
        </div>
      ))
    }
  </div>
</section>

<style>
  /* WHITE, NOT CREAM, and the lightest surface on the page. `.feat` above it is
     `--surface-page` and `ContactDetails` below the stats band is too, so this
     band read as a continuation of the featured grid rather than a section of
     its own — two identical adjacent surfaces, which nothing in the build
     checks for. Lifting rather than sinking it was the request, and only two
     tokens are lighter than cream-100: `--dh-cream-50`, which is 1.009:1
     against it and so invisible, and white at 1.070:1 — a BIGGER step than the
     site's own alternate band, `--surface-alt`, manages at 1.046:1. `.feat`'s
     cards are already white, so the band picks up a colour the page has
     established rather than introducing one.

     `.feat` carries a matching `padding-block` bottom for this: it used to end
     at zero and borrow this section's top padding, which only worked while the
     two shared a surface. */
  .dir {
    background: var(--dh-cream-300);
    padding-block: var(--space-section);
  }

  .dir__head {
    max-width: 900px;
    margin-bottom: var(--space-13);
  }

  /* Bounded `:global()`: the class is passed to <Eyebrow> and therefore lands
     on Eyebrow's markup, which never carries this file's cid. */
  .dir :global(.dir__eyebrow) {
    margin-bottom: var(--space-4);
  }

  .dir__title {
    font-size: var(--display-2);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--dh-ink);
  }

  /* The comp's `wrapStyle` spacing — 44px below every group, 44px above every
     group after the first. Its hairline between groups is deliberately NOT
     ported: by request. The group headings and the 88px of combined padding
     carry the separation on their own. */
  .dir__group {
    padding-bottom: var(--space-11);
  }

  .dir__group + .dir__group {
    padding-top: var(--space-11);
  }

  /* The comp sets 28px, which occurs exactly once across all sixteen comps —
     drift rather than a tier. Snapped to the nearest one (--display-6, 25px)
     rather than up to --display-5's 34, which would overshoot by 6. */
  .dir__group-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-6);
    line-height: 1.1;
    color: var(--dh-ink);
    margin-bottom: var(--space-6);
  }

  /* The four-column grid, its equal-height fix and the whole link treatment
     live in AreaLinkList. Nothing here may style them: those classes land on
     that component's markup and carry ITS cid, so a rule here would compile and
     match nothing. */
</style>
