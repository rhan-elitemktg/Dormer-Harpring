---
// The comp's `.ca-ans--split` — a one-word answer and its explanation down the
// left, an attorney video down the right. "What does it cost to hire us?" and
// "Do I have to go to court?" are both built out of it.
import BigAnswerCard from "./BigAnswerCard.astro";
import DetailBlocks from "./DetailBlocks.astro";
import DetailVideo from "./DetailVideo.astro";
import Disclosure from "./Disclosure.astro";
import PhoneAsk from "./PhoneAsk.astro";
import type { BigAnswerSection } from "../../../data/carAccidents";
import type { FirmDetails } from "../../../data/site";

interface Props {
  section: BigAnswerSection;
  firm: FirmDetails;
  surface: "cream" | "alt" | "sunk";
}

const { section, firm, surface } = Astro.props;
---

<section class:list={["section", `section--${surface}`, "bigsec"]}>
  <div class="container bigsec__split">
    <div>
      <header class="bigsec__head">
        <h2 class="bigsec__title">{section.title}</h2>
        <p class="bigsec__lede">{section.lede}</p>
      </header>

      <BigAnswerCard
        figure={section.big.figure}
        statement={section.big.statement}
        body={section.big.body}
      />

      {
        section.reassure && (
          <div class="reassure">
            <p class="reassure__title">{section.reassure.title}</p>
            {section.reassure.body.map((paragraph) => (
              <p class="reassure__body">{paragraph}</p>
            ))}
          </div>
        )
      }

      <Disclosure label={section.disclosure.label}>
        <DetailBlocks blocks={section.blocks} />
      </Disclosure>

      <PhoneAsk text={section.foot.text} firm={firm} />
    </div>

    <div>
      <DetailVideo video={section.video} />
    </div>
  </div>
</section>

<style>
  .bigsec__split {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--space-14);
    align-items: start;
  }

  .bigsec__head {
    max-width: 820px;
    margin-bottom: var(--space-9);
  }

  .bigsec__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-3);
  }

  .bigsec__lede {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  /* The deposition explainer. Its own card rather than a block in the
     disclosure below, because it answers the thing people are actually
     frightened of and hiding it behind a caret defeats the point. */
  .reassure {
    margin-bottom: var(--space-7);
    padding: var(--space-8);
    background: var(--dh-white);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-4);
  }

  .reassure__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .reassure__body {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--text-body);
    text-wrap: pretty;
  }

  .reassure__body + .reassure__body {
    margin-top: var(--space-3);
  }

  @media (max-width: 980px) {
    .bigsec__split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
