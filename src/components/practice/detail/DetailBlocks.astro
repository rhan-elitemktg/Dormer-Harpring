---
// The comp's `.ca-sec` — an h3 over one or more paragraphs, hairline-ruled
// between siblings. Six sections of the Car Accidents page are built out of it,
// which is why it is a component rather than a repeated block of markup.
//
// The rule is `border-top` on every item with the first suppressed, rather than
// `border-bottom` with the last suppressed: these lists sit directly under a
// heading in three places and directly under a <summary> in two, and a top rule
// closes that join. The last item's foot is closed by whatever follows it.
import type { DetailBlock } from "../../../data/carAccidents";

interface Props {
  blocks: DetailBlock[];
  /** `4` where the surrounding section already owns the h3 level. */
  level?: 3 | 4;
  /**
   * `_key` of the block the `figure` slot belongs under. Two sections drop a
   * declarations-page mock inside one specific item, and it belongs INSIDE that
   * item's rule rather than between two of them.
   *
   * A prop rather than one named slot per block, because Astro resolves slot
   * names at compile time — `<slot name={block._key} />` inside a map is not a
   * thing it can wire up.
   */
  figureAfter?: string;
  class?: string;
}

const { blocks, level = 3, figureAfter, class: className } = Astro.props;
const Heading = `h${level}` as "h3" | "h4";
---

<div class:list={["blocks", className]}>
  {
    blocks.map((block) => (
      <div class="blocks__item">
        <Heading class="blocks__title">{block.title}</Heading>
        {block.body.map((paragraph) => (
          <p class="blocks__body">{paragraph}</p>
        ))}
        {block._key === figureAfter && <slot name="figure" />}
      </div>
    ))
  }
</div>

<style>
  .blocks__item {
    padding-block: var(--space-7);
    border-top: 1px solid var(--border-hairline);
  }

  .blocks__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .blocks__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .blocks__body {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--text-body);
    text-wrap: pretty;
  }

  .blocks__body + .blocks__body {
    margin-top: var(--space-4);
  }
</style>
