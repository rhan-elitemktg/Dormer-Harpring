---
// "We are built to try cases, not to settle them cheaply." — new in the second
// design, and the page's only argument for the firm rather than about the law.
//
// It absorbs the first design's separate "What we see in our own cases" band:
// the three closed-case figures now sit here, under the claim they support,
// with the methodology disclaimer directly beneath them rather than a section
// away.
import { getImage } from "astro:assets";
import Eyebrow from "../../Eyebrow.astro";
import type { WhyFirmSection } from "../../../data/carAccidents";

interface Props {
  why: WhyFirmSection;
}

const { why } = Astro.props;

// Art direction, so this is a hand-built <picture> rather than <Picture>: the
// two sources are DIFFERENT CROPS of one photograph, not two resolutions of
// one, and only `media` can choose between them. Same reason and same shape as
// PageHeader.astro and Hero.astro.
//
// The breakpoint is 1080px because that is where the section restacks — the
// crop has to change on the same line the box shape does, or one of the two
// gets `cover`-cropped into the other's hole.
//
// Widths are per-source, because the two boxes are nothing like each other:
// the desktop figure is capped at 563px by `--container-max` however wide the
// viewport gets, while the stacked one runs the full container width, up to
// 1016px at the breakpoint. Sizing them off one list over-serves one and
// starves the other.
const [wide, narrow] = await Promise.all([
  getImage({ src: why.photo, widths: [600, 900, 1200], format: "webp" }),
  getImage({ src: why.photoMobile, widths: [700, 1100, 1600, 2100], format: "webp" }),
]);

// The narrow crop is the <img> and the desktop one is the <source>, not the
// other way round: `media` on a <source> is evaluated before the fallback, so
// the default belongs to the harder case.
---

<section class="whyfirm">
  <div class="whyfirm__in">
    <div class="whyfirm__copy">
      <Eyebrow class="whyfirm__eyebrow">{why.eyebrow}</Eyebrow>
      <h2 class="whyfirm__title">{why.title}</h2>

      <dl class="wfstats">
        {
          why.stats.map((stat) => (
            <div class="wfstats__cell">
              <dd class="wfstats__big">{stat.big}</dd>
              <dt class="wfstats__label">{stat.label}</dt>
            </div>
          ))
        }
      </dl>

      <p class="wfstats__disc">{why.disclaimer}</p>

      <ol class="wfcols">
        {
          why.columns.map((column) => (
            <li class="wfcol">
              <span class="wfcol__n" aria-hidden="true">
                {column.n}
              </span>
              <h3 class="wfcol__title">{column.title}</h3>
              <p class="wfcol__body">{column.body}</p>
            </li>
          ))
        }
      </ol>

      <p class="whyfirm__link">
        <a class="arrow-link" href={why.ctaHref}>
          <span class="arrow-link__label">{why.ctaLabel}</span>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>

    <div class="whyfirm__fig">
      <picture>
        {
          /* `48vw` alone over-declares badly: `--container-max` caps the
             figure at 563px however wide the viewport gets, so above 1436px a
             bare 48vw asks for nearly double what is drawn. */
        }
        <source
          media="(min-width: 1081px)"
          srcset={wide.srcSet.attribute}
          sizes="(max-width: 1436px) 48vw, 563px"
        />
        <img
          src={narrow.src}
          srcset={narrow.srcSet.attribute}
          sizes="100vw"
          alt={why.photoAlt}
          width={narrow.attributes.width}
          height={narrow.attributes.height}
          loading="lazy"
          decoding="async"
          class="whyfirm__img lazy-fade"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .whyfirm {
    background: var(--grad-forest);
    --forest-origin: 82%;
    color: var(--text-on-dark);
  }

  .whyfirm__in {
    display: grid;
    grid-template-columns: 52fr 48fr;
    gap: var(--space-18);
    align-items: stretch;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-section) var(--container-pad);
  }

  /* The shared `Eyebrow`, so the leading rule and the label stay one mark —
     the component's own note is that the rule is not decoration and the label
     is never rendered without it. Everything but the colour and the margin now
     comes from `.eyebrow` in global.css.

     Bound by `.whyfirm`, an element in THIS template: the class is passed to a
     child, so it carries the child's `data-astro-cid` and a bare
     `.whyfirm__eyebrow` rule here could never match it.

     The colour is overridden rather than taken from `tone="on-dark"`, which is
     gold — this page moves its accents to forest throughout (see HANDOFF), and
     forest on a forest band would be an invisible rule. So both the label and
     its rule keep the muted parchment this band already used. */
  .whyfirm :global(.whyfirm__eyebrow) {
    margin: 0 0 var(--space-4);
    color: rgba(246, 242, 232, 0.72);
  }

  .whyfirm :global(.whyfirm__eyebrow)::before {
    background: rgba(246, 242, 232, 0.72);
  }

  .whyfirm__title {
    margin: 0 0 var(--space-9);
    font-size: var(--display-2);
    line-height: 1.04;
    color: var(--text-on-dark);
    text-wrap: balance;
  }

  .wfstats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7);
    margin: 0 0 var(--space-4);
  }

  .wfstats__big {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-2);
    line-height: 0.95;
    color: var(--text-on-dark);
  }

  .wfstats__label {
    margin-top: var(--space-3);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1.5;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(246, 242, 232, 0.72);
  }

  .wfstats__disc {
    margin: 0 0 var(--space-10);
    padding-bottom: var(--space-9);
    border-bottom: 1px solid rgba(246, 242, 232, 0.18);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: rgba(246, 242, 232, 0.55);
  }

  .wfcols {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wfcol {
    padding-block: var(--space-7);
    border-top: 1px solid rgba(246, 242, 232, 0.18);
  }

  .wfcol:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .wfcol__n {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-6);
    line-height: 1;
    color: rgba(246, 242, 232, 0.66);
  }

  .wfcol__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--display-7);
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    color: var(--text-on-dark);
  }

  .wfcol__body {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-on-dark-2);
    text-wrap: pretty;
  }

  .whyfirm__link {
    margin: var(--space-10) 0 0;
  }

  /* The underline is on `.arrow-link__label`, not here: `.arrow-link` is a flex
     container, and a decoration declared on it reaches the glyph too. See
     global.css. */
  .whyfirm__link a {
    font-weight: 800;
    font-size: var(--text-sm);
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    text-decoration: none;
  }

  .whyfirm__fig {
    position: relative;
    min-height: 520px;
    border-radius: var(--radius-4);
    overflow: hidden;
    background: var(--dh-forest-100);
  }

  /* No `:global()` any more: the <img> is in THIS template now rather than
     inside `Picture`, so it carries this component's cid. */
  .whyfirm__fig .whyfirm__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Centred, where the previous photograph needed `70% 26%` to keep the
       colonnade off the attorneys' faces. Both crops are now composed for
       their own box and their ratios sit within a few percent of it, so
       `cover` trims single-digit percentages and there is nothing to correct
       for. Re-tune this if either photograph is replaced by an off-centre one. */
    object-position: center;
    display: block;
  }

  @media (max-width: 1080px) {
    .whyfirm__in {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    /* 16/9, matching the crop supplied for this breakpoint (1218 x 686 =
       1.776). It was 16/10, which would have cropped ~11% off the frame for no
       reason now that the source is drawn to fit. */
    .whyfirm__fig {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 640px) {
    .wfstats {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
