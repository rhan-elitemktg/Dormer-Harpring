---
// "We are built to try cases, not to settle them cheaply." — new in the second
// design, and the page's only argument for the firm rather than about the law.
//
// It absorbs the first design's separate "What we see in our own cases" band:
// the three closed-case figures now sit here, under the claim they support,
// with the methodology disclaimer directly beneath them rather than a section
// away.
import Picture from "../../media/Picture.astro";
import type { WhyFirmSection } from "../../../data/carAccidents";

interface Props {
  why: WhyFirmSection;
}

const { why } = Astro.props;
---

<section class="whyfirm">
  <div class="whyfirm__in">
    <div class="whyfirm__copy">
      <p class="whyfirm__eyebrow">{why.eyebrow}</p>
      <h2 class="whyfirm__title">{why.title}</h2>

      <dl class="wfstats">
        {
          why.stats.map((stat) => (
            <div class="wfstats__cell">
              <dd class="wfstats__big">{stat.big}</dd>
              <dt class="wfstats__label">{stat.label}</dt>
            </div>
          ))
        }
      </dl>

      <p class="wfstats__disc">{why.disclaimer}</p>

      <ol class="wfcols">
        {
          why.columns.map((column) => (
            <li class="wfcol">
              <span class="wfcol__n" aria-hidden="true">
                {column.n}
              </span>
              <h3 class="wfcol__title">{column.title}</h3>
              <p class="wfcol__body">{column.body}</p>
            </li>
          ))
        }
      </ol>

      <p class="whyfirm__link">
        <a class="arrow-link" href={why.ctaHref}>
          {why.ctaLabel}
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>

    <div class="whyfirm__fig">
      <Picture
        src={why.photo}
        alt={why.photoAlt}
        widths={[600, 1000, 1600]}
        sizes="(max-width: 1080px) 100vw, 48vw"
        class="whyfirm__img"
      />
    </div>
  </div>
</section>

<style>
  .whyfirm {
    background: var(--grad-forest);
    --forest-origin: 82%;
    color: var(--text-on-dark);
  }

  .whyfirm__in {
    display: grid;
    grid-template-columns: 52fr 48fr;
    gap: var(--space-18);
    align-items: stretch;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-section) var(--container-pad);
  }

  .whyfirm__eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgba(246, 242, 232, 0.72);
  }

  .whyfirm__title {
    margin: 0 0 var(--space-9);
    font-size: var(--display-2);
    line-height: 1.04;
    color: var(--text-on-dark);
    text-wrap: balance;
  }

  .wfstats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7);
    margin: 0 0 var(--space-4);
  }

  .wfstats__big {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-2);
    line-height: 0.95;
    color: var(--text-on-dark);
  }

  .wfstats__label {
    margin-top: var(--space-3);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1.5;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(246, 242, 232, 0.72);
  }

  .wfstats__disc {
    margin: 0 0 var(--space-10);
    padding-bottom: var(--space-9);
    border-bottom: 1px solid rgba(246, 242, 232, 0.18);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: rgba(246, 242, 232, 0.55);
  }

  .wfcols {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wfcol {
    padding-block: var(--space-7);
    border-top: 1px solid rgba(246, 242, 232, 0.18);
  }

  .wfcol:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .wfcol__n {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-6);
    line-height: 1;
    color: rgba(246, 242, 232, 0.66);
  }

  .wfcol__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--display-7);
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    color: var(--text-on-dark);
  }

  .wfcol__body {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-on-dark-2);
    text-wrap: pretty;
  }

  .whyfirm__link {
    margin: var(--space-10) 0 0;
  }

  .whyfirm__link a {
    font-weight: 800;
    font-size: var(--text-sm);
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .whyfirm__fig {
    position: relative;
    min-height: 520px;
    border-radius: var(--radius-4);
    overflow: hidden;
    background: var(--dh-forest-100);
  }

  .whyfirm__fig :global(.whyfirm__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 70% across: the attorneys stand right of centre in the frame, and a
       centred crop puts the colonnade where their faces should be. */
    object-position: 70% 26%;
    display: block;
  }

  @media (max-width: 1080px) {
    .whyfirm__in {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .whyfirm__fig {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 640px) {
    .wfstats {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
