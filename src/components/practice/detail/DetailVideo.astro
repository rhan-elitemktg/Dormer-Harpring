---
// The comp's `.ca-vid` / `.ca-ansmedia` — an attorney video poster with a play
// ring and an italic pull quote across its foot.
//
// INERT, like every other video panel on the site bar the six real client
// testimonials. `[data-video]` is the marker `global.css` uses to run the play
// ring's pulse on hover, and the panels become real <button>s when the lightbox
// lands. Deliberately not an <a> to nowhere in the meantime.
import Picture from "../../media/Picture.astro";
import PlayButton from "../../media/PlayButton.astro";
import type { VideoPanel } from "../../../data/carAccidents";

interface Props {
  video: VideoPanel;
  /**
   * `portrait` is the comp's 3:4 attorney panel; `wide` the 16:9 explainer;
   * `fill` stretches to the height of the row it sits in.
   */
  shape?: "portrait" | "wide" | "fill";
  size?: number;
  class?: string;
}

const { video, shape = "portrait", size = 66, class: className } = Astro.props;
---

<div class:list={["vid", `vid--${shape}`, className]} data-video>
  <Picture
    src={video.poster}
    alt={video.alt}
    widths={[400, 800]}
    sizes="(max-width: 980px) 100vw, 400px"
    class="vid__img"
  />
  <span class="vid__scrim" aria-hidden="true"></span>
  <PlayButton tone="accent" size={size} class="vid__play" />
  {video.caption && <span class="vid__quote">{video.caption}</span>}
</div>

<style>
  .vid {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-4);
    background: var(--dh-forest-100);
  }

  .vid--portrait {
    aspect-ratio: 3 / 4;
  }

  .vid--wide {
    aspect-ratio: 16 / 9;
  }

  .vid--fill {
    height: 100%;
    min-height: 260px;
  }

  .vid :global(.vid__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  /* The wash the quote sits on. 62% of the panel, as the comp has it — a
     shorter one leaves the second line of a two-line quote on bare photograph. */
  .vid__scrim {
    position: absolute;
    inset: auto 0 0 0;
    height: 62%;
    background: linear-gradient(
      180deg,
      rgba(16, 24, 19, 0) 0%,
      rgba(16, 24, 19, 0.55) 55%,
      rgba(16, 24, 19, 0.88) 100%
    );
    pointer-events: none;
  }

  .vid :global(.vid__play) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .vid__quote {
    position: absolute;
    z-index: 2;
    left: var(--space-5);
    right: var(--space-5);
    bottom: var(--space-5);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    color: var(--dh-white);
  }
</style>
