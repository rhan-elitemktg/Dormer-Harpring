---
// "Do I have a case?" — a video and three numbered conditions in one four-up
// row, then the inline CTA and the "we'll tell you no" note.
import DetailVideo from "./DetailVideo.astro";
import InlineCta from "./InlineCta.astro";
import type { CriteriaSection } from "../../../data/carAccidents";

interface Props {
  criteria: CriteriaSection;
}

const { criteria } = Astro.props;
---

<section class="section section--sunk criteria">
  <div class="container">
    <header class="criteria__head">
      <h2 class="criteria__title">{criteria.title}</h2>
      <p class="criteria__lede">{criteria.lede}</p>
    </header>

    <div class="criteria__row">
      <DetailVideo video={criteria.video} shape="fill" size={62} />
      {
        criteria.items.map((item, i) => (
          <div class="crit">
            <span class="crit__n" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="crit__title">{item.title}</h3>
            {item.body.map((paragraph) => (
              <p class="crit__body">{paragraph}</p>
            ))}
          </div>
        ))
      }
    </div>

    <InlineCta cta={criteria.inline} class="criteria__cta" />
    <p class="criteria__note">{criteria.note}</p>
  </div>
</section>

<style>
  .criteria__head {
    max-width: 760px;
    margin: 0 0 var(--space-11);
  }

  .criteria__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-3);
  }

  .criteria__lede {
    margin: 0;
    max-width: 52ch;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-body);
    text-wrap: pretty;
  }

  .criteria__row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--space-6);
    align-items: stretch;
  }

  .crit {
    display: flex;
    flex-direction: column;
    padding: var(--space-7);
    background: var(--dh-white);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-4);
  }

  .crit__n {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    border: 1px solid var(--accent-gold);
    color: var(--dh-gold-deep);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-md);
    line-height: 1;
  }

  .crit__title {
    margin: var(--space-4) 0 var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--display-7);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .crit__body {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* The inline bar sits tighter here than its default — it follows a row of
     cards rather than a column of prose. */
  .criteria :global(.criteria__cta) {
    padding: var(--space-8) var(--space-9);
  }

  .criteria__note {
    margin: var(--space-4) 0 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-meta);
  }

  @media (max-width: 1180px) {
    .criteria__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .criteria__row {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
  }
</style>
