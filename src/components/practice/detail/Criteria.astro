---
// "Do I have a case?" — a centred heading, one wide video, and the three
// conditions in a rule-divided row beneath it.
//
// The first design put the video in the row as a fourth column and closed on a
// red CTA bar. The second centres the opener, gives the video its own width,
// and drops the CTA entirely — the honesty note is the closer now, which is a
// better fit for a section whose point is "we will tell you if you have no case".
import DetailVideo from "./DetailVideo.astro";
import type { CriteriaSection } from "../../../data/carAccidents";

interface Props {
  criteria: CriteriaSection;
  /** The section nav's "Do I have a case?" target. */
  id: string;
}

const { criteria, id } = Astro.props;
---

<section class="section section--sunk criteria" id={id}>
  <div class="container">
    <header class="criteria__head">
      <h2 class="criteria__title">{criteria.title}</h2>
      <p class="criteria__lede">{criteria.lede}</p>
    </header>

    <DetailVideo video={criteria.video} focus="case" class="criteria__video" />

    <ol class="critlist">
      {
        criteria.items.map((item, i) => (
          <li class="crit">
            <span class="crit__n" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="crit__title">{item.title}</h3>
            <p class="crit__body">{item.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="criteria__note">{criteria.note}</p>
  </div>
</section>

<style>
  .criteria__head {
    max-width: 760px;
    margin: 0 auto var(--space-11);
    text-align: center;
  }

  .criteria__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-3);
  }

  .criteria__lede {
    margin: 0 auto;
    max-width: 52ch;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-body);
    text-wrap: pretty;
  }

  .criteria :global(.criteria__video) {
    max-width: 60%;
    margin: 0 auto var(--space-14);
  }

  .critlist {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A rule between columns rather than three cards: the section already sits on
     the deepest cream in the ladder, and boxing it would make four surfaces. */
  .crit {
    padding-left: var(--space-12);
    border-left: 1px solid rgba(44, 59, 49, 0.18);
  }

  .crit:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .crit__n {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-5);
    line-height: 1;
    color: var(--dh-forest-100);
  }

  .crit__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--display-7);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--dh-forest-100);
  }

  .crit__body {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .criteria__note {
    margin: var(--space-13) 0 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-meta);
    text-align: center;
  }

  @media (max-width: 980px) {
    .criteria :global(.criteria__video) {
      max-width: none;
    }

    .critlist {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .crit {
      padding: var(--space-6) 0;
      border-left: 0;
      border-top: 1px solid rgba(44, 59, 49, 0.18);
    }

    .crit:first-child {
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
