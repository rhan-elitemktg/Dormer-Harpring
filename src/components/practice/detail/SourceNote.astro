---
// The comp's `.ca-tr-src` — the statute citations under a section.
//
// Linked out as the comp draws them, in a new tab. The comp points all five at
// `law.justia.com/codes/colorado/` — the index rather than the section — so
// they currently land in the same place; the `STATUTE_INDEX` TODO(launch) in
// `data/carAccidents.ts` is where that gets resolved.
//
// `href` is optional, and a citation without one renders as plain text. That is
// the honest fallback for a statute this build has no URL for: a citation that
// reads as a link and goes nowhere is worse than one that doesn't pretend.
import type { SourceNote } from "../../../data/carAccidents";

interface Props {
  source: SourceNote;
  tone?: "light" | "dark";
  class?: string;
}

const { source, tone = "light", class: className } = Astro.props;
---

<p class:list={["src", tone === "dark" && "src--dark", className]}>
  {source.label}{" "}
  {
    source.items.map((item, i) => (
      <>
        {i > 0 && ", "}
        <cite class="src__cite">
          {item.href ? (
            <a class="src__link" href={item.href} target="_blank" rel="noopener">
              {item.label}
            </a>
          ) : (
            item.label
          )}
        </cite>
        {item.note && ` (${item.note})`}
      </>
    ))
  }.
</p>

<style>
  .src {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-prose);
    color: var(--dh-ink-5);
  }

  .src--dark {
    color: var(--text-on-dark-muted);
  }

  .src__cite {
    font-style: normal;
  }

  /* `inherit`, so the one rule serves both tones — the dark variant only has to
     change `.src`. The transition is declared here rather than inherited: a
     colour taken from an ancestor re-interpolates on the ANCESTOR's clock. */
  .src__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--dur) var(--ease);
  }

  .src__link:hover {
    color: var(--accent);
  }
</style>
