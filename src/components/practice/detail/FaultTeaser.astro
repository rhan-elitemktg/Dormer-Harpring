---
// "What if part of it was my fault?" — the comparative-fault scale and one
// paragraph, where the first design had a full section with a four-branch
// decision tree behind a disclosure.
//
// The bar is a FIGURE and carries no information the sentence beside it does
// not, so it is `aria-hidden` and the three labels under it are what a screen
// reader gets.
import SourceNote from "./SourceNote.astro";
import type { TeaserSection } from "../../../data/carAccidents";

interface Props {
  teaser: TeaserSection;
}

const { teaser } = Astro.props;
const scale = teaser.scale;
---

<section class="section--sm fault">
  <div class="container fault__grid">
    {
      /* The citation sits OUTSIDE the figure, which is why the column needs
         this wrapper. `<figure>` takes its caption as the first or last child
         and nothing else may follow it, so with the source note inside, the
         `<figcaption>` was the middle of three — invalid. It also reads better
         out here: the statute backs the sentence in the copy, not the drawing. */
    }
    <div class="fault__viz">
      <figure class="fault__fig">
        <div class="fault__bar" aria-hidden="true">
          <span></span>
          <i></i>
        </div>
        {
          scale && (
            <figcaption class="fault__lbl">
              <span>{scale.start}</span>
              <span>{scale.middle}</span>
              <span>{scale.end}</span>
            </figcaption>
          )
        }
      </figure>

      {teaser.source && <SourceNote source={teaser.source} class="fault__src" />}
    </div>

    <div class="fault__copy">
      <h2 class="fault__title">{teaser.title}</h2>
      <p class="fault__body">{teaser.body}</p>
      {
        teaser.ctaHref ? (
          <a class="fault__cta arrow-link" href={teaser.ctaHref}>
            <span class="arrow-link__label">{teaser.ctaLabel}</span>
            <span class="arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
        ) : (
          <span class="fault__cta fault__cta--inert">{teaser.ctaLabel}</span>
        )
      }
    </div>
  </div>
</section>

<style>
  .fault {
    background: var(--surface-alt);
  }

  .fault__grid {
    display: grid;
    grid-template-columns: 56fr 44fr;
    gap: var(--space-16);
    align-items: center;
  }

  .fault__fig {
    margin: 0;
  }

  .fault__bar {
    position: relative;
    height: 22px;
    border-radius: 11px;
    background: var(--dh-line-strong);
    overflow: visible;
  }

  /* The filled half is "your share up to 50%"; the upright is the threshold
     where recovery stops. Two elements, because they are two facts. */
  .fault__bar span {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 50%;
    border-radius: 11px 0 0 11px;
    background: var(--dh-forest-100);
  }

  .fault__bar i {
    position: absolute;
    left: 50%;
    top: -9px;
    bottom: -9px;
    width: 3px;
    margin-left: -1.5px;
    background: var(--dh-forest-100);
  }

  /* THREE COLUMNS, NOT `space-between`. The middle label annotates the 50%
     upright, and space-between only centres a middle item when the outer two
     are the SAME WIDTH — its centre resolves to `a + gap + b/2`, which equals
     `W/2` only when `a == c`. "None of it your fault" is half again as long as
     "All your fault", so the label sat roughly 25px right of the mark it
     explains. Two equal `1fr` tracks put the middle column on 50% whatever the
     copy says, which is the point: this has to survive an editor rewording it.
     `minmax(0, …)` so a long outer label wraps instead of widening its track
     and shoving the centre off again. */
  .fault__lbl {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .fault__lbl span {
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dh-forest-100);
  }

  .fault__lbl span:nth-child(2) {
    text-align: center;
  }

  .fault__lbl span:last-child {
    text-align: right;
  }

  .fault :global(.fault__src) {
    margin-top: var(--space-6);
    color: var(--text-meta);
  }

  .fault__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-4);
    line-height: 1.04;
    text-wrap: balance;
  }

  .fault__body {
    margin: 0 0 var(--space-6);
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--text-body);
    text-wrap: pretty;
  }

  /* Typography only. The LAYOUT is `.arrow-link`'s, and `display` deliberately
     is not set here: this class carries a cid, so it would outrank
     `.arrow-link`'s `inline-flex` and drop the glyph back onto the text
     baseline. The underline lives on `.arrow-link__label` — declared on the
     anchor it struck the arrow too, which is what was shipping. */
  .fault__cta {
    white-space: nowrap;
    font-weight: 800;
    font-size: var(--text-sm);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dh-forest-100);
    text-decoration: none;
  }

  a.fault__cta:hover {
    color: var(--accent);
  }

  /* Unreachable while `ctaHref` is the blog index, and kept for the CMS phase:
     the field is nullable and an editor clearing it must not leave a dead link.
     Nothing to un-underline — that rule is on the label, which this branch
     does not render. */
  .fault__cta--inert {
    color: var(--text-meta);
  }

  @media (max-width: 980px) {
    .fault__grid {
      grid-template-columns: 1fr;
      gap: var(--space-9);
    }

    /* The three labels stack rather than shrink — at 320px they overlap. One
       column, so the centre track no longer applies; there is no upright to
       line up with once they are in a list. */
    .fault__lbl {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .fault__lbl span,
    .fault__lbl span:nth-child(2),
    .fault__lbl span:last-child {
      text-align: left;
    }
  }
</style>
