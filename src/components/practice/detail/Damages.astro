---
// "What money can I actually get?" — ten plain-English tiles, the three legal
// categories behind a disclosure, then the panel explaining why there is no
// dollar figure on this page.
//
// The order is deliberate and worth keeping: the tiles are what a person
// recognises ("work you missed"), the columns are what a statute calls the same
// thing ("lost future earning capacity"). Leading with the legal names is what
// every competitor page does and it is why they are unreadable.
import DamageIcon from "../../icons/DamageIcon.astro";
import Disclosure from "./Disclosure.astro";
import PhoneAsk from "./PhoneAsk.astro";
import SourceNote from "./SourceNote.astro";
import type { DamagesSection } from "../../../data/carAccidents";
import type { FirmDetails } from "../../../data/site";

interface Props {
  damages: DamagesSection;
  firm: FirmDetails;
}

const { damages, firm } = Astro.props;
---

<section class="section section--cream damages">
  <div class="container">
    <header class="damages__head">
      <h2 class="damages__title">{damages.title}</h2>
      <p class="damages__lede">{damages.lede}</p>
    </header>

    <ul class="pay">
      {
        damages.tiles.map((tile) => (
          <li class="pay__i">
            <span class="pay__ico">
              <DamageIcon name={tile.iconKey} />
            </span>
            <b class="pay__title">{tile.title}</b>
            <p class="pay__body">{tile.body}</p>
          </li>
        ))
      }
    </ul>

    <Disclosure label={damages.disclosure.label} class="damages__more">
      <div class="cols">
        {
          damages.columns.map((column) => (
            <div class="col">
              <h3 class="col__name">{column.name}</h3>
              <p class="col__lbl">{column.itemsLabel}</p>
              <ul class="col__items">
                {column.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="col__lbl">{column.proofLabel}</p>
              <p class="col__body">{column.proof}</p>
              <div class="col__cap">
                <p class="col__lbl">{column.capLabel}</p>
                <b>{column.cap}</b>
                <p class="col__body col__body--last">{column.capNote}</p>
              </div>
            </div>
          ))
        }
      </div>
      <SourceNote source={damages.source} />
    </Disclosure>

    <div class="nonum">
      <h3 class="nonum__title">{damages.noNumber.title}</h3>
      <div>
        <p class="nonum__body">{damages.noNumber.body}</p>
        <PhoneAsk text={damages.noNumber.ask.text} firm={firm} tone="dark" />
      </div>
    </div>
  </div>
</section>

<style>
  .damages__head {
    max-width: 820px;
    margin: 0 0 var(--space-11);
  }

  .damages__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-3);
  }

  .damages__lede {
    margin: 0;
    max-width: 56ch;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* A 1px gap over a hairline background draws every divider at once — ten
     cells would otherwise need per-cell border rules that all disagree at the
     wrap points. */
  .pay {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--border-hairline);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-4);
    overflow: hidden;
  }

  .pay__i {
    display: grid;
    grid-template-columns: 48px 1fr;
    column-gap: var(--space-5);
    align-items: start;
    padding: var(--space-7);
    background: var(--dh-white);
  }

  .pay__ico {
    grid-column: 1;
    grid-row: 1 / span 2;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--dh-gold-tint);
    border: 1px solid var(--dh-line-gold);
    color: var(--dh-gold-deep);
  }

  .pay__title {
    grid-column: 2;
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .pay__body {
    grid-column: 2;
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .damages :global(.damages__more) {
    margin-top: var(--space-6);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7);
    align-items: stretch;
  }

  .col {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    background: var(--dh-white);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-4);
  }

  .col__name {
    margin: 0 0 var(--space-5);
    font-size: var(--display-6);
    line-height: var(--leading-display-2);
  }

  .col__lbl {
    margin: 0 0 var(--space-3);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-gold-deep);
  }

  .col__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .col__items li {
    padding: 7px var(--space-3);
    border-radius: var(--radius-8);
    background: var(--dh-forest-100);
    color: var(--dh-white);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-btn);
    text-transform: uppercase;
  }

  .col__body {
    margin: 0 0 var(--space-6);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .col__body--last {
    margin-bottom: 0;
  }

  .col__cap {
    margin-top: auto;
    padding-top: var(--space-5);
    border-top: 1px solid var(--dh-line-soft);
  }

  .col__cap b {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-7);
    color: var(--text-strong);
  }

  .nonum {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-14);
    align-items: start;
    margin-top: var(--space-11);
    padding: var(--space-13) var(--space-14);
    background: var(--surface-dark-card);
    border-radius: var(--radius-4);
  }

  /* On forest, and therefore already parchment via global.css — restated so
     the colour is visible where the rule is, not two files away. */
  .nonum__title {
    margin: 0;
    font-size: var(--display-5);
    line-height: 1.06;
    color: var(--text-on-dark);
    text-wrap: balance;
  }

  .nonum__body {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--text-on-dark-2);
    text-wrap: pretty;
  }

  @media (max-width: 1180px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 980px) {
    .nonum {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding: var(--space-10) var(--space-8);
    }
  }

  @media (max-width: 760px) {
    .pay {
      grid-template-columns: 1fr;
    }
  }
</style>
