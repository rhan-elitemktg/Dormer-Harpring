---
// "More on car accident claims" — two feature cards over six text cards, where
// the first design had two columns of bare links.
//
// EVERY ONE OF THE EIGHT IS AN ARTICLE THE FIRM HAS NOT WRITTEN. Their subjects
// are the first design's cut sections — the insurance Q&As, the damages grid,
// the adjuster tactics, the venue list — turned into promised reading. The comp
// points all eight at the blog index, which this build serves, so they keep
// that destination rather than becoming eight dead hrefs.
// TODO(launch): "Read the answer" landing on an index with no such answer is a
// launch problem. Write the eight, or cut the section back to what exists.
import Picture from "../../media/Picture.astro";
import type { MoreSection } from "../../../data/carAccidents";

interface Props {
  more: MoreSection;
}

const { more } = Astro.props;
---

<section class="section more">
  <div class="container">
    <h2 class="more__title">{more.title}</h2>

    <ul class="morefeats">
      {
        more.features.map((feature) => (
          <li>
            <a class="morefeat" href={feature.href ?? undefined}>
              <span class="morefeat__fig">
                <Picture
                  src={feature.poster}
                  alt=""
                  widths={[500, 900]}
                  sizes="(max-width: 980px) 100vw, 45vw"
                  class="morefeat__img"
                />
                <span class="morefeat__dur">{feature.length}</span>
                {/* Decorative, and it stays that way: this card is already a
                    link to the article, so the glyph cannot become a popover
                    trigger without nesting one <a> inside another. Same
                    decision as AttorneyCard — see the note there. */}
                <span class="morefeat__play" aria-hidden="true">
                  <svg width="16" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5.5v13l11-6.5z" />
                  </svg>
                </span>
              </span>
              <h3 class="morefeat__title">{feature.title}</h3>
              <p class="morefeat__body">{feature.body}</p>
              <span class="morefeat__link arrow-link">
                <span class="arrow-link__label">{feature.ctaLabel}</span>
                <i class="arrow" aria-hidden="true">
                  &rarr;
                </i>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="morecards">
      {
        more.cards.map((card) => (
          <li>
            <a class="mcard" href={card.href ?? undefined}>
              <h3 class="mcard__title">{card.title}</h3>
              <p class="mcard__body">{card.body}</p>
              <span class="mcard__link arrow-link">
                <span class="arrow-link__label">{card.ctaLabel}</span>
                <i class="arrow" aria-hidden="true">
                  &rarr;
                </i>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .more {
    background: var(--dh-forest-300);
    color: var(--text-on-dark);
  }

  .more__title {
    margin: 0 0 var(--space-11);
    font-size: var(--display-3);
    color: var(--text-on-dark);
  }

  .morefeats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-9);
    margin: 0 0 var(--space-14);
    padding: 0 0 var(--space-13);
    border-bottom: 1px solid rgba(246, 242, 232, 0.16);
    list-style: none;
  }

  .morefeat {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .morefeat__fig {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-4);
    overflow: hidden;
    background: var(--dh-forest-100);
  }

  .morefeat__fig :global(.morefeat__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    display: block;
  }

  .morefeat__fig::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 14, 11, 0) 55%, rgba(10, 14, 11, 0.5) 100%);
  }

  .morefeat__play {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 2;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--dh-white);
    color: var(--dh-forest-100);
    box-shadow: 0 8px 22px rgba(8, 14, 10, 0.35);
    transition: transform var(--dur) var(--ease);
  }

  .morefeat:hover .morefeat__play {
    transform: scale(1.08);
  }

  .morefeat__dur {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 2;
    padding: 4px 8px;
    border-radius: var(--radius-2);
    background: rgba(10, 14, 11, 0.62);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1;
    color: var(--dh-white);
  }

  /* `margin: 0` because these are <h3>s now, not <b>s — the eight card titles
     are the only structure in a section that exists to be scanned, and `<b>`
     contributes nothing to the outline. */
  .morefeat__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-6);
    line-height: 1.16;
    color: var(--text-on-dark);
    transition: transform var(--transition);
    transform-origin: left center;
  }

  .morefeat:hover .morefeat__title {
    transform: translateX(3px);
  }

  .morefeat__body {
    margin: var(--space-3) 0 var(--space-5);
    flex: 1;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: rgba(246, 242, 232, 0.75);
    text-wrap: pretty;
  }

  /* The flex box is `.arrow-link`'s and the underline is on its
     `.arrow-link__label`. Declared here it also struck the glyph: this is a
     flex container, so the decoration propagates into the blockified children
     and a child cannot turn it off. The rule that used to try —
     `.morefeat__link .arrow { text-decoration: none }` — never did anything,
     and its comment said it did. */
  .morefeat__link,
  .mcard__link {
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    text-decoration: none;
  }

  /* The glyph is an <i> here, where most arrows on the page are a <span>. */
  .morefeat__link .arrow,
  .mcard__link .arrow {
    font-style: normal;
  }

  /* ---- the six ---- */

  .morecards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-7);
    border-left: 1px solid rgba(246, 242, 232, 0.16);
    text-decoration: none;
    transition: background var(--transition);
  }

  /* The first column's TEXT sits on the container's left edge, which used to
     mean `padding-left: 0` — and `.mcard:hover` then painted its wash hard
     against that text while every other card's was inset by `--space-7`. Along
     a row the highlight changed shape. The padding is restored and pulled back
     out by the same amount, so the text does not move and the wash matches.
     `--space-7` (28px) stays inside `--container-pad` at both widths this rule
     applies to (48px, and 32px below 1280px). */
  .morecards > li:nth-child(3n + 1) .mcard {
    border-left: 0;
    padding-left: var(--space-7);
    margin-left: calc(var(--space-7) * -1);
  }

  .morecards > li:nth-child(-n + 3) .mcard {
    padding-top: 0;
  }

  .morecards > li:nth-child(n + 4) .mcard {
    border-top: 1px solid rgba(246, 242, 232, 0.16);
  }

  .mcard:hover {
    background: rgba(246, 242, 232, 0.05);
  }

  .mcard__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    color: var(--text-on-dark);
    transition: transform var(--transition);
    transform-origin: left center;
  }

  .mcard:hover .mcard__title {
    transform: translateX(3px);
  }

  .mcard__body {
    margin: var(--space-3) 0 var(--space-5);
    flex: 1;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: rgba(246, 242, 232, 0.75);
    text-wrap: pretty;
  }

  @media (max-width: 980px) {
    .morefeats {
      grid-template-columns: 1fr;
    }

    .morecards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Two columns, so the first column is now the ODD cards and card 4 stops
       being one. The bleed follows the first column rather than the rule that
       set it at three-up. */
    .morecards > li:nth-child(3n + 1) .mcard {
      border-left: 1px solid rgba(246, 242, 232, 0.16);
      padding-left: var(--space-7);
      margin-left: 0;
    }

    .morecards > li:nth-child(odd) .mcard {
      border-left: 0;
      padding-left: var(--space-7);
      margin-left: calc(var(--space-7) * -1);
    }

    .morecards > li:nth-child(-n + 3) .mcard {
      padding-top: var(--space-7);
      border-top: 1px solid rgba(246, 242, 232, 0.16);
    }

    .morecards > li:nth-child(-n + 2) .mcard {
      padding-top: 0;
      border-top: 0;
    }
  }

  @media (max-width: 640px) {
    .morecards {
      grid-template-columns: 1fr;
    }

    /* One column, and NO bleed: `--container-pad` is 24px here, less than the
       28px it would pull, so the card would hang past the gutter. There is also
       no second column left to be out of step with. */
    .morecards > li .mcard {
      border-left: 0;
      padding-left: 0;
      margin-left: 0;
      padding-top: var(--space-6);
      border-top: 1px solid rgba(246, 242, 232, 0.16);
    }

    .morecards > li:first-child .mcard {
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
