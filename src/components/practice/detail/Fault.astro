---
// "Who was at fault?" — the one-word answer, the four questions that decide it
// behind a disclosure, and three follow-ups.
//
// The comparative-fault scale is a FIGURE, not a control: a bar with a mark at
// 50% and three labels. It carries no value the copy above it doesn't already
// state, so it is `aria-hidden` and the caption does the work.
import BigAnswerCard from "./BigAnswerCard.astro";
import DetailBlocks from "./DetailBlocks.astro";
import DetailVideo from "./DetailVideo.astro";
import Disclosure from "./Disclosure.astro";
import PhoneAsk from "./PhoneAsk.astro";
import SourceNote from "./SourceNote.astro";
import type { FaultSection } from "../../../data/carAccidents";
import type { FirmDetails } from "../../../data/site";

interface Props {
  fault: FaultSection;
  firm: FirmDetails;
}

const { fault, firm } = Astro.props;
---

<section class="section section--alt fault">
  <div class="container fault__split">
    <div>
      <header class="fault__head">
        <h2 class="fault__title">{fault.title}</h2>
        <p class="fault__lede">{fault.lede}</p>
      </header>

      <BigAnswerCard
        figure={fault.big.figure}
        statement={fault.big.statement}
        body={fault.big.body}
        figureWrap
      />

      <Disclosure label={fault.disclosure.label} class="fault__more">
        <p class="fault__branches-label">{fault.branchesLabel}</p>
        <ol class="tree">
          {
            fault.branches.map((branch) => (
              <li class="branch">
                <b>{branch.n}</b>
                <h3 class="branch__q">{branch.question}</h3>
                <p class="branch__a">{branch.answer}</p>
              </li>
            ))
          }
        </ol>

        <figure class="scalebox">
          <figcaption class="figcap">{fault.scale.caption}</figcaption>
          <div class="scale" aria-hidden="true"></div>
          <div class="scale__lbl" aria-hidden="true">
            <span>{fault.scale.start}</span>
            <span class="scale__over">{fault.scale.middle}</span>
            <span>{fault.scale.end}</span>
          </div>
        </figure>
      </Disclosure>

      <SourceNote source={fault.source} class="fault__source" />
      <DetailBlocks blocks={fault.blocks} />
      <PhoneAsk text={fault.foot.text} firm={firm} />
    </div>

    <div>
      <DetailVideo video={fault.video} />
    </div>
  </div>
</section>

<style>
  .fault__split {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--space-14);
    align-items: start;
  }

  .fault__head {
    margin-bottom: var(--space-9);
  }

  .fault__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-3);
  }

  .fault__lede {
    margin: 0;
    max-width: 54ch;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-body);
    text-wrap: pretty;
  }

  .fault :global(.fault__more) {
    margin-bottom: var(--space-2);
  }

  .fault__branches-label {
    margin: 0 0 var(--space-6);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-gold-muted);
  }

  .tree {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .branch {
    padding: var(--space-7) var(--space-6);
    background: var(--surface-page);
    border: 1px solid var(--border-hairline);
    border-top: 3px solid var(--accent-gold);
    border-radius: var(--radius-4);
  }

  .branch b {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-6);
    line-height: 1;
    color: var(--accent-gold);
  }

  .branch__q {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .branch__a {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .scalebox {
    margin: var(--space-10) 0 0;
    padding: var(--space-8);
    background: var(--dh-white);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-4);
  }

  .figcap {
    margin: 0 0 var(--space-2);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-gold-muted);
  }

  .scale {
    position: relative;
    height: 12px;
    margin: var(--space-5) 0 var(--space-3);
    border-radius: var(--radius-3);
    background: linear-gradient(
      90deg,
      var(--dh-line-strong) 0%,
      var(--dh-line-strong) 50%,
      var(--dh-gold-tint) 50%,
      var(--dh-gold-tint) 100%
    );
  }

  .scale::after {
    content: "";
    position: absolute;
    left: 50%;
    top: -6px;
    width: 2px;
    height: 24px;
    background: var(--dh-red-verdict);
  }

  .scale__lbl {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-meta);
  }

  .scale__over {
    color: var(--dh-red-verdict);
  }

  .fault :global(.fault__source) {
    margin-bottom: var(--space-2);
  }

  @media (max-width: 1180px) {
    .tree {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 980px) {
    .fault__split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 700px) {
    .tree {
      grid-template-columns: 1fr;
    }

    /* The three labels stack rather than shrink — at 320px they overlap. */
    .scale__lbl {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
