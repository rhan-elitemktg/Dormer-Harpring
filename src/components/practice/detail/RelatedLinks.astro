---
// "Related" — five other practice areas and five supporting articles.
//
// The five areas all resolve to a live legacy URL. The five articles match no
// post among the 167 in the scrape, so they carry `href: null` and render as
// plain text — the same treatment the Blog index gives its eight card-less
// cards and the Practice Areas directory gives Legal Malpractice. See the note
// on `RelatedSection.articles`.
import type { RelatedSection } from "../../../data/carAccidents";

interface Props {
  related: RelatedSection;
}

const { related } = Astro.props;

const columns = [
  { _key: "areas", label: related.areasLabel, items: related.areas },
  { _key: "articles", label: related.articlesLabel, items: related.articles },
];
---

<section class="section--sm rellinks">
  <div class="container">
    <h2 class="rellinks__title">{related.title}</h2>

    <div class="rellinks__grid">
      {
        columns.map((column) => (
          <div>
            <p class="rellinks__label">{column.label}</p>
            <ul class="rellinks__list">
              {column.items.map((item) => (
                <li>
                  {item.href ? (
                    <a class="rellinks__link arrow-link" href={item.href}>
                      {item.label}
                      <span class="arrow" aria-hidden="true">
                        &rarr;
                      </span>
                    </a>
                  ) : (
                    <span class="rellinks__text">{item.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .rellinks {
    background: var(--dh-forest-300);
    color: var(--text-on-dark);
  }

  .rellinks__title {
    margin: 0 0 var(--space-9);
    font-size: var(--display-3);
    color: var(--text-on-dark);
  }

  .rellinks__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-14);
  }

  .rellinks__label {
    margin: 0 0 var(--space-3);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  .rellinks__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rellinks__link,
  .rellinks__text {
    display: flex;
    padding-block: var(--space-4);
    border-bottom: 1px solid rgba(246, 242, 232, 0.16);
    font-weight: 600;
    font-size: var(--text-md);
    line-height: var(--leading-tight);
    color: var(--text-on-dark);
    text-decoration: none;
  }

  .rellinks__link:hover {
    color: var(--dh-gold-bright);
  }

  /* An entry with no page reads as unavailable rather than as a link that does
     nothing — the colour is the only cue it gets, so it has to carry. */
  .rellinks__text {
    color: var(--text-on-dark-muted);
  }

  @media (max-width: 980px) {
    .rellinks__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
