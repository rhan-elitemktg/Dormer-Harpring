---
// "8 things to do after a car accident" — a teaser where the first design had
// the whole eight-step timeline.
//
// The illustration is DECORATION: four sample steps pinned alternately above
// and below a rule, fading out at the right edge under a mask. It repeats
// labels the article would carry, so it is `aria-hidden` and the copy beside it
// does the work.
//
// TODO(launch): the comp links this at `DH - Blog - What to do after a car
// accident.html`, a post comp that arrived with this revision and that this
// build does not serve. By Rhan's decision the label stays and the link does
// not — nothing points at a page that doesn't exist. Build the article, then
// set `ctaHref`.
import type { TeaserSection } from "../../../data/carAccidents";

interface Props {
  teaser: TeaserSection;
}

const { teaser } = Astro.props;
const steps = teaser.steps ?? [];

const ICONS: Record<string, string[]> = {
  police: ["M12 3l7 3v6c0 4-3 6.5-7 9-4-2.5-7-5-7-9V6z"],
  camera: ["M3 8h4l2-3h6l2 3h4v11H3z"],
  witnesses: ["M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 5.5a3 3 0 010 6M18 20c0-2.5-1-4.6-2.6-5.6"],
  stethoscope: ["M6 3v6a6 6 0 0012 0V3M18 15a3 3 0 006 0"],
};
---

<section class="section--sm teaser-band">
  <div class="container teaser">
    <div class="teaser__copy">
      <h2 class="teaser__title">{teaser.title}</h2>
      <p class="teaser__body">{teaser.body}</p>
      {
        teaser.ctaHref ? (
          <a class="teaser__cta" href={teaser.ctaHref}>
            {teaser.ctaLabel} &rarr;
          </a>
        ) : (
          <span class="teaser__cta teaser__cta--inert">{teaser.ctaLabel}</span>
        )
      }
    </div>

    <div class="teaser__viz" aria-hidden="true">
      <span class="teaser__line"></span>
      <div class="teaser__row">
        {
          steps.map((step, i) => (
            <span
              class:list={["teaser__slot", step.iconKey === "none" && "teaser__slot--ghost"]}
              data-pos={i % 2 === 0 ? "up" : "down"}
            >
              {i % 2 === 1 && <i />}
              <span class="teaser__card">
                {ICONS[step.iconKey] && (
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    {ICONS[step.iconKey].map((d) => (
                      <path d={d} />
                    ))}
                    {step.iconKey === "camera" && <circle cx="12" cy="12.5" r="3.5" />}
                    {step.iconKey === "witnesses" && <circle cx="8" cy="7.5" r="3.5" />}
                  </svg>
                )}
                {step.label}
              </span>
              {i % 2 === 0 && <i />}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .teaser-band {
    background: var(--surface-page);
  }

  .teaser {
    display: grid;
    grid-template-columns: 38fr 62fr;
    gap: var(--space-14);
    align-items: center;
    min-height: 300px;
  }

  .teaser__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-4);
    line-height: 1.04;
    text-wrap: balance;
  }

  .teaser__body {
    margin: 0 0 var(--space-6);
    max-width: 44ch;
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .teaser__cta {
    display: inline-block;
    white-space: nowrap;
    font-weight: 800;
    font-size: var(--text-sm);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dh-forest-100);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  a.teaser__cta:hover {
    color: var(--accent);
  }

  /* No page behind it yet, so no link colour and no underline — the label is
     the comp's content, the affordance is not. */
  .teaser__cta--inert {
    color: var(--text-meta);
    text-decoration: none;
  }

  /* ---- the illustration ---- */

  .teaser__viz {
    position: relative;
    height: 236px;
    overflow: hidden;
    /* Fades at the right rather than clipping: the row is a sample of eight,
       and a hard edge implies it is all of them. */
    -webkit-mask-image: linear-gradient(90deg, #000 74%, transparent 99%);
    mask-image: linear-gradient(90deg, #000 74%, transparent 99%);
  }

  .teaser__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--dh-forest-100);
    opacity: 0.28;
  }

  .teaser__row {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .teaser__slot {
    position: relative;
    display: grid;
    grid-template-rows: 1fr 12px 1fr;
    height: 100%;
  }

  .teaser__slot i {
    grid-row: 2;
    justify-self: start;
    width: 11px;
    height: 11px;
    margin-left: var(--space-6);
    border-radius: var(--radius-full);
    background: var(--dh-forest-100);
    box-shadow: 0 0 0 4px var(--surface-page);
  }

  .teaser__card {
    position: relative;
    justify-self: start;
    display: inline-flex;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: 100%;
    padding: 10px 12px;
    background: var(--dh-white);
    border-radius: var(--radius-4);
    box-shadow: 0 8px 22px rgba(35, 46, 39, 0.13);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.28;
    letter-spacing: var(--tracking-tight);
    color: var(--dh-forest-100);
    text-wrap: pretty;
  }

  .teaser__card svg {
    flex: none;
    margin-top: 1px;
  }

  .teaser__slot[data-pos="up"] .teaser__card {
    grid-row: 1;
    align-self: end;
    margin-bottom: 11px;
  }

  .teaser__slot[data-pos="down"] .teaser__card {
    grid-row: 3;
    align-self: start;
    margin-top: 11px;
  }

  .teaser__card::after {
    content: "";
    position: absolute;
    left: var(--space-6);
    width: 10px;
    height: 10px;
    background: var(--dh-white);
    transform: rotate(45deg);
  }

  .teaser__slot[data-pos="up"] .teaser__card::after {
    bottom: -5px;
  }

  .teaser__slot[data-pos="down"] .teaser__card::after {
    top: -5px;
  }

  .teaser__slot--ghost .teaser__card {
    white-space: nowrap;
  }

  @media (max-width: 980px) {
    .teaser {
      grid-template-columns: 1fr;
      gap: var(--space-9);
    }

    .teaser__viz {
      height: 200px;
    }

    .teaser__row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .teaser__slot:nth-child(n + 4) {
      display: none;
    }
  }
</style>
