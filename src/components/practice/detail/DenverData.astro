---
// "Car accidents in Denver" — three city figures, each with a line about what
// it means for a claim, then the five corridors against a schematic map.
//
// THREE FIGURES, NOT FOUR. The comp's dead `denverData` array still lists the
// first design's four bare numbers; the markup draws three, each with a
// consequence attached ("which means your own uninsured motorist coverage
// becomes the claim"). The markup is the source — see the note at the top of
// `data/carAccidents.ts`.
//
// The map is a SCHEMATIC — five strokes and five numbered nodes over a city
// outline, not a real map of Denver. It is `role="img"` with a label that says
// so, and the caption under it repeats it, because a diagram that looks like a
// map and is not is worse than no map.
import type { DenverSection } from "../../../data/carAccidents";

interface Props {
  denver: DenverSection;
}

const { denver } = Astro.props;
---

<section class="section section--sunk denver">
  <div class="container">
    <header class="denver__head">
      <h2 class="denver__title">{denver.title}</h2>
      <p class="denver__lede">{denver.lede}</p>
    </header>

    <dl class="stat3">
      {
        denver.stats.map((stat) => (
          <div class="stat3__cell">
            <dd class="stat3__big">{stat.big}</dd>
            <dt class="stat3__label">{stat.label}</dt>
            <dd class="stat3__body">{stat.body}</dd>
          </div>
        ))
      }
    </dl>

    <p class="stat3__src">{denver.source}</p>

    <div class="corrmap">
      <figure class="corrmap__fig">
        <svg
          class="map2"
          viewBox="0 0 420 480"
          role="img"
          aria-label="Schematic diagram of Denver showing five crash corridors, numbered to match the list beside it"
        >
          <path
            d="M64 40 L356 40 L356 214 L392 214 L392 300 L330 300 L330 442 L96 442 L96 356 L48 356 L48 150 L64 150 Z"
            fill="var(--surface-alt)"
            stroke="rgba(44,59,49,.35)"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
          <g fill="none" stroke="var(--dh-forest-100)" stroke-width="3.4" stroke-linecap="round">
            <path d="M150 40 C142 130 128 210 118 300 C112 356 108 400 104 442"></path>
            <path d="M48 250 L392 250"></path>
            <path d="M116 40 L116 442"></path>
            <path d="M296 40 L296 442"></path>
            <path d="M84 108 C140 176 208 236 266 296 C296 328 316 352 330 372"></path>
          </g>
          <g class="map2__pins">
            <circle cx="150" cy="70" r="14"></circle><text x="150" y="75">1</text>
            <circle cx="356" cy="250" r="14"></circle><text x="356" y="255">2</text>
            <circle cx="116" cy="404" r="14"></circle><text x="116" y="409">3</text>
            <circle cx="296" cy="120" r="14"></circle><text x="296" y="125">4</text>
            <circle cx="232" cy="264" r="14"></circle><text x="232" y="269">5</text>
          </g>
        </svg>
        <figcaption>{denver.mapCaption}</figcaption>
      </figure>

      <ol class="corrlist">
        {
          denver.corridors.map((corridor) => (
            <li>
              <b>{corridor.name}</b>
              <p>{corridor.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .denver__head {
    max-width: 760px;
    margin: 0 0 var(--space-11);
  }

  .denver__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-3);
  }

  .denver__lede {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-body);
    text-wrap: pretty;
  }

  .stat3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    background: var(--grad-forest);
    --forest-origin: 88%;
    border-radius: var(--radius-4);
    overflow: hidden;
  }

  .stat3__cell {
    padding: var(--space-9) var(--space-8) var(--space-10);
    border-left: 1px solid rgba(246, 242, 232, 0.16);
  }

  .stat3__cell:first-child {
    border-left: 0;
  }

  .stat3__big {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-2);
    line-height: 0.95;
    color: var(--text-on-dark);
  }

  .stat3__label {
    margin-top: var(--space-3);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1.5;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-dark);
  }

  .stat3__body {
    margin: var(--space-4) 0 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: rgba(246, 242, 232, 0.75);
    text-wrap: pretty;
  }

  .stat3__src {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-meta);
  }

  .corrmap {
    display: grid;
    grid-template-columns: 45fr 55fr;
    gap: var(--space-14);
    align-items: start;
    margin-top: var(--space-14);
  }

  .corrmap__fig {
    margin: 0;
  }

  .map2 {
    display: block;
    width: 100%;
    height: auto;
  }

  .map2__pins circle {
    fill: var(--dh-forest-100);
  }

  .map2__pins text {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    fill: var(--text-on-dark);
    text-anchor: middle;
  }

  .corrmap__fig figcaption {
    margin-top: var(--space-4);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-meta);
  }

  /* Numbered by a counter rather than by markup, so the list and the map's
     pins cannot drift apart when a corridor is added or reordered. */
  .corrlist {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: corr;
  }

  .corrlist li {
    position: relative;
    counter-increment: corr;
    padding: var(--space-6) 0 var(--space-6) var(--space-13);
    border-top: 1px solid rgba(44, 59, 49, 0.18);
  }

  .corrlist li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .corrlist li::before {
    content: counter(corr);
    position: absolute;
    left: 0;
    top: var(--space-5);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--dh-forest-100);
    color: var(--text-on-dark);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1;
  }

  .corrlist li:first-child::before {
    top: -2px;
  }

  .corrlist b {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--dh-forest-100);
  }

  .corrlist p {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-body);
    text-wrap: pretty;
  }

  @media (max-width: 980px) {
    .stat3 {
      grid-template-columns: 1fr;
    }

    .stat3__cell {
      border-left: 0;
      border-top: 1px solid rgba(246, 242, 232, 0.16);
    }

    .stat3__cell:first-child {
      border-top: 0;
    }

    .corrmap {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
</style>
