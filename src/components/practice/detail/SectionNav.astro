---
// The in-page jump list under the hero. Sticky, and a horizontally scrolling
// row below its breakpoint rather than a wrap — a second line of it would push
// the page content down on every scroll.
//
// The hrefs come from `CA_SECTION_IDS` in the data module, which is also what
// each section renders as its own `id`. See the note there on why these are not
// run through `lib/headings.ts` — they are handles, not slugified headings, so
// there is nothing for a slugifier to do and no second one to drift from.
//
// `scroll-behavior: smooth` is already global, so the jumps need no script.
// The one thing that does is marking where the reader currently IS — see
// `scripts/sectionNav.ts`, wired by the `data-section-nav` attribute below.
import type { PracticeAreaDetail } from "../../../data/carAccidents";
import type { FirmDetails } from "../../../data/site";

interface Props {
  nav: PracticeAreaDetail["nav"];
  firm: FirmDetails;
  ctaHref: string;
}

const { nav, firm, ctaHref } = Astro.props;
---

<nav class="subnav" aria-label="On this page" data-section-nav>
  <div class="subnav__in">
    {
      /* `data-section-link` opts these five into the scroll highlight. The CTA
         below points at `#contact` too and deliberately does not carry it — a
         red button gaining a nav item's underline reads as broken. */
      nav.items.map((item) => (
        <a class="subnav__link" href={item.href} data-section-link>
          {item.label}
        </a>
      ))
    }
    <a class="subnav__tel" href={`tel:${firm.phoneE164}`}>{firm.phone}</a>
    <a class="subnav__cta" href={ctaHref}>{nav.ctaLabel}</a>
  </div>
</nav>

<style>
  .subnav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--surface-page) 96%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-hairline);
    box-shadow: 0 8px 24px rgba(25, 34, 28, 0.07);
  }

  .subnav__in {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: 66px;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .subnav__in::-webkit-scrollbar {
    display: none;
  }

  /* The underline is declared here and TRANSPARENT, rather than on the current
     link, for two reasons: `text-decoration` cannot be animated, so putting it
     on the current state would snap the rule on while the colour eased; and a
     link that gains an underline only when current would change height as the
     highlight moved along the row. `text-decoration-color` does animate. */
  .subnav__link {
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1;
    letter-spacing: var(--tracking-btn);
    text-transform: uppercase;
    color: var(--text-body);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 7px;
    transition: color var(--transition), text-decoration-color var(--transition);
  }

  .subnav__link:hover {
    color: var(--accent);
  }

  /* Where the reader has scrolled to. Set by `scripts/sectionNav.ts`. */
  .subnav__link[aria-current="location"] {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .subnav__tel {
    margin-left: auto;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
    text-decoration: none;
    white-space: nowrap;
  }

  .subnav__tel:hover {
    color: var(--accent);
  }

  .subnav__cta {
    display: inline-flex;
    align-items: center;
    height: 42px;
    padding-inline: var(--space-6);
    border-radius: var(--radius-3);
    background: var(--accent);
    color: var(--dh-white);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-btn);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .subnav__cta:hover {
    background: var(--accent-hover);
    color: var(--dh-white);
  }

  /* The number drops out before the links do, and it drops out EARLY: six
     labels plus the number plus the CTA fill the bar at around 1190px, so
     between here and 1180px the number is what would push the links into a
     horizontal scroll. It is repeated in the hero directly above and again in
     the closing block, so it is the cheapest thing in the row to lose. 1180 is
     the breakpoint the hero already turns on. */
  @media (max-width: 1180px) {
    .subnav__tel {
      display: none;
    }

    .subnav__cta {
      margin-left: auto;
    }
  }
</style>

<script>
  import "../../../scripts/sectionNav";
</script>
