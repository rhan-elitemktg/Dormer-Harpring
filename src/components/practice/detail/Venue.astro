---
// "Where your case gets filed, and why it matters" — the venue argument, and
// the four district courts the firm files in.
import type { VenueSection } from "../../../data/carAccidents";

interface Props {
  venue: VenueSection;
}

const { venue } = Astro.props;
---

<section class="section section--alt venue">
  <div class="container venue__grid">
    <div>
      <h2 class="venue__title">{venue.title}</h2>
      {venue.body.map((paragraph) => <p class="venue__body">{paragraph}</p>)}
    </div>

    <ol class="courts">
      {
        venue.courts.map((court) => (
          <li class="court">
            <b class="court__n" aria-hidden="true">
              {court.n}
            </b>
            <div>
              <h3 class="court__name">{court.name}</h3>
              <p class="court__body">{court.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .venue__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-14);
    align-items: start;
  }

  .venue__title {
    margin: 0 0 var(--space-6);
    font-size: var(--display-3);
  }

  .venue__body {
    margin: 0 0 var(--space-5);
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--text-body);
    text-wrap: pretty;
  }

  .venue__body:last-child {
    margin-bottom: 0;
  }

  .courts {
    margin: 0;
    padding: var(--space-3) var(--space-8);
    list-style: none;
    background: var(--dh-white);
    border-radius: var(--radius-4);
  }

  .court {
    display: flex;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: 1px solid var(--dh-line-soft);
  }

  .court:first-child {
    border-top: 0;
  }

  .court__n {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    background: var(--dh-gold-tint);
    color: var(--dh-gold-muted);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1;
  }

  .court__name {
    margin: 0 0 var(--space-1);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    color: var(--text-strong);
  }

  .court__body {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .venue__grid {
      grid-template-columns: 1fr;
      gap: var(--space-9);
    }
  }
</style>
