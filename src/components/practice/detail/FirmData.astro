---
// "What we see in our own cases" — three figures out of the firm's own closed
// files, with the methodology note the comp itself marks as pending.
//
// The note stays visible rather than being dropped: three unsourced numbers
// with no methodology beside them is exactly the claim the FTC and the Colorado
// bar's advertising rules care about, and hiding the gap does not close it.
import type { FirmDataSection } from "../../../data/carAccidents";

interface Props {
  firmData: FirmDataSection;
}

const { firmData } = Astro.props;
---

<section class="section section--cream firmdata">
  <div class="container">
    <header class="firmdata__head">
      <h2 class="firmdata__title">{firmData.title}</h2>
      <p class="firmdata__lede">{firmData.lede}</p>
    </header>

    <dl class="fd">
      {
        firmData.stats.map((stat) => (
          <div class="fd__cell">
            <dd class="fd__big">{stat.big}</dd>
            <dt class="fd__label">{stat.label}</dt>
          </div>
        ))
      }
    </dl>

    <p class="firmdata__method">{firmData.methodology}</p>
    <p class="firmdata__disc">{firmData.disclaimer}</p>
  </div>
</section>

<style>
  .firmdata__head {
    max-width: 760px;
    margin: 0 0 var(--space-9);
  }

  .firmdata__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-3);
  }

  .firmdata__lede {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .fd {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    background: var(--surface-dark-card);
    border-radius: var(--radius-4);
    overflow: hidden;
  }

  .fd__cell {
    padding: var(--space-9) var(--space-8);
    border-left: 1px solid var(--dh-line-dark);
  }

  .fd__cell:first-child {
    border-left: 0;
  }

  .fd__big {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--display-4);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-on-dark);
  }

  .fd__label {
    margin-top: var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: var(--leading-snug);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dh-gold-label);
  }

  .firmdata__method {
    margin: var(--space-7) 0 0;
    max-width: 80ch;
    font-size: var(--text-md);
    line-height: var(--leading-prose);
    color: var(--text-meta);
  }

  .firmdata__disc {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-meta);
  }

  @media (max-width: 980px) {
    .fd {
      grid-template-columns: 1fr;
    }

    .fd__cell {
      border-left: 0;
      border-top: 1px solid var(--dh-line-dark);
    }

    .fd__cell:first-child {
      border-top: 0;
    }
  }
</style>
