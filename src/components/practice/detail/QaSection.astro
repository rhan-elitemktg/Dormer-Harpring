---
// The comp's `.ca-ans` — heading and (optionally) a video down the left, the
// answer in ruled blocks down the right. Three sections are built out of it:
// "Who pays my medical bills", "What if their insurance isn't enough", and
// "The insurance company offered me money".
//
// The declarations-page mock lives here rather than in its own component
// because these three are its only callers, and two of them reach it through
// this file.
import DetailBlocks from "./DetailBlocks.astro";
import DetailVideo from "./DetailVideo.astro";
import InlineCta from "./InlineCta.astro";
import SourceNote from "./SourceNote.astro";
import type { QaSection } from "../../../data/carAccidents";

interface Props {
  qa: QaSection;
  /** `.section--cream`, `--alt` or `--sunk`; the page alternates them. */
  surface: "cream" | "alt" | "sunk";
}

const { qa, surface } = Astro.props;
const figure = qa.figure;
---

<section class:list={["section", `section--${surface}`, "qa"]} id={qa.id}>
  <div class="container qa__grid">
    <div>
      <h2 class="qa__title">{qa.title}</h2>
      <p class="qa__lede">{qa.lede}</p>
      {qa.video && <DetailVideo video={qa.video} size={62} class="qa__video" />}
    </div>

    <div>
      <DetailBlocks blocks={qa.blocks} figureAfter={qa.figureAfter}>
        {
          figure && (
            <figure class="decl-wrap" slot="figure">
              <figcaption class="decl__cap">{figure.caption}</figcaption>
              <div class="decl">
                <div class="decl__head">
                  <b>{figure.title}</b>
                  <span>{figure.meta}</span>
                </div>
                {figure.rows.map((row) => (
                  <p class:list={["decl__row", row.highlight && "decl__row--on"]}>
                    <span>{row.label}</span>
                    <span>{row.value}</span>
                  </p>
                ))}
                <p class="decl__note">
                  <b>{figure.note.label}</b>
                  {figure.note.text}
                </p>
              </div>
            </figure>
          )
        }
      </DetailBlocks>

      {qa.inline && <InlineCta cta={qa.inline} />}
      {qa.source && <SourceNote source={qa.source} class="qa__source" />}
    </div>
  </div>
</section>

<style>
  .qa__grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: var(--space-14);
    align-items: start;
  }

  .qa__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-3);
    text-wrap: balance;
  }

  .qa__lede {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .qa :global(.qa__video) {
    margin-top: var(--space-7);
    /* 4:5 rather than the component's 3:4 default — this one sits in a narrow
       column beside a long answer, and a taller frame keeps its foot near the
       first block's. */
    aspect-ratio: 4 / 5;
  }

  .qa :global(.qa__source) {
    margin-top: var(--space-6);
  }

  /* ---- The declarations-page mock ---- */

  .decl-wrap {
    margin: var(--space-7) 0 var(--space-2);
  }

  .decl__cap {
    margin: 0 0 var(--space-2);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-gold-muted);
  }

  .decl {
    background: var(--dh-white);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-4);
    overflow: hidden;
  }

  .decl__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--dh-line-soft);
  }

  .decl__head b {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .decl__head span {
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dh-ink-5);
  }

  .decl__row {
    display: grid;
    grid-template-columns: 1.6fr 0.7fr;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--dh-line-soft);
    font-weight: 500;
    font-size: var(--text-md);
    line-height: var(--leading-tight);
    color: var(--text-muted);
  }

  .decl__row span:last-child {
    text-align: right;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--text-body);
  }

  /* The one line the section is about. Marked by a rule and a tint rather than
     by colour alone, so it still reads as the highlighted row in mono. */
  .decl__row--on {
    padding-left: calc(var(--space-6) - 3px);
    background: var(--dh-gold-tint);
    border-left: 3px solid var(--accent-gold);
    color: var(--text-strong);
    font-weight: 700;
  }

  .decl__row--on span:last-child {
    color: var(--dh-red-verdict);
  }

  .decl__note {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-4) var(--space-6);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--dh-gold-muted);
  }

  .decl__note b {
    flex: none;
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dh-red-verdict);
  }

  @media (max-width: 980px) {
    .qa__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 560px) {
    .decl__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .decl__row span:last-child {
      text-align: left;
    }
  }
</style>
