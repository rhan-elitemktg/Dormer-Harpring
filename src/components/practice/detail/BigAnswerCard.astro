---
// The comp's `.ca-bigans--alert` — a red-bordered card whose whole job is to
// answer the section's heading in one word before any explanation starts.
// "$0", "No", "Still yes".
//
// The figure is a <p>, not a heading: it is the answer to the h2 above it, not
// a new section. Making it an h3 would put "$0" in the document outline.

interface Props {
  figure: string;
  statement: string;
  body: string;
  /** `wrap` lets a two-word figure ("Still yes") break; the default never does. */
  figureWrap?: boolean;
  class?: string;
}

const { figure, statement, body, figureWrap = false, class: className } = Astro.props;
---

<div class:list={["bigans", className]}>
  <p class:list={["bigans__n", figureWrap && "bigans__n--wrap"]}>{figure}</p>
  <div>
    <p class="bigans__statement">{statement}</p>
    <p class="bigans__body">{body}</p>
  </div>
</div>

<style>
  .bigans {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-9);
    align-items: center;
    margin-bottom: var(--space-7);
    padding: var(--space-10);
    background: var(--dh-white);
    border: 3px solid var(--accent);
    border-radius: var(--radius-4);
  }

  .bigans__n {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-answer);
    line-height: 0.85;
    letter-spacing: var(--tracking-tight);
    color: var(--accent);
    white-space: nowrap;
  }

  .bigans__n--wrap {
    max-width: 7ch;
    white-space: normal;
    font-size: var(--display-5);
    line-height: 0.95;
  }

  .bigans__statement {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--display-6);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .bigans__body {
    margin: 0;
    max-width: 52ch;
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--text-body);
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    .bigans {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding: var(--space-8);
    }
  }
</style>
