---
// "Keep this in your glove box" — the printed wallet card, drawn front and back.
//
// The two cards are a PICTURE of the printed thing, not a second copy of the
// checklist above: same six steps, abbreviated to what fits on a card. Marked
// `aria-hidden` would be wrong (the deadlines and the don'ts appear nowhere
// else on the page), so they stay in the accessibility tree as plain lists.
import Eyebrow from "../../Eyebrow.astro";
import type { GloveBoxSection } from "../../../data/carAccidents";
import type { FirmDetails } from "../../../data/site";

interface Props {
  gloveBox: GloveBoxSection;
  firm: FirmDetails;
}

const { gloveBox, firm } = Astro.props;
---

<section class="section glove">
  <div class="container glove__grid">
    <div>
      <Eyebrow tone="on-dark" class="glove__eyebrow">{gloveBox.eyebrow}</Eyebrow>
      <h2 class="glove__title">{gloveBox.title}</h2>
      <p class="glove__body">{gloveBox.body}</p>

      <div class="glove__ctas">
        {
          gloveBox.ctas.map((cta) => (
            <a
              class:list={["btn", cta.tone === "red" ? "btn--red" : "btn--outline-light"]}
              href={cta.href}
            >
              {cta.label}
            </a>
          ))
        }
      </div>

      <p class="glove__note">{gloveBox.note}</p>
    </div>

    <div class="glove__cards">
      <div class="gcard">
        <span class="gcard__face">{gloveBox.front.faceLabel}</span>
        <p class="gcard__ttl">{gloveBox.front.title}</p>
        <ol class="gsteps">
          {
            gloveBox.front.steps.map((step, i) => (
              <li>
                <b>{i + 1}</b>
                {step}
              </li>
            ))
          }
        </ol>
        <div class="gfoot">
          <div>
            <span class="gfoot__lbl">{gloveBox.front.footLabel}</span>
            <span class="gfoot__num">{firm.phone}</span>
          </div>
        </div>
      </div>

      <div class="gcard">
        <span class="gcard__face">{gloveBox.back.faceLabel}</span>
        <div class="gback">
          <div class="gnot">
            <p>{gloveBox.back.notTitle}</p>
            <ul>
              {gloveBox.back.notItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="gdl">
            {
              gloveBox.back.deadlines.map((deadline) => (
                <div>
                  <b>{deadline.big}</b>
                  <span>{deadline.label}</span>
                </div>
              ))
            }
          </div>

          <div class="gfoot">
            <div>
              <span class="gfoot__lbl">{gloveBox.back.footLabel}</span>
              <span class="gfoot__num">{firm.phone}</span>
            </div>
            {/* A drawn stand-in, not a scannable code — there is no artwork and
                no landing page for one yet. Hidden from the reading order for
                that reason; its label explains what the printed card would do. */}
            <span class="qr" aria-hidden="true"></span>
            <span class="qr__lbl">{gloveBox.back.qrLabel}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .glove {
    background: var(--surface-dark-card);
    color: var(--text-on-dark);
  }

  .glove__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-14);
    align-items: start;
  }

  .glove :global(.glove__eyebrow) {
    margin-bottom: var(--space-4);
  }

  .glove__title {
    margin: 0 0 var(--space-5);
    font-size: var(--display-3);
    color: var(--text-on-dark);
  }

  .glove__body {
    margin: 0 0 var(--space-8);
    max-width: 52ch;
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--text-on-dark-2);
    text-wrap: pretty;
  }

  .glove__ctas {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .glove__note {
    margin: var(--space-6) 0 0;
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
  }

  .glove__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .gcard {
    position: relative;
    aspect-ratio: 16 / 7;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border-radius: var(--radius-4);
    background: var(--surface-page);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.34);
  }

  .gcard__face {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dh-ink-5);
  }

  .gcard__ttl {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-lg);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .gsteps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3) var(--space-5);
    margin: 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .gsteps li {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    color: var(--dh-ink-link);
  }

  .gsteps b {
    flex: none;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-md);
    color: var(--dh-red-verdict);
  }

  .gback {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .gnot {
    flex: 1;
    padding: var(--space-3);
    background: var(--surface-sunk);
    border-radius: var(--radius-3);
  }

  .gnot p {
    margin: 0;
    font-weight: 800;
    font-size: var(--text-nano);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dh-gold-muted);
  }

  .gnot ul {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .gnot li {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-micro);
    line-height: 1.3;
    color: var(--dh-ink-link);
  }

  .gdl {
    display: flex;
    gap: var(--space-2);
  }

  .gdl div {
    flex: 1;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--dh-line-strong);
    border-radius: var(--radius-3);
  }

  .gdl b {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--dh-red-verdict);
  }

  .gdl span {
    display: block;
    margin-top: var(--space-1);
    font-weight: 700;
    font-size: var(--text-nano);
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-meta);
  }

  .gfoot {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .gfoot > div {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .gfoot__lbl {
    font-weight: 700;
    font-size: var(--text-nano);
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-meta);
  }

  .gfoot__num {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .qr {
    margin-left: auto;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: var(--radius-2);
    background: repeating-conic-gradient(
        var(--dh-ink) 0% 25%,
        var(--surface-page) 0% 50%
      )
      0 0 / 13px 13px;
    border: 3px solid var(--surface-page);
    outline: 1px solid var(--dh-line-strong);
  }

  .qr__lbl {
    max-width: 70px;
    font-weight: 700;
    font-size: var(--text-nano);
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-meta);
    text-align: right;
  }

  @media (max-width: 980px) {
    .glove__grid {
      grid-template-columns: 1fr;
    }
  }

  /* The card mock stops being legible below its own aspect ratio — at 340px
     wide the six steps are 8px. Let it grow taller instead of shrinking type. */
  @media (max-width: 640px) {
    .gcard {
      aspect-ratio: auto;
    }

    .gsteps {
      grid-template-columns: 1fr;
      margin-bottom: var(--space-5);
    }
  }
</style>
