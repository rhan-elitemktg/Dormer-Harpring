---
// "Meet our car accident lawyers" — attorney cards, each with a line about what
// they do on crash cases specifically.
//
// The first design drew a seven-portrait contact sheet, photo and name only.
// This one names each attorney and says why they are on the page, which is the
// version that does any work — and it is the reason the section also emits
// `Attorney` structured data.
//
// A FULL-WIDTH RAIL, NOT THE COMP'S GRID. The comp draws four across, which
// puts a fifth attorney alone on a second row and re-balances the section every
// time the roster changes. On a rail the count is open: the track gets longer
// and nothing else moves. Same `scripts/rail.ts` as the homepage band and the
// results rail below, wired by name.
//
// The PORTRAIT and the NAME come from `team.ts`; the CREDENTIAL LINE comes from
// the page document, because it is written about car accident work and belongs
// to this practice area rather than to the roster.
import Picture from "../../media/Picture.astro";
import JsonLd from "../../seo/JsonLd.astro";
import { initialsOf, type TeamMember } from "../../../data/team";
import type { LawyersSection } from "../../../data/carAccidents";

interface Props {
  section: LawyersSection;
  /** Resolved by the page, in the data's order. */
  members: (TeamMember & { cred: string })[];
  id: string;
  /** Absolute site origin, for the JSON-LD `url` fields. */
  siteUrl: string;
  firmName: string;
}

const { section, members, id, siteUrl, firmName } = Astro.props;

// The comp ships an `Attorney` @graph beside this section. Emitted because
// every claim in it is rendered on the page: the name, the role, the portrait
// and a link to the bio. `sameAs` is deliberately NOT ported — the comp points
// every attorney at the Colorado Supreme Court's attorney SEARCH form and at
// linkedin.com, neither of which identifies the person.
// TODO(launch): real bar-record and LinkedIn URLs per attorney would make
// `sameAs` worth adding.
const schema = {
  "@context": "https://schema.org",
  "@graph": members.map((member) => ({
    "@type": "Attorney",
    name: member.name,
    jobTitle: member.role,
    ...(member.href ? { url: `${siteUrl}${member.href}` } : {}),
    worksFor: { "@type": "LegalService", name: firmName, url: `${siteUrl}/` },
    knowsAbout: "car accident litigation",
  })),
};
---

<section class="section section--cream lawyers" id={id}>
  <div class="container">
    <header class="lawyers__head">
      <h2 class="lawyers__title">{section.title}</h2>
      <p class="lawyers__lede">{section.lede}</p>
    </header>

    {
      /* Above the rail and hard right, so the controls read as belonging to the
         row they drive. They are NOT `.arrow` links: a carousel control is a
         control, not something that navigates. `rail.ts` hides this whole
         wrapper when the cards fit and there is nothing to scroll. */
    }
    <div class="lawyers__nav" data-rail-nav="ca-lawyers">
      <button
        type="button"
        class="lawyers__arrow"
        data-rail-prev="ca-lawyers"
        aria-label="Previous attorneys"
      >
        <span aria-hidden="true">&larr;</span>
      </button>
      <button
        type="button"
        class="lawyers__arrow"
        data-rail-next="ca-lawyers"
        aria-label="Next attorneys"
      >
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    <div
      class="lawyers__rail noscroll"
      data-rail="ca-lawyers"
      tabindex="0"
      role="group"
      aria-label="Our car accident lawyers, scrollable"
    >
      <ul class="lawyers__track">
        {
        members.map((member) => (
          <li class="lw">
            {member.href ? (
              <a class="lw__ph" href={member.href}>
                {member.photo ? (
                  <Picture
                    src={member.photo}
                    alt={member.name}
                    widths={[280, 560]}
                    sizes="(max-width: 700px) 90vw, 280px"
                    class="lw__img"
                  />
                ) : (
                  <span class="lw__mono" aria-hidden="true">
                    {initialsOf(member.name)}
                  </span>
                )}
              </a>
            ) : (
              <span class="lw__ph">
                {member.photo ? (
                  <Picture
                    src={member.photo}
                    alt={member.name}
                    widths={[280, 560]}
                    sizes="(max-width: 700px) 90vw, 280px"
                    class="lw__img"
                  />
                ) : (
                  <span class="lw__mono" aria-hidden="true">
                    {initialsOf(member.name)}
                  </span>
                )}
              </span>
            )}

            {member.href ? (
              <a class="lw__nm" href={member.href}>
                {member.name}
              </a>
            ) : (
              <span class="lw__nm">{member.name}</span>
            )}

            <span class="lw__role">{member.role}</span>
            <p class="lw__cred">{member.cred}</p>
          </li>
        ))
        }
      </ul>
    </div>

    <p class="lawyers__more">
      <a class="lawyers__more-link arrow-link" href={section.moreHref}>
        <span class="arrow-link__label">{section.moreLabel}</span>
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </div>
</section>

<JsonLd schema={schema} />

<style>
  .lawyers__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-14);
    align-items: start;
    /* Was `--space-14`, when the rail followed the head directly. The arrows
       now sit in that gap, so it is split between the two — and when they are
       hidden this is the whole distance to the rail, which is why it keeps most
       of the original measure rather than a token's worth. */
    margin-bottom: var(--space-10);
  }

  .lawyers__title {
    margin: 0;
    font-size: var(--display-3);
    text-wrap: balance;
  }

  .lawyers__lede {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .lawyers__rail {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* The scrollbar is hidden (`.noscroll`), so this is not clearing a track —
       it keeps a focused card's ring from being clipped by the scroll box. */
    padding-bottom: var(--space-2);
  }

  .lawyers__track {
    display: flex;
    gap: var(--space-9);
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Four across at full width. A calc off the gap rather than a rounded
     percentage, because the whole point of the rail is that the COUNT is open:
     the basis has to keep drawing four no matter how many cards follow. */
  .lw {
    display: flex;
    flex-direction: column;
    flex: 0 0 calc((100% - 3 * var(--space-9)) / 4);
    min-width: 0;
    scroll-snap-align: start;
  }

  .lw__ph {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-4);
    overflow: hidden;
    background: var(--surface-alt);
  }

  .lw__ph :global(.lw__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .lw__mono {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--display-5);
    color: var(--dh-ink-5);
  }

  .lw__nm {
    margin-top: var(--space-5);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--dh-forest-100);
    text-decoration: none;
  }

  a.lw__nm:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lw__role {
    margin-top: var(--space-2);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-meta);
  }

  .lw__cred {
    margin: var(--space-3) 0 0;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .lawyers__more {
    margin: var(--space-11) 0 0;
    text-align: center;
  }

  /* Forest rather than the site's red: this comp moves almost every accent to
     `--dh-forest-100`. See the note in HANDOFF.md — it is this page only.
     The underline is on `.arrow-link__label`; see global.css on why it cannot
     sit here without also striking the glyph. */
  .lawyers__more-link {
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dh-forest-100);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .lawyers__more-link:hover {
    color: var(--accent);
  }

  .lawyers__nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  /* Beats the rule above, the same way `.rail-dots[hidden]` does: `rail.ts`
     sets `hidden` when the four cards fit exactly and there is nothing to
     scroll, and an author `display: flex` otherwise outranks the UA's
     `[hidden] { display: none }`. */
  .lawyers__nav[hidden] {
    display: none;
  }

  /* The same control `ResultStories` draws, so the page's two rails are
     operated the same way. */
  .lawyers__arrow {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-3);
    border: 1px solid rgba(44, 59, 49, 0.3);
    background: transparent;
    color: var(--dh-forest-100);
    font-size: var(--text-2xl);
    line-height: 1;
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition),
      color var(--transition);
  }

  .lawyers__arrow:hover:not(:disabled) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--dh-white);
  }

  .lawyers__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  @media (max-width: 1180px) {
    .lawyers__head {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .lw {
      flex-basis: calc((100% - var(--space-9)) / 2);
    }
  }

  /* One card, with the next one showing — the peek is what says the row
     scrolls, now that there is no second grid row to imply more below. */
  @media (max-width: 700px) {
    .lw {
      flex-basis: 86%;
    }
  }
</style>

<script>
  import "../../../scripts/rail";
</script>
