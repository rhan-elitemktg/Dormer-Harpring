---
// "If you read nothing else on this page" — four ticked points, the page's own
// summary of itself.
import Eyebrow from "../../Eyebrow.astro";
import type { TakeawaysSection } from "../../../data/carAccidents";

interface Props {
  takeaways: TakeawaysSection;
  /**
   * The section nav's "Colorado car accident laws" target. In the first design
   * that pointed at a long medical-bills section; the second cuts it, and this
   * four-point summary is what the link has always meant.
   */
  id: string;
}

const { takeaways, id } = Astro.props;
---

<section class="section--sm takeaways" id={id}>
  <div class="container takeaways__grid">
    <header>
      {/* The comp draws this one's rule in forest rather than gold — the band
          sits on white between two other white sections, and the gold reads as
          a fourth surface. Eyebrow has no forest tone, so the rule is recoloured
          here rather than a tone added for one use. */}
      <Eyebrow class="takeaways__eyebrow">{takeaways.eyebrow}</Eyebrow>
      <h2 class="takeaways__title">{takeaways.title}</h2>
      <p class="takeaways__lede">{takeaways.lede}</p>
    </header>

    <ul class="takeaways__list">
      {
        takeaways.items.map((item) => (
          <li class="takeaway">
            <svg
              class="takeaway__ico"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 12.5l5.2 5.2L20 6.9"></path>
            </svg>
            <h3 class="takeaway__title">{item.title}</h3>
            <p class="takeaway__body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .takeaways {
    background: var(--dh-white);
  }

  .takeaways__grid {
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    gap: var(--space-20);
    align-items: start;
  }

  .takeaways :global(.takeaways__eyebrow) {
    margin-bottom: var(--space-4);
    color: var(--dh-forest-100);
  }

  .takeaways :global(.takeaways__eyebrow)::before {
    background: var(--dh-forest-100);
  }

  .takeaways__title {
    margin: 0 0 var(--space-4);
    font-size: var(--display-3);
    text-wrap: balance;
  }

  .takeaways__lede {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .takeaways__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12) var(--space-18);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .takeaway__ico {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--dh-forest-100);
  }

  .takeaway__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--display-7);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--dh-forest-100);
  }

  .takeaway__body {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-body);
    text-wrap: pretty;
  }

  @media (max-width: 980px) {
    .takeaways__grid {
      grid-template-columns: 1fr;
      gap: var(--space-9);
    }

    .takeaways__list {
      grid-template-columns: 1fr;
    }
  }
</style>
