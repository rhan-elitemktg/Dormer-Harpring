---
// "What we were offered, and what we recovered." — four car accident results on
// a rail, one of which is a client video.
//
// ONE CARD SHAPE. Every card draws the same boxed offered/recovered figure, the
// same title, body and footnote, at the same sizes and in the same order. The
// video card differs in exactly two things: a photograph behind it, and a play
// button. The comp drew it as a bespoke overlay instead — figures reversed out
// of a scrim, a runtime chip, a 64px button, the quote pinned to the foot — and
// that is gone at Rhan's request. Its figure box goes translucent so the
// photograph reads through, and its ink goes forest to survive that.
//
// THE VIDEO CARD LINKS TO THE REAL VIDEO. The comp opens a lightbox that shows
// the poster IMAGE and the quote again — there is no player in it, so it is a
// prototype gesture rather than a feature. This client's testimonial is one of
// the six real ones on the `@denvertrial` channel, so the card links out to it
// exactly as `/testimonials` and the homepage rail already do. That also keeps
// the page's only lightbox from being a lightbox that shows a photograph.
import Picture from "../../media/Picture.astro";
import PlayButton from "../../media/PlayButton.astro";
import Eyebrow from "../../Eyebrow.astro";
import { videoWatchUrl } from "../../../lib/video";
import type { VideoReview } from "../../../data/testimonials";
import type { ResultsSection } from "../../../data/carAccidents";

interface Props {
  results: ResultsSection;
  /** Resolved by the page from the one story that carries a `reviewKey`. */
  reviews: Record<string, VideoReview>;
  id: string;
}

const { results, reviews, id } = Astro.props;
---

<section class="section section--cream stories" id={id}>
  <div class="container">
    <header class="stories__head">
      <Eyebrow class="stories__eyebrow">{results.eyebrow}</Eyebrow>
      <h2 class="stories__title">{results.title}</h2>
    </header>

    <div
      class="stories__rail noscroll"
      data-rail="ca-results"
      tabindex="0"
      role="group"
      aria-label="Car accident case results, scrollable"
    >
      <div class="stories__track">
        {
          results.stories.map((story) => {
            const review = story.reviewKey ? reviews[story.reviewKey] : undefined;

            if (review) {
              return (
                <a
                  class="res res--vid"
                  href={videoWatchUrl(review.video)}
                  target="_blank"
                  rel="noopener"
                >
                  <Picture
                    src={review.poster}
                    alt={`${review.name} — client testimonial video`}
                    widths={[400, 800]}
                    sizes="(max-width: 980px) 86vw, 420px"
                    class="res__img"
                  />
                  <span class="res__scrim" aria-hidden="true" />

                  <p class="res__fig">
                    <span class="res__figrow">
                      <span class="res__lbl">{results.offeredLabel}</span>
                      <span class="res__off">{story.offered}</span>
                    </span>
                    <span class="res__figrow res__figrow--rec">
                      <span class="res__lbl">{results.recoveredLabel}</span>
                      <span class="res__rec">{story.recovered}</span>
                    </span>
                  </p>
                  <h3 class="res__title">{story.title}</h3>
                  <p class="res__story">{review.quote}</p>
                  <p class="res__chg">{review.name}</p>

                  <PlayButton tone="light" size={44} class="res__play" />
                </a>
              );
            }

            return (
              <article class="res">
                <p class="res__fig">
                  <span class="res__figrow">
                    <span class="res__lbl">{results.offeredLabel}</span>
                    <span class="res__off">{story.offered}</span>
                  </span>
                  <span class="res__figrow res__figrow--rec">
                    <span class="res__lbl">{results.recoveredLabel}</span>
                    <span class="res__rec">{story.recovered}</span>
                  </span>
                </p>
                <h3 class="res__title">{story.title}</h3>
                <p class="res__story">{story.story}</p>
                <p class="res__chg">{story.changed}</p>
              </article>
            );
          })
        }
      </div>
    </div>

    <div class="stories__foot">
      <p class="stories__disc">{results.disclaimer}</p>
      {
        /* `rail.ts` hides this wrapper when the rail has nothing to scroll.
           That used to be every desktop width — three cards at a rounded 31.4%
           fit any inner width over ~827px, so both arrows sat permanently
           disabled. The fourth result is what gives them work: the slides now
           fill the track exactly, so a fourth overflows it outright. */
      }
      <div class="stories__nav" data-rail-nav="ca-results">
        <button
          type="button"
          class="stories__arrow"
          data-rail-prev="ca-results"
          aria-label="Previous result"
        >
          <span aria-hidden="true">&larr;</span>
        </button>
        <button
          type="button"
          class="stories__arrow"
          data-rail-next="ca-results"
          aria-label="Next result"
        >
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .stories__head {
    margin-bottom: var(--space-14);
  }

  .stories :global(.stories__eyebrow) {
    margin-bottom: var(--space-4);
    color: var(--dh-forest-100);
  }

  .stories :global(.stories__eyebrow)::before {
    background: var(--dh-forest-100);
  }

  .stories__title {
    margin: 0;
    font-size: var(--display-3);
    text-wrap: balance;
  }

  .stories__rail {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 4px;
  }

  .stories__track {
    display: flex;
    gap: var(--space-6);
    align-items: stretch;
  }

  /* Three across, as a calc off the gap rather than the comp's rounded 31.4%.
     That figure left the third card 24px short of the container's right edge,
     which put it out of line with the arrows below — they sit on the container,
     so the slides have to as well. Same reason `.lw` on the lawyers rail is a
     calc: the count is open, and the basis has to keep drawing three however
     many follow. */
  .res {
    display: flex;
    flex-direction: column;
    flex: 0 0 calc((100% - 2 * var(--space-6)) / 3);
    min-width: 0;
    scroll-snap-align: start;
    padding: var(--space-7) var(--space-7) var(--space-8);
    background: var(--dh-white);
    border-radius: var(--radius-4);
    text-decoration: none;
  }

  .res__fig {
    display: block;
    margin: 0;
    padding: var(--space-4) var(--space-5);
    background: var(--dh-cream-50);
    border: 1px solid var(--dh-line-soft);
    border-radius: var(--radius-4);
  }

  .res__figrow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: 9px;
  }

  .res__figrow--rec {
    padding: 9px 0 0;
    border-top: 1px solid var(--dh-line-soft);
  }

  .res__lbl {
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dh-ink-5);
  }

  .res__off {
    font-weight: 500;
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--dh-ink-5);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  /* Forest, not the verdict red the other results pages use — this comp's
     accent shift. See HANDOFF.md; it is this page only. */
  .res__rec {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-6);
    line-height: 0.95;
    color: var(--dh-forest-100);
    text-wrap: balance;
  }

  .res__title {
    margin: var(--space-5) 0 var(--space-3);
    font-size: var(--display-7);
    line-height: 1.15;
    color: var(--dh-forest-100);
  }

  .res__story {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-body);
    text-wrap: pretty;
  }

  .res__chg {
    margin: var(--space-3) 0 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    font-style: italic;
    color: var(--text-muted);
  }

  /* ---- the video card ----
     Structurally the SAME card as the other three, by request: identical
     figure box, title, body and footnote, in the same order at the same sizes.
     Only two things differ — the photograph behind it and the play button. The
     bespoke overlay this used to draw (reversed-out figures, a runtime chip, a
     64px button, a quote block pinned to the foot) is gone entirely. */

  .res--vid {
    position: relative;
    overflow: hidden;
    background: var(--dh-forest-100);
  }

  .res--vid :global(.res__img) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
    display: block;
  }

  /* Bottom only. The top wash is gone by request, and nothing up there needs
     it any more: the figure box is opaque, so it carries its own contrast. The
     ramp starts where the title does and only has to make three short lines
     legible. */
  .res__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(8, 12, 10, 0) 30%,
      rgba(8, 12, 10, 0.42) 52%,
      rgba(8, 12, 10, 0.85) 78%,
      rgba(8, 12, 10, 0.94) 100%
    );
  }

  /* The card's own children are in flow; only the photograph and the scrim are
     not. This lifts them clear of both. */
  .res--vid .res__fig,
  .res--vid .res__title,
  .res--vid .res__story,
  .res--vid .res__chg {
    position: relative;
    z-index: 2;
  }

  /* Translucent, so the photograph reads through the box.
     A BACKGROUND alpha rather than `opacity`: `opacity` would fade the figures
     inside it as well, and the recovered figure is the one thing on this card
     that has to stay legible over a photograph. The border softens to match —
     left at full strength it draws a hard cream rectangle on the image. */
  .res--vid .res__fig {
    background: rgba(251, 248, 241, 0.6);
    border-color: var(--dh-line-soft);
  }

  /* Everything inside the box goes forest, where the figure cards use the faint
     `--dh-ink-5` and `--dh-line-soft`. Those are tuned for an opaque cream
     panel; over a photograph at 0.6 they wash out. Forest is the darkest ink on
     this page and the colour the recovered figure already used, so the box
     resolves to one ink rather than three weights of it. */
  .res--vid .res__lbl,
  .res--vid .res__off {
    color: var(--dh-forest-100);
  }

  .res--vid .res__figrow--rec {
    border-top-color: var(--dh-line-soft);
  }

  /* The three text rules are the light-on-photo counterparts of the same rules
     above — same sizes and spacing, inverted colour. */
  .res--vid .res__title {
    color: var(--text-on-dark);
  }

  .res--vid .res__story {
    color: rgba(246, 242, 232, 0.88);
  }

  /* The client's name, which is what this slot holds on the video card where
     the others hold a "what changed" line — so it gets a name's treatment: a
     little more weight, and a short rule trailing it. Flex rather than an
     inline ::after, so the rule sits on the name's optical centre instead of
     its baseline. */
  .res--vid .res__chg {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 600;
    color: rgba(246, 242, 232, 0.66);
    /* Clears the play button, so a long client name wraps above it rather than
       running underneath. The one concession to the overlay. */
    padding-right: 60px;
  }

  /* Leading the name, like `.eyebrow`'s own rule and shorter than it — this is
     a byline, not a section opener. `currentColor`, so it tracks the name if
     that colour is ever retuned; one fewer alpha to keep in sync. */
  .res--vid .res__chg::before {
    content: "";
    flex: none;
    width: 20px;
    height: 1px;
    background: currentColor;
  }

  /* PlayButton rather than a bespoke circle, so the ring pulses on hover — and
     the card is an <a>, which is exactly what the global `.play` rule gates the
     pulse on, so hovering anywhere on the card runs it. 44px, down from the 64
     the overlay used. */
  .res--vid :global(.res__play) {
    position: absolute;
    right: var(--space-7);
    bottom: var(--space-8);
    z-index: 3;
    --glyph: var(--dh-forest-100);
    background: var(--dh-white);
  }

  /* ---- foot ---- */

  .stories__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-7);
    margin-top: var(--space-7);
  }

  .stories__disc {
    margin: 0;
    max-width: 62ch;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-meta);
  }

  .stories__nav {
    display: flex;
    gap: var(--space-3);
    flex: none;
  }

  /* Beats the rule above, as `.rail-dots[hidden]` does: an author `display`
     otherwise outranks the UA's `[hidden] { display: none }`. */
  .stories__nav[hidden] {
    display: none;
  }

  .stories__arrow {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-3);
    border: 1px solid rgba(44, 59, 49, 0.3);
    background: transparent;
    color: var(--dh-forest-100);
    font-size: var(--text-2xl);
    line-height: 1;
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition),
      color var(--transition);
  }

  /* `:not(:disabled)`, because the wrapper only goes when the WHOLE rail is
     unscrollable. Below 1080px it does scroll, and there an end-stop arrow is
     disabled while the other still works — it should not light up on hover. */
  .stories__arrow:hover:not(:disabled) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--dh-white);
  }

  .stories__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Two across, and a calc for the same reason: 48% left the second card short
     of the edge the arrows sit on. */
  @media (max-width: 1080px) {
    .res {
      flex-basis: calc((100% - var(--space-6)) / 2);
    }
  }

  /* One card with the next one peeking — the peek is the affordance at this
     width, so the slide is deliberately NOT flush here. The foot has gone to a
     column by now and the arrows are left-aligned, so there is no right edge to
     line up with anyway. */
  @media (max-width: 760px) {
    .res {
      flex-basis: 86%;
    }

    .stories__foot {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }
  }
</style>

<script>
  import "../../../scripts/rail";
</script>
