---
// "Recognized & awarded" — the trust row, as the second design draws it.
//
// NOT the shared `AwardsBar`. That band is a plain row of six badges on four
// other pages and this one is a different object: each badge is a LINK to the
// awarding body, each carries a caption, and the row closes on a disclaimer
// that the organizations are not certifying authorities. The badge IMAGES are
// still `awards.ts`'s, so the artwork and its alt text stay in one place.
//
// The disclaimer is not decoration. Colorado's Rule 7.1 commentary treats
// unqualified accolade claims as potentially misleading, and every one of these
// six is a paid or self-nominated listing.
import Picture from "../../media/Picture.astro";
import type { Award } from "../../../data/awards";
import type { CredentialsSection } from "../../../data/carAccidents";

interface Props {
  credentials: CredentialsSection;
  /** Resolved by the page from each badge's `awardKey`. */
  awards: Record<string, Award>;
}

const { credentials, awards } = Astro.props;
---

<section class="creds">
  <div class="creds__in">
    <p class="creds__eyebrow">{credentials.eyebrow}</p>

    <ul class="creds__row">
      {
        credentials.badges.map((badge) => {
          const award = awards[badge.awardKey];
          return (
            <li>
              <a class="badge" href={badge.href} target="_blank" rel="noopener">
                <Picture
                  src={award.image}
                  alt={award.alt}
                  widths={[120, 240]}
                  sizes="120px"
                  class="badge__img"
                />
                <span class="badge__cap">{badge.caption}</span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="creds__disc">{credentials.disclaimer}</p>
  </div>
</section>

<style>
  .creds {
    background: var(--dh-white);
  }

  .creds__in {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-7);
    max-width: 1180px;
    margin-inline: auto;
    padding: var(--space-16) var(--container-pad);
  }

  .creds__eyebrow {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-forest-100);
  }

  .creds__row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-7);
    align-items: end;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .badge :global(.badge__img) {
    height: 60px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }

  .badge__cap {
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-meta);
    text-align: center;
  }

  .badge:hover .badge__cap {
    color: var(--dh-forest-100);
  }

  .creds__disc {
    margin: 0;
    max-width: 66ch;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-meta);
    text-align: center;
  }

  /* Three-up, then two-up. Never one: a single 60px badge on its own line reads
     as an error rather than as a row. */
  @media (max-width: 1080px) {
    .creds__row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-8) var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .creds__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
