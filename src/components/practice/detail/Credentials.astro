---
// "Recognized & awarded" — the trust row, as the second design draws it.
//
// The comp draws each badge as a LINK to the awarding body with a caption
// under it. Both are gone at Rhan's request: the row is six pieces of artwork
// and the disclaimer, and what the captions said is now carried by the alt text
// `awards.ts` already had — which is more precise than the caption was for
// three of the six. So no information was dropped, only its duplicate.
//
// What still separates this from the shared `AwardsBar` is the eyebrow, the
// disclaimer and the white band. If a later practice area wants this row
// without those, reach for `AwardsBar` rather than copying this.
//
// A GRID ABOVE 760px, A TWO-UP CAROUSEL BELOW IT, which is what every other
// awards row on the site does — dots, no arrows, `data-rail-step="2"` so a
// press lands on a pair. Modelled on `AwardsBar`, deliberately: the attorney
// bio's carousel is the same construction and does not scroll (see HANDOFF),
// so the working one is the one to copy from.
//
// The disclaimer is not decoration. Colorado's Rule 7.1 commentary treats
// unqualified accolade claims as potentially misleading, and every one of these
// six is a paid or self-nominated listing.
import Picture from "../../media/Picture.astro";
import type { Award } from "../../../data/awards";
import type { CredentialsSection } from "../../../data/carAccidents";

interface Props {
  credentials: CredentialsSection;
  /** Resolved by the page from each badge's `awardKey`. */
  awards: Record<string, Award>;
}

const { credentials, awards } = Astro.props;
---

<section class="creds">
  <div class="creds__in">
    <p class="creds__eyebrow">{credentials.eyebrow}</p>

    {
      /* `role="group"` + tabindex so the rail is reachable and announced by a
         keyboard user, who has no swipe. The dots are the pointer affordance;
         this is the other half. Kept in the DOM at every width rather than
         rendered conditionally — the breakpoint is a CSS fact, and the server
         has no idea how wide the viewport is. */
    }
    <div
      class="creds__rail noscroll"
      data-rail="ca-awards"
      data-rail-step="2"
      tabindex="0"
      role="group"
      aria-label="Awards and recognition, scrollable"
    >
      <ul class="creds__row">
        {
          credentials.badges.map((badge) => {
            const award = awards[badge.awardKey];
            return (
              <li class="badge">
                <Picture
                  src={award.image}
                  alt={award.alt}
                  widths={[120, 240]}
                  sizes="120px"
                  class="badge__img"
                />
              </li>
            );
          })
        }
      </ul>
    </div>

    {
      /* Dots only, no arrows — the rule for every awards carousel on the site.
         Filled by scripts/rail.ts, and hidden by it when there is one page. */
    }
    <div class="rail-dots" data-rail-dots="ca-awards"></div>

    <p class="creds__disc">{credentials.disclaimer}</p>
  </div>
</section>

<style>
  .creds {
    background: var(--dh-white);
  }

  /* Margins on the children rather than one flex `gap`: the three distances
     here are set independently — a wide one under the eyebrow, a wider one
     above the disclaimer — and a single gap cannot say that. The foot padding
     is deliberately short of the head's, which is what puts the disclaimer
     near the section's bottom edge. */
  .creds__in {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 1180px;
    margin-inline: auto;
    padding: var(--space-16) var(--container-pad) var(--space-8);
  }

  .creds__eyebrow {
    margin: 0 0 var(--space-12);
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: var(--text-md);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-forest-100);
  }

  /* `stretch`, not `width: 100%`: `.creds__in` is a centred flex column, so an
     un-stretched child shrink-wraps to its content. Same reason `AwardsBar`
     does it. */
  .creds__rail {
    align-self: stretch;
  }

  .creds__row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-7);
    align-items: end;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .badge {
    display: flex;
    justify-content: center;
  }

  .badge :global(.badge__img) {
    height: 60px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }

  /* No `max-width`: the sentence is ~94 characters, which sits on one line in
     anything close to the 1084px measure here. Not `white-space: nowrap` —
     that would hold the line on a phone too and push the page sideways. */
  .creds__disc {
    margin: var(--space-14) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-meta);
    text-align: center;
  }

  /* Three-up between here and the carousel breakpoint. Never one: a single
     60px badge on its own line reads as an error rather than as a row. */
  @media (max-width: 1080px) {
    .creds__row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-8) var(--space-6);
    }
  }

  /* Two badges at a time, centred, inside the text column — not a rail that
     bleeds past the edges with the neighbours half-showing. Each item is half a
     slide, so the snap position is exact and a badge is on screen whole or not
     at all. The grid above goes inert here; `display: flex` wins on order. */
  @media (max-width: 760px) {
    /* Capped and centred rather than filling the column: a slide is half the
       rail, and an uncapped rail at 760px puts the two badges far enough apart
       that they stop reading as a pair. Below ~470px the cap is moot. */
    .creds__rail {
      max-width: 420px;
      margin-inline: auto;
      overflow-x: auto;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }

    /* `flex-start` is load-bearing, not tidiness: a centred nowrap flex line
       splits its overflow evenly to BOTH sides, putting the first slides at a
       negative offset that scrollLeft cannot reach — they would never be
       shown. And no `width: max-content`, because the slides take their 50%
       from this element; the overflow comes from six of them, not from an
       oversized track. */
    .creds__row {
      display: flex;
      flex-wrap: nowrap;
      justify-content: flex-start;
      align-items: center;
      gap: 0;
    }

    .badge {
      flex: 0 0 50%;
      align-items: center;
      padding-inline: var(--space-3);
    }

    /* Snap on the ODD items, so a swipe lands on a pair rather than sliding one
       badge along and leaving another half-showing. The dots agree because the
       rail declares `data-rail-step="2"`. */
    .badge:nth-child(odd) {
      scroll-snap-align: start;
    }

    /* `max-height` rather than a fixed height, so a wide wordmark scales down
       to fit its half instead of overflowing it. */
    .creds__row :global(.badge__img) {
      height: auto;
      max-height: 60px;
    }
  }
</style>

<script>
  // Paging behaviour is shared with the other awards carousels.
  import "../../../scripts/rail";
</script>
