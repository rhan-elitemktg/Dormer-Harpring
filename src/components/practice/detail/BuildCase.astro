---
// "What we actually do with your case" — four things the firm does, beside a
// sticky list of the evidence it collects.
//
// The evidence card is sticky on desktop deliberately: the four items beside it
// are long, and the list is the concrete answer to "what does hiring you get
// me?" — it should stay on screen while the abstract half scrolls.
import Eyebrow from "../../Eyebrow.astro";
import type { BuildSection } from "../../../data/carAccidents";

interface Props {
  build: BuildSection;
}

const { build } = Astro.props;
---

<section class="section section--alt build">
  <div class="container build__grid">
    <div>
      <Eyebrow class="build__eyebrow">{build.eyebrow}</Eyebrow>
      <h2 class="build__title">{build.title}</h2>

      <ul class="buildgrid">
        {
          build.items.map((item) => (
            <li>
              <h3 class="buildgrid__title">{item.title}</h3>
              {item.body.map((paragraph) => (
                <p class="buildgrid__body">{paragraph}</p>
              ))}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="evid">
      <h3 class="evid__title">{build.evidence.title}</h3>
      <ul class="evid__list">
        {build.evidence.items.map((item) => <li>{item}</li>)}
      </ul>
      <p class="evid__note">{build.evidence.note}</p>
    </div>
  </div>
</section>

<style>
  .build__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 480px;
    gap: var(--space-18);
    align-items: start;
  }

  .build :global(.build__eyebrow) {
    margin-bottom: var(--space-4);
  }

  .build__title {
    margin: 0 0 var(--space-9);
    font-size: var(--display-3);
  }

  .buildgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-11);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .buildgrid__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--display-7);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .buildgrid__body {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .evid {
    position: sticky;
    top: 98px;
    padding: var(--space-9);
    background: var(--dh-white);
    border: 1px solid var(--border-hairline);
    border-top: 3px solid var(--accent-gold);
    border-radius: var(--radius-4);
  }

  /* 98px, not the comp's 32: this page has a 66px sticky section nav, and a
     card that stops 32px from the top slides under it. */

  .evid__title {
    margin: 0 0 var(--space-5);
    font-family: var(--font-body);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-gold-deep);
  }

  .evid__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evid__list li {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--dh-line-soft);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-strong);
  }

  .evid__list li:last-child {
    border-bottom: 0;
  }

  .evid__list li::before {
    content: "";
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 10px;
    border-radius: var(--radius-full);
    background: var(--accent-gold);
  }

  .evid__note {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--dh-line-soft);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  @media (max-width: 1180px) {
    .build__grid {
      grid-template-columns: minmax(0, 1fr) 400px;
      gap: var(--space-12);
    }
  }

  @media (max-width: 980px) {
    .build__grid {
      grid-template-columns: 1fr;
      gap: var(--space-9);
    }

    .buildgrid {
      grid-template-columns: 1fr;
    }

    .evid {
      position: static;
    }
  }
</style>
