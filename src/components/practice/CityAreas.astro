---
// "More Denver practice areas" — every OTHER practice area in this page's city,
// grouped by topic.
//
// This is what stands where the blog post's "Related blog posts" band stands.
// The two answer different questions on purpose: a reader on a motorcycle page
// wants the firm's other Denver work, not its recent writing — the writing is
// in the sidebar.
//
// GENERATED, NOT PORTED. The live site ships a hand-maintained version of this
// band and it is wrong in four ways: it links to the page you are on, it is
// alphabetised incorrectly in two places, it omits a dozen live Denver pages,
// and on six of eight Greeley / Fort Collins / Grand Junction pages it lists a
// DIFFERENT city's practice areas. `getCityAreaGroups()` derives it instead.
//
// SURFACE: `--alt`, and it is load-bearing. The page runs `.parea` (cream
// `--surface-page`) → this → `ContactDetails` (cream). Cream here would put
// three identical surfaces in a row, which nothing in the build checks for.
// `--forest` was the other candidate — it is what `RelatedPosts` uses in this
// slot on the post page — but it would mean re-colouring the whole chevroned
// link treatment for dark, and it makes a LIGHT template's foot heavier than
// its body. Reordering ContactDetails above the band was rejected outright:
// `#contact` is what every `.btn` on the page targets.
import AreaLinkList from "./AreaLinkList.astro";
import Eyebrow from "../Eyebrow.astro";
import type { AreaGroup } from "../../data/practiceAreas";

interface Props {
  eyebrow: string;
  title: string;
  groups: AreaGroup[];
}

const { eyebrow, title, groups } = Astro.props;

/* A city with one topic gets no group headings. Grand Junction has three
   siblings, all motor-vehicle: a lone "Motor Vehicle Accidents" rule over the
   whole band labels nothing, because there is nothing for it to be distinct
   from. Denver's five groups need theirs. */
const showGroupTitles = groups.length > 1;
---

{
  groups.length > 0 && (
    <section class="cityareas section section--alt" aria-labelledby="cityareas-title">
      <div class="container">
        <header class="cityareas__head">
          <Eyebrow class="cityareas__eyebrow">{eyebrow}</Eyebrow>
          <h2 class="cityareas__title" id="cityareas-title">
            {title}
          </h2>
        </header>

        {groups.map((group) => (
          <div class="cityareas__group">
            {showGroupTitles && <h3 class="cityareas__group-title">{group.title}</h3>}
            <AreaLinkList items={group.items} />
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  /* Padding comes from the global `.section`; only the surface and the inner
     rhythm belong here. Declared as a CLASS rather than a hardcoded background
     so a future reorder is a class change — `.dir` hardcodes `--surface-page`
     and would have to be edited to move. */
  .cityareas__head {
    max-width: 900px;
    margin-bottom: var(--space-11);
  }

  /* Bounded `:global()`: the class is passed to <Eyebrow> and lands on
     Eyebrow's markup, which never carries this file's cid. */
  .cityareas :global(.cityareas__eyebrow) {
    margin-bottom: var(--space-4);
  }

  /* One tier below the directory's `--display-2`. That page's band IS the page;
     this one is a foot under an article, and matching the directory would make
     it shout over the body it follows. */
  .cityareas__title {
    font-size: var(--display-3);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--dh-ink);
  }

  /* The directory's group rhythm, halved. Denver shows five groups here where
     the directory shows eight across the whole page, and the band should read
     as one block rather than as five stacked sections. */
  .cityareas__group + .cityareas__group {
    margin-top: var(--space-9);
  }

  .cityareas__group-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-6);
    line-height: 1.1;
    color: var(--dh-ink);
    margin-bottom: var(--space-5);
  }
</style>
