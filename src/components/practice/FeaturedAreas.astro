---
// "Our core practice areas." — nine photographed panels, each with the area's
// line icon punched over the bottom edge of its photograph.
//
// Takes the same `PracticeAreaSummary` the homepage selector does, so the two
// stay one content shape; only the presentation differs.
import SectionHead from "../SectionHead.astro";
import Picture from "../media/Picture.astro";
import PracticeIcon from "../icons/PracticeIcon.astro";
import type { PracticeAreaSummary, PracticeAreasPage } from "../../data/practiceAreas";

interface Props {
  section: PracticeAreasPage["featured"];
  areas: PracticeAreaSummary[];
  /** The "Learn more" affordance on every card — one string, not nine copies. */
  moreLabel?: string;
}

const { section, areas, moreLabel = "Learn more" } = Astro.props;
---

{/* No bottom padding: the directory below is the same cream and opens with its
    own full section padding, so the two read as one band rather than as two
    with a double gap between them. The comp does the same. */}
<section class="feat">
  <div class="container">
    <SectionHead
      eyebrow={section.eyebrow}
      title={section.title}
      lede={section.lede}
      size={2}
      center
      class="feat__head"
    />

    <ul class="feat__grid">
      {
        areas.map((area) => (
          <li>
            <a class="feat__card" href={area.href}>
              {area.image && (
                <Picture
                  src={area.image}
                  alt=""
                  widths={[400, 600, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1180px) 50vw, 33vw"
                  class="feat__photo"
                />
              )}
              <div class="feat__body">
                <span class="feat__icon" aria-hidden="true">
                  <PracticeIcon name={area.iconKey} size={26} />
                </span>
                <h3 class="feat__title">{area.name}</h3>
                <p class="feat__desc">{area.blurb}</p>
                <span class="feat__more">
                  {moreLabel} <span aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .feat {
    background: var(--surface-page);
    padding-block: var(--space-section) 0;
  }

  /* `:global()` bounded by this component's own `.feat`, because the class is
     handed to <SectionHead> and lands on markup carrying SectionHead's cid. */
  .feat :global(.feat__head) {
    max-width: 820px;
    margin: 0 auto var(--space-13);
  }

  .feat__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7);
    list-style: none;
    padding: 0;
  }

  /* The card is the flex column, and `height: 100%` on it makes every card in a
     row match the tallest — which is what lets `.feat__desc` push the "Learn
     more" line to a common baseline. */
  .feat__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--dh-white);
    border: 1px solid var(--dh-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .feat__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  @media (prefers-reduced-motion: reduce) {
    .feat__card:hover {
      transform: none;
    }
  }

  /* Bounded `:global()`: the class goes to <Picture>, whose markup carries its
     own cid rather than this file's. */
  .feat :global(.feat__photo) {
    width: 100%;
    height: 230px;
    object-fit: cover;
    display: block;
  }

  .feat__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-7) var(--space-7) var(--space-8);
  }

  /* The negative top margin is load-bearing: it lifts the plate to straddle the
     photograph's bottom edge. It equals the plate's own height, so the body's
     padding still measures from the photo edge and the text below is unmoved. */
  .feat__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    flex: none;
    width: 52px;
    height: 52px;
    margin: -52px 0 var(--space-5);
    /* Translucent gold written out, as in CoreValues' badge: the tokens carry
       gold's opaque values, and an alpha of it is not one of them. */
    border: 1px solid rgba(199, 154, 84, 0.42);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    color: var(--accent-gold);
  }

  /* The comp sets 23px here, between --display-6's 25 and --display-7's 20.
     Snapped to --display-6, the token six other card h3s already use, rather
     than earning an eighth display tier for a 2px difference. */
  .feat__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-6);
    line-height: 1.15;
    color: var(--dh-ink);
    margin-bottom: var(--space-3);
  }

  .feat__desc {
    flex: 1;
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .feat__more {
    font-weight: 800;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  @media (max-width: 1180px) {
    .feat__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .feat__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
