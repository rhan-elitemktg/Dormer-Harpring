---
// "We do it for these moments." — a horizontally scrolling rail alternating
// client videos and written reviews.
//
// Not home-only: the attorney bio comp carries the same band verbatim, which
// is why this sits at the components root rather than under home/.
import Eyebrow from "./Eyebrow.astro";
import ReviewRating from "./ReviewRating.astro";
import RailVideoCard from "./testimonials/RailVideoCard.astro";
import RailQuoteCard from "./testimonials/RailQuoteCard.astro";
import type { Testimonial, ReviewSummary } from "../data/testimonials";
import { ROUTES } from "../lib/routePaths";

interface Props {
  testimonials: Testimonial[];
  reviews: ReviewSummary;
}

const { testimonials, reviews } = Astro.props;
---

<section class="section section--forest-flat tmv">
  <div class="container">
    <header class="tmv__head">
      <div>
        <Eyebrow tone="on-dark" class="tmv__eyebrow">Testimonials</Eyebrow>
        <h2 class="tmv__title">We do it for these moments.</h2>
      </div>

      <ReviewRating reviews={reviews} />
    </header>

    {
      /* tabindex makes the rail focusable, so a keyboard user can scroll it with
         the arrow keys — without it the only way through is tabbing card by
         card. aria-label explains what the focus stop is. */
    }
    <div
      class="tmv__rail noscroll"
      data-rail="testimonials"
      tabindex="0"
      role="group"
      aria-label="Client testimonials, scrollable"
    >
      <div class="tmv__track">
        {
          testimonials.map((testimonial) =>
            testimonial.kind === "video" ? (
              <RailVideoCard testimonial={testimonial} />
            ) : (
              <RailQuoteCard testimonial={testimonial} />
            )
          )
        }
      </div>
    </div>

    <div class="tmv__foot">
      <a class="btn btn--ghost arrow-link" href={ROUTES.testimonials}>
        Read all reviews <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
      <div class="tmv__nav">
        <button
          type="button"
          class="tmv__arrow"
          data-rail-prev="testimonials"
          aria-label="Previous testimonials"
        >
          <span aria-hidden="true">&larr;</span>
        </button>
        <button
          type="button"
          class="tmv__arrow"
          data-rail-next="testimonials"
          aria-label="Next testimonials"
        >
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .tmv {
    position: relative;
    overflow: hidden;
  }

  .tmv__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .tmv :global(.tmv__eyebrow) {
    margin-bottom: var(--space-4);
  }

  .tmv__title {
    font-size: var(--display-1);
  }

  /* The rating card's styling moved to ReviewRating.astro with the markup. */

  /* Negative margin plus matching padding lets the rail bleed to the viewport
     edge while its first card still lines up with the container. */
  .tmv__rail {
    overflow-x: auto;
    margin-inline: calc(var(--container-pad) * -1);
    padding: 0 var(--container-pad) var(--space-2);
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-pad);
    overscroll-behavior-x: contain;
  }

  .tmv__track {
    display: flex;
    align-items: stretch;
    gap: var(--space-6);
    width: max-content;
  }

  .tmv__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-10);
  }

  .tmv__nav {
    display: flex;
    gap: var(--space-3);
  }

  .tmv__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 47px;
    height: 47px;
    padding: 0;
    border: 1px solid rgba(244, 239, 231, 0.4);
    border-radius: var(--radius-2);
    background: transparent;
    font-weight: 800;
    font-size: var(--text-base);
    line-height: 1;
    color: var(--dh-parchment);
    cursor: pointer;
    transition: border-color var(--transition), background-color var(--transition);
  }

  .tmv__arrow:hover:not(:disabled) {
    border-color: var(--dh-gold-light);
    color: var(--dh-gold-light);
  }

  .tmv__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  @media (max-width: 760px) {
    /* Arrows stay on touch, rather than swapping to dots: there are nine cards,
       so a dot per card would be nine 8px targets in a row — unreadable as
       position and unhittable as controls. The arrows also already report the
       ends by disabling, which dots cannot do. */
    .tmv__foot {
      margin-top: var(--space-8);
    }

    .tmv__arrow {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 420px) {
    /* Stack rather than let the CTA and the arrows collide. */
    .tmv__foot {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
    }

    .tmv__nav {
      justify-content: flex-end;
    }
  }

</style>

<script>
  // Prev/next behaviour is shared with the attorneys rail.
  import "../scripts/rail";
</script>
