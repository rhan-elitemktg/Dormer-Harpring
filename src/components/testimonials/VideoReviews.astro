---
// "Hear it from our clients." — the six published video testimonials.
import SectionHead from "../SectionHead.astro";
import VideoReviewCard from "./VideoReviewCard.astro";
import type { TestimonialsPage, VideoReview } from "../../data/testimonials";

interface Props {
  section: TestimonialsPage["videos"];
  reviews: VideoReview[];
}

const { section, reviews } = Astro.props;
---

<section class="vids">
  <div class="container">
    <SectionHead
      eyebrow={section.eyebrow}
      title={section.title}
      lede={section.lede}
      size={3}
      center
      class="vids__head"
    />

    <ul class="vids__grid">
      {
        reviews.map((review) => (
          <li>
            <VideoReviewCard review={review} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .vids {
    padding-block: var(--space-section);
    background: var(--surface-sunk);
  }

  .vids :global(.vids__head) {
    max-width: 820px;
    margin-inline: auto;
    margin-bottom: var(--space-13);
  }

  .vids__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7);
    list-style: none;
    padding: 0;
  }

  @media (max-width: 1080px) {
    .vids__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .vids__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
