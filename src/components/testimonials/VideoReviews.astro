---
// "Hear it from our clients." — the six published video testimonials.
import SectionHead from "../SectionHead.astro";
import VideoReviewCard from "./VideoReviewCard.astro";
import type { TestimonialsPage, VideoReview } from "../../data/testimonials";

interface Props {
  section: TestimonialsPage["videos"];
  reviews: VideoReview[];
}

const { section, reviews } = Astro.props;
---

<section class="vids">
  <div class="container">
    <SectionHead
      eyebrow={section.eyebrow}
      title={section.title}
      lede={section.lede}
      size={3}
      center
      class="vids__head"
    />

    <ul class="vids__grid">
      {
        reviews.map((review) => (
          <li>
            <VideoReviewCard review={review} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .vids {
    padding-block: var(--space-section);
    background: var(--surface-sunk);
  }

  .vids :global(.vids__head) {
    max-width: 820px;
    margin-inline: auto;
    margin-bottom: var(--space-13);
  }

  .vids__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7);
    list-style: none;
    padding: 0;
  }

  /* THE CARD IS NO LONGER A DIRECT CHILD OF THIS <li>. VideoPopover's wrapper
     is `display: contents`, which passes layout straight through — but once
     Wistia initialises it injects a real `div.wistia_click_to_play` between the
     two, and that div is `height: auto`. `.vcard`'s `height: 100%` then
     resolves against a content-sized box instead of the grid row, so every card
     except the tallest came up short and the names stopped lining up.

     `display: grid` rather than `flex`: a lone grid item stretches on BOTH axes
     by default, so this fixes the height without also needing a width rule on a
     child whose class belongs to Wistia and must not be targeted. It holds
     before Wistia loads (the card is the item) and after (its div is), so there
     is no flash of ragged cards on the way. */
  .vids__grid > li {
    display: grid;
  }

  @media (max-width: 1080px) {
    .vids__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .vids__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
