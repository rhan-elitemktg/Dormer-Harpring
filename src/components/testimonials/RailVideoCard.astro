---
// A client video testimonial in the rail: poster, play button, runtime, name.
import Picture from "../media/Picture.astro";
import PlayButton from "../media/PlayButton.astro";
import VideoPopover from "../media/VideoPopover.astro";
import { videoWatchUrl } from "../../lib/video";
import type { VideoTestimonial } from "../../data/testimonials";

interface Props {
  testimonial: VideoTestimonial;
}

const { testimonial } = Astro.props;
// Derived, not stored: the comp keeps an `initial` field alongside the name,
// which is one more thing to get out of sync for no gain.
const initial = testimonial.name.trim().charAt(0).toUpperCase();
---

<VideoPopover video={testimonial.video}>
  <a class="vcard" href={videoWatchUrl(testimonial.video)}>
  <Picture
    src={testimonial.poster}
    remoteSize={testimonial.posterSize}
    alt={`${testimonial.name}, client testimonial video`}
    widths={[400, 800]}
  sizes="400px"
  class="vcard__poster"
  />
  <span class="vcard__scrim" aria-hidden="true"></span>
  <PlayButton tone="accent" size={60} class="vcard__play" />
  <span class="vcard__by">
    <span class="vcard__initial" aria-hidden="true">{initial}</span>
    <span class="vcard__name">{testimonial.name}</span>
    <span class="vcard__length">{testimonial.length}</span>
  </span>
  </a>
</VideoPopover>

<style>
  .vcard {
    /* Explicit, because this element used to be a <button> and is now an <a>:
       an inline box ignores width and min-height, which collapses the card and
       with it the absolutely positioned poster inside it. */
    display: block;
    position: relative;
    flex: none;
    width: 320px;
    min-height: 440px;
    /* FULL HEIGHT SO THE RAIL'S CARDS AGREE, and `min-height` alone could not
       do it. Wistia moves this <a> into a div of its own, so the flex item in
       `.tmv__track` is that div rather than this card: the div stretches to the
       tallest card in the row and this stayed at 440, leaving a video card
       visibly short beside a long quote. The div's height is definite because
       stretching resolved it, so this percentage resolves against it.

       Harmless before Wistia initialises, when this IS the flex item and
       `align-items: stretch` has already done the same job. */
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--dh-forest-500);
    cursor: pointer;
    scroll-snap-align: start;
  }

  .vcard :global(.vcard__poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vcard__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 27, 22, 0) 44%, rgba(20, 27, 22, 0.82) 100%);
  }

  .vcard :global(.vcard__play) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: transform var(--transition);
  }

  .vcard:hover :global(.vcard__play) {
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* Sits in the name row rather than floating over the poster, so its baseline
     lines up with the client's name instead of being positioned by eye.
     `margin-left: auto` pushes it to the row's right edge. */
  .vcard__length {
    margin-left: auto;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-3);
    background: rgba(0, 0, 0, 0.5);
    font-weight: 700;
    font-size: var(--text-label);
    line-height: 1;
    color: var(--dh-parchment);
    flex: none;
  }

  .vcard__by {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .vcard__initial {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--dh-forest-100);
    font-weight: 800;
    font-size: var(--text-base);
    line-height: 1;
    color: var(--dh-parchment);
    flex: none;
  }

  .vcard__name {
    font-weight: 700;
    font-size: var(--text-base);
    line-height: 1;
    color: var(--dh-white);
  }

  @media (max-width: 640px) {
    .vcard {
      width: 280px;
      min-height: 400px;
    }
  }
</style>
