---
// "What clients say about working with us." — the Google reviews.
import SectionHead from "../SectionHead.astro";
import ReviewCard from "./ReviewCard.astro";
import type { TestimonialsPage, WrittenReview } from "../../data/testimonials";

interface Props {
  section: TestimonialsPage["written"];
  reviews: WrittenReview[];
}

const { section, reviews } = Astro.props;

/** How many are visible before "Load more". Read by the script below. */
const INITIAL = 6;
---

<section class="reviews">
  <div class="container">
    <SectionHead
      eyebrow={section.eyebrow}
      title={section.title}
      lede={section.lede}
      size={3}
      center
      class="reviews__head"
    />

    {
      /* CSS multi-column, not three hand-balanced arrays. The comp ships the
         reviews pre-split into literal columns, which bakes a layout decision
         into the content: it breaks the moment the column count changes at a
         breakpoint, or an editor adds a twelfth review. Here the data is one
         ordered list and the browser balances it — and `break-inside: avoid`
         is what keeps a card from being sliced across a column boundary. */
    }
    <ul class="reviews__grid" data-reviews data-initial={INITIAL}>
      {
        reviews.map((review, i) => (
          <li class="reviews__item" data-index={i}>
            <ReviewCard review={review} />
          </li>
        ))
      }
    </ul>

    {
      /* Starts hidden and is revealed by the script. Without JS every review is
         already on the page, so a button that could not do anything never
         appears — the comp's version is inert in every state. */
    }
    <div class="reviews__foot">
      <button type="button" class="btn reviews__more" data-reviews-more hidden>
        {section.moreLabel}
      </button>
    </div>
  </div>
</section>

<style>
  .reviews {
    padding-block: var(--space-section);
    background: var(--surface-page);
    border-top: 1px solid var(--dh-line-soft);
  }

  .reviews :global(.reviews__head) {
    max-width: 820px;
    margin-inline: auto;
    margin-bottom: var(--space-13);
  }

  .reviews__grid {
    column-count: 3;
    column-gap: var(--space-7);
    list-style: none;
    padding: 0;
  }

  .reviews__item {
    break-inside: avoid;
    /* The gap between stacked cards is this margin, not a `gap` — multicol has
       no row gap. */
    margin-bottom: var(--space-7);
  }

  .reviews__item[hidden] {
    display: none;
  }

  .reviews__foot {
    display: flex;
    justify-content: center;
    margin-top: var(--space-13);
  }

  /* The comps' soft tan outline, not `--outline-ink`: on a page of white cards
     a 1.5px forest rule reads as another card edge. */
  .reviews__more {
    width: 300px;
    max-width: 100%;
    min-height: 60px;
    border: 1px solid #c6b896;
    border-radius: var(--radius-3);
    background: transparent;
    letter-spacing: 0.1em;
    color: var(--dh-forest-100);
  }

  .reviews__more:hover {
    border-color: var(--dh-forest-100);
    background: var(--dh-forest-100);
    color: var(--dh-parchment);
  }

  @media (max-width: 1180px) {
    .reviews__grid {
      column-count: 2;
    }
  }

  @media (max-width: 760px) {
    .reviews__grid {
      column-count: 1;
    }
  }
</style>

<script>
  // Progressive disclosure, wired only when there is genuinely more to show.
  // Everything is server-rendered — this hides the tail, rather than fetching
  // one — so the reviews are all in the HTML for a crawler and for a visitor
  // with no JS.
  for (const grid of document.querySelectorAll<HTMLElement>("[data-reviews]")) {
    const items = [...grid.querySelectorAll<HTMLElement>(".reviews__item")];
    const initial = Number(grid.dataset.initial) || items.length;
    const button = document.querySelector<HTMLButtonElement>("[data-reviews-more]");
    if (!button || items.length <= initial) continue;

    for (const item of items.slice(initial)) item.hidden = true;
    button.hidden = false;

    button.addEventListener("click", () => {
      const revealed = items.filter((item) => item.hidden);
      for (const item of revealed) item.hidden = false;
      button.hidden = true;

      // Send the caret to the first card that just appeared. Without this,
      // pressing the button removes the focused element from the page and
      // focus falls back to <body> — a keyboard user is dumped at the top.
      const first = revealed[0];
      if (!first) return;
      first.tabIndex = -1;
      first.focus({ preventScroll: true });
    });
  }
</script>
