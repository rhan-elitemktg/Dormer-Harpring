---
// One attorney: portrait, name, role.
//
// Two layouts, because two comps draw the same card at different widths — the
// homepage rail fixes it at 272px, the About grid lets the track set it. That
// and the matching `sizes` is the whole difference, so it is a prop rather than
// a second component with a hundred duplicated lines of CSS. The About comp
// also moves the play glyph to the bottom-left corner; not adopted, so the
// glyph is centred on every attorney card the site draws.
//
// TWO CONTROLS, NOT ONE, by request: the PORTRAIT opens the attorney's film in
// a popover, the NAME AND ROLE go to their bio. The card used to be a single
// <a> wrapping all three, which is why the play glyph sat there promising a
// video it could not play — an <a> may not contain another <a>, so the glyph
// had nowhere to become a trigger. Splitting the card is what makes it
// possible; the wrapper is a <div> now and the two links are siblings.
//
// The hover that reddens the name is bound to the NAME'S link, not the card:
// they are separate controls now, and lighting up the name when the pointer is
// over the portrait would say they are one.
import Picture from "../../media/Picture.astro";
import PlayButton from "../../media/PlayButton.astro";
import VideoPopover from "../../media/VideoPopover.astro";
import { videoWatchUrl } from "../../../lib/video";
import type { AttorneyCardData } from "../../../data/attorneys";

interface Props {
  attorney: AttorneyCardData;
  layout?: "rail" | "grid";
}

const { attorney, layout = "rail" } = Astro.props;

// The rail's card is 272px at every width; the grid's is a quarter of the
// container on desktop and the full width of a phone.
const sizes =
  layout === "rail"
    ? "272px"
    : "(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 25vw";
---

<div class:list={["acard", `acard--${layout}`]}>
  <VideoPopover video={attorney.video}>
    <a
      class="acard__media"
      href={videoWatchUrl(attorney.video)}
      aria-label={`Watch ${attorney.name}'s video`}
    >
      <Picture
        src={attorney.portrait}
        alt={attorney.name}
        widths={[272, 544, 700]}
        sizes={sizes}
        class="acard__portrait"
      />
      <span class="acard__scrim" aria-hidden="true"></span>
      <PlayButton tone="light" size={46} class="acard__play" />
    </a>
  </VideoPopover>

  <a class="acard__link" href={attorney.href}>
    <span class="acard__name">{attorney.name}</span>
    <span class="acard__role">{attorney.role} &middot; {attorney.location}</span>
  </a>
</div>

<style>
  .acard {
    display: flex;
    flex-direction: column;
  }

  .acard--rail {
    flex: 0 0 272px;
    scroll-snap-align: start;
  }

  .acard__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border: 1px solid #d2c7af;
    border-radius: var(--radius-5);
    overflow: hidden;
    /* The comp's hatched placeholder, kept as the backdrop behind a portrait
       that has not loaded rather than as a state of its own. */
    background: repeating-linear-gradient(
      45deg,
      #e0d8c6,
      #e0d8c6 9px,
      #dad1bd 9px,
      #dad1bd 18px
    );
  }

  .acard :global(.acard__portrait) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .acard__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(31, 40, 34, 0) 55%, rgba(31, 40, 34, 0.45) 100%);
  }

  /* No hover scale. The glyph is a CSS border triangle, so scaling puts its
     edges on fractional pixels and it visibly shifts inside the ring — and a
     `transform: scale()` on hover would replace this centring translate
     outright, throwing the button into the corner. The pulse is the hover
     feedback; it doesn't need a second one. */
  /* Centred in BOTH layouts. The About comp tucks it into the bottom-left
     corner; overridden by request, so the glyph sits in the same place on
     every attorney card the site draws. */
  .acard :global(.acard__play) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .acard__name {
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-3xl);
    line-height: 1.2;
    color: var(--dh-forest-100);
    transition: color var(--transition);
  }

  .acard__role {
    margin-top: var(--space-1);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: #8a806e;
  }

  /* The name's own link, so the two stack the way they did inside the single
     <a> this card used to be. */
  .acard__link {
    display: flex;
    flex-direction: column;
  }

  /* Bound to the NAME'S link, not the card — the portrait beside it is a
     separate control now, and reddening the name on its hover would say the
     two are one. */
  .acard__link:hover .acard__name,
  .acard__link:focus-visible .acard__name {
    color: var(--dh-red-verdict);
  }

  @media (max-width: 640px) {
    .acard--rail {
      flex-basis: 232px;
    }
  }
</style>
