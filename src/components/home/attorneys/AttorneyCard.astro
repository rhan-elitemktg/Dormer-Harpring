---
// One attorney in the homepage rail: portrait, name, role.
import Picture from "../../media/Picture.astro";
import PlayButton from "../../media/PlayButton.astro";
import type { AttorneyCardData } from "../../../data/attorneys";

interface Props {
  attorney: AttorneyCardData;
}

const { attorney } = Astro.props;
---

<a class="acard" href={attorney.href}>
  <span class="acard__media">
    <Picture
      src={attorney.portrait}
      alt={attorney.name}
      widths={[272, 544]}
      sizes="272px"
      class="acard__portrait"
    />
    <span class="acard__scrim" aria-hidden="true"></span>
    {
      /* TODO(video): the comp intends an attorney video intro here. Until one
         exists the whole card navigates to the bio, so this is a visual cue
         rather than a control — it is not a <button> and takes no click. */
    }
    <PlayButton tone="light" size={46} class="acard__play" />
  </span>
  <span class="acard__name">{attorney.name}</span>
  <span class="acard__role">{attorney.role} &middot; {attorney.location}</span>
</a>

<style>
  .acard {
    display: flex;
    flex-direction: column;
    flex: 0 0 272px;
    scroll-snap-align: start;
  }

  .acard__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border: 1px solid #d2c7af;
    border-radius: var(--radius-5);
    overflow: hidden;
    /* The comp's hatched placeholder, kept as the backdrop behind a portrait
       that has not loaded rather than as a state of its own. */
    background: repeating-linear-gradient(
      45deg,
      #e0d8c6,
      #e0d8c6 9px,
      #dad1bd 9px,
      #dad1bd 18px
    );
  }

  .acard :global(.acard__portrait) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .acard__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(31, 40, 34, 0) 55%, rgba(31, 40, 34, 0.45) 100%);
  }

  /* No hover scale. The glyph is a CSS border triangle, so scaling puts its
     edges on fractional pixels and it visibly shifts inside the ring — and a
     `transform: scale()` on hover would replace this centring translate
     outright, throwing the button into the corner. The pulse is the hover
     feedback; it doesn't need a second one. */
  .acard :global(.acard__play) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .acard__name {
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-3xl);
    line-height: 1.2;
    color: var(--dh-forest-100);
    transition: color var(--transition);
  }

  .acard__role {
    margin-top: var(--space-1);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: #8a806e;
  }

  .acard:hover .acard__name,
  .acard:focus-visible .acard__name {
    color: var(--dh-red-verdict);
  }

  @media (max-width: 640px) {
    .acard {
      flex-basis: 232px;
    }
  }
</style>
