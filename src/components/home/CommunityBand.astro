---
// "Rooted in Denver." — a photo mosaic over a 12-column grid, then the NGO
// partner logos.
import Eyebrow from "../Eyebrow.astro";
import Picture from "../media/Picture.astro";
import type {
  CommunitySection,
  CommunityPhoto,
  NgoPartner,
} from "../../data/community";
import { ROUTES } from "../../lib/routePaths";

interface Props {
  section: CommunitySection;
  photos: CommunityPhoto[];
  partners: NgoPartner[];
}

const { section, photos, partners } = Astro.props;
---

<section class="section section--sm community">
  <div class="container">
    <header class="community__head">
      <div>
        <Eyebrow tone="gold-bright" class="community__eyebrow">{section.eyebrow}</Eyebrow>
        <h2 class="community__title">{section.title}</h2>
      </div>
      <p class="community__lede">
        {section.lede}{" "}
        <a class="community__cta arrow-link" href={ROUTES.community}>
          {section.ctaLabel} <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </header>

    {
      /* Span reaches CSS through `data-span`, not an inline style. It is a
         closed set of four values so CSS can enumerate them — and once these
         are Sanity documents, an editor reordering photos must not be able to
         emit a style attribute. */
    }
    <ul class="community__grid">
      {
        photos.map((photo) => (
          <li class="community__tile" data-span={photo.span}>
            <Picture
              src={photo.image}
              alt={photo.org}
              widths={[500, 900]}
              sizes="(max-width: 640px) 100vw, 40vw"
              class="community__photo"
            />
            <span class="community__scrim" aria-hidden="true" />
            <span class="community__caption">
              <span class="community__org">{photo.org}</span>
              <span class="community__sub">{photo.caption}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <ul class="community__partners">
      {
        partners.map((partner) => (
          <li>
            <Picture src={partner.logo} alt={partner.name} class="community__logo" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* One step down the cream ladder from the news feed above, so the two read as
     separate sections rather than one long band. */
  .community {
    background: var(--dh-cream-300);
  }

  .community__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-7) var(--space-12);
    margin-bottom: var(--space-8);
  }

  .community :global(.community__eyebrow) {
    margin-bottom: var(--space-4);
  }

  .community__title {
    font-size: clamp(2.5rem, 4.6vw, 4.125rem);
    line-height: 0.94;
    color: var(--dh-ink);
  }

  .community__lede {
    max-width: 46ch;
    font-size: var(--text-xl);
    line-height: 1.65;
    color: #5b5545;
  }

  .community__cta {
    font-weight: 700;
    color: var(--dh-red-verdict);
    white-space: nowrap;
  }

  .community__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  /* A UNIFORM row height, as the comp has it — not a shared aspect-ratio.
     That distinction is the whole mosaic: tiles vary in width while their tops
     and bottoms line up, so the row reads as one band. With aspect-ratio the
     widest tile in a row sets the tallest height, every sibling stretches to
     match, and the ratios don't hold anyway — the rows just came out about 45%
     taller than the comp. Clamped so it scales down rather than squashing. */
  .community__tile {
    position: relative;
    height: clamp(150px, 17vw, 220px);
    border-radius: var(--radius-6);
    overflow: hidden;
    background: #c9bda4;
  }

  .community__tile[data-span="3"] {
    grid-column: span 3;
  }

  .community__tile[data-span="4"] {
    grid-column: span 4;
  }

  .community__tile[data-span="5"] {
    grid-column: span 5;
  }

  /* The full-width banner is deliberately shallower than a mosaic row. */
  .community__tile[data-span="12"] {
    grid-column: span 12;
    height: clamp(110px, 12vw, 150px);
  }

  .community__tile :global(.community__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .community__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 26, 22, 0) 42%, rgba(20, 26, 22, 0.82) 100%);
  }

  .community__caption {
    position: absolute;
    left: var(--space-5);
    right: var(--space-5);
    bottom: var(--space-4);
  }

  .community__org {
    display: block;
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1.2;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--dh-parchment);
  }

  .community__sub {
    display: block;
    margin-top: 3px;
    font-weight: 500;
    font-size: var(--text-label);
    line-height: 1.3;
    color: var(--dh-gold-light);
  }

  .community__partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-8) var(--space-13);
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid #e7dcc4;
    list-style: none;
  }

  /* Desaturated so seven different brand palettes don't compete with the
     photographs above; full colour on hover. */
  .community__partners :global(.community__logo) {
    height: 40px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.58;
    transition: filter var(--transition), opacity var(--transition);
  }

  .community__partners li:hover :global(.community__logo) {
    filter: grayscale(0);
    opacity: 1;
  }

  @media (max-width: 1100px) {
    /* Six tracks, so the 5/3/4 spans still tile: they halve cleanly into
       rows of two. */
    .community__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .community__tile[data-span="3"],
    .community__tile[data-span="4"],
    .community__tile[data-span="5"] {
      grid-column: span 3;
    }

    .community__tile[data-span="12"] {
      grid-column: span 6;
    }
  }

  @media (max-width: 640px) {
    .community__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .community__tile[data-span="3"],
    .community__tile[data-span="4"],
    .community__tile[data-span="5"],
    .community__tile[data-span="12"] {
      grid-column: span 1;
      height: clamp(180px, 52vw, 240px);
    }

    .community__partners {
      gap: var(--space-6) var(--space-8);
    }

    .community__partners :global(.community__logo) {
      height: 32px;
    }
  }
</style>
