---
// "Built for the cases that change a life." — a six-tab selector over the
// firm's lead practice areas, then the catastrophic-injury band.
import Eyebrow from "../Eyebrow.astro";
import PracticeIcon from "../icons/PracticeIcon.astro";
import AreaPanel from "./practice/AreaPanel.astro";
import CatastrophicBand from "./practice/CatastrophicBand.astro";
import type {
  PracticeAreaSummary,
  CatastrophicArea,
  PracticeSection,
} from "../../data/practiceAreas";
import { ROUTES } from "../../lib/routePaths";

interface Props {
  section: PracticeSection;
  areas: PracticeAreaSummary[];
  promise: string;
  catastrophic: CatastrophicArea[];
}

const { section, areas, promise, catastrophic } = Astro.props;
---

<section class="section pa">
  <div class="container">
    <header class="pa__head">
      <Eyebrow class="pa__eyebrow">{section.eyebrow}</Eyebrow>
      <h2 class="pa__title">
        {
          section.title.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </h2>
      <p class="pa__lede">{section.lede}</p>
    </header>

    <div class="pa__module">
      <div class="pa__tabs">
        <p class="pa__tabs-label" id="pa-tabs-label">{section.tabsLabel}</p>
        {
          /* A real tablist: roving tabindex, arrow-key navigation, and each tab
             owning its panel by id. The comp's version is six <button>s with an
             onClick and no relationship to the content they reveal. */
        }
        <div class="pa__tablist" role="tablist" aria-labelledby="pa-tabs-label">
          {
            areas.map((area, i) => (
              <button
                type="button"
                class="pa__tab"
                id={`area-tab-${area._key}`}
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={`area-panel-${area._key}`}
                tabindex={i === 0 ? 0 : -1}
              >
                <PracticeIcon name={area.iconKey} size={28} class="pa__tab-icon" />
                <span class="pa__tab-label">{area.name}</span>
                {/* Not `.arrow`: this marks which tab is selected, it does not
                    lead anywhere, so it gets no travel-on-hover affordance. */}
                <span class="pa__tab-chev" aria-hidden="true">&rarr;</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="pa__panels">
        {
          areas.map((area, i) => (
            <AreaPanel area={area} promise={promise} active={i === 0} />
          ))
        }
      </div>
    </div>

    <CatastrophicBand areas={catastrophic} title={section.catastrophicTitle} />

    <div class="pa__close">
      {/* The explicit space matters: the template collapses the whitespace
          between an expression and the next element, so the question would
          otherwise run straight into the CTA. */}
      <a class="pa__ask" href={ROUTES.contact}>
        {section.ask.text}{" "}
        <span class="pa__ask-cta arrow-link">
          {section.ask.cta} <span class="arrow" aria-hidden="true">&rarr;</span>
        </span>
      </a>
      <a class="btn btn--outline-ink arrow-link" href={ROUTES.practiceAreas}>
        View all practice areas <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .pa {
    background: var(--surface-alt);
  }

  .pa__head {
    max-width: 820px;
    margin-bottom: var(--space-11);
  }

  .pa :global(.pa__eyebrow) {
    margin-bottom: var(--space-4);
  }

  .pa__title {
    margin-bottom: var(--space-6);
    font-size: var(--display-1);
    line-height: 0.96;
    color: var(--dh-forest-400);
  }

  .pa__lede {
    max-width: 62ch;
    font-size: var(--text-xl);
    line-height: 1.7;
    color: #5a5445;
    text-wrap: pretty;
  }

  .pa__module {
    display: grid;
    /* minmax(0, …) on both tracks: the tab column holds a horizontal scroller
       and the panel column holds long copy, and a bare `fr` track refuses to
       shrink below its content's min-content. */
    grid-template-columns: minmax(0, 0.52fr) minmax(0, 1fr);
    gap: var(--space-11);
    align-items: start;
  }

  /* Grid items default to `min-width: auto`, which would let the scroller's
     contents set the column width instead of the other way round. */
  .pa__tabs,
  .pa__panels {
    min-width: 0;
  }

  .pa__tabs-label {
    margin-bottom: var(--space-3);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9aa093;
  }

  .pa__tablist {
    border-top: 1px solid rgba(27, 36, 30, 0.1);
  }

  .pa__tab {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    width: 100%;
    padding: var(--space-6) var(--space-5);
    border: 0;
    border-bottom: 1px solid rgba(27, 36, 30, 0.1);
    border-left: 3px solid transparent;
    background: transparent;
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: 0.03em;
    text-align: left;
    text-transform: uppercase;
    color: var(--dh-forest-400);
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition),
      border-color var(--transition);
  }

  .pa__tab:hover {
    background: rgba(237, 231, 219, 0.55);
  }

  .pa__tab[aria-selected="true"] {
    border-left-color: var(--accent-gold);
    background: #ede7db;
    font-weight: 800;
    color: var(--accent-gold);
  }

  .pa__tab-label {
    flex: 1;
  }

  .pa__tab :global(.pa__tab-icon) {
    flex: none;
    color: var(--dh-forest-100);
    transition: color var(--transition);
  }

  .pa__tab[aria-selected="true"] :global(.pa__tab-icon) {
    color: var(--accent-gold);
  }

  /* The chevron is only drawn on the active tab; `visibility` rather than
     `display` so the label's width doesn't shift as the selection moves. */
  .pa__tab-chev {
    display: inline-block;
    margin-left: auto;
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--accent-gold);
    visibility: hidden;
  }

  .pa__tab[aria-selected="true"] .pa__tab-chev {
    visibility: visible;
  }

  .pa__close {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-9);
  }

  .pa__ask {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--text-3xl);
    line-height: 1.4;
    color: var(--dh-forest-100);
  }

  .pa__ask-cta {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: 0.02em;
    color: var(--dh-red-verdict);
  }

  @media (max-width: 980px) {
    /* The vertical list becomes a horizontal chip rail above the panel — a
       0.52fr column of six uppercase labels has nowhere to go at this width. */
    .pa__module {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .pa__tablist {
      display: flex;
      gap: var(--space-2);
      overflow-x: auto;
      border-top: 0;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      /* Bleeds to the viewport edge so the rail can be scrolled from anywhere;
         the negative margin cancels the page gutter, which is why it reads the
         same token rather than restating the breakpoints. */
      margin-inline: calc(var(--container-pad) * -1);
      padding-inline: var(--container-pad);
      scroll-padding-inline: var(--container-pad);
    }

    .pa__tablist::-webkit-scrollbar {
      display: none;
    }

    .pa__tab {
      width: auto;
      flex: none;
      min-height: 44px;
      padding: var(--space-3) var(--space-5);
      border: 1px solid var(--dh-line-strong);
      border-radius: var(--radius-pill);
      font-size: var(--text-base);
      scroll-snap-align: start;
      white-space: nowrap;
    }

    /* The active marker moves from a left border to the whole chip filling. */
    .pa__tab[aria-selected="true"] {
      border-color: var(--accent-gold);
      background: var(--dh-gold-tint);
    }

    .pa__tab-chev {
      display: none;
    }

    .pa__tab-label {
      flex: 0 1 auto;
    }
  }

  @media (max-width: 640px) {
    .pa__close {
      flex-direction: column;
      align-items: stretch;
    }

    .pa__ask {
      font-size: var(--text-2xl);
    }
  }
</style>

<script>
  // Tab switching. Panels are all in the DOM already; this only moves the
  // `hidden` attribute and the selected state. With JS unavailable the first
  // panel stays visible and every tab is still a labelled heading for its
  // content, so nothing is lost but the switching.
  // SCOPED TO THIS COMPONENT'S OWN CLASS, NOT `[role="tablist"]`. A bare role
  // selector is global, and the homepage renders three tablists — this one,
  // NewsInsights' feed switch, and PromiseBand's carousel dots. This loop used
  // to claim all three. It double-bound the feed switch, which has its own
  // identical handler, and it broke the promise dots outright: they carry no
  // `aria-controls` and are driven by PromiseBand's `show()`, so an arrow key
  // here moved focus and flipped `aria-selected` while the slide stayed put.
  // Do not widen this back.
  for (const list of document.querySelectorAll<HTMLElement>(".pa__tablist")) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    if (tabs.length === 0) continue;

    const select = (index: number, moveFocus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        // Roving tabindex: only the selected tab is a tab stop, so Tab moves
        // past the whole group rather than through all six.
        tab.tabIndex = on ? 0 : -1;

        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !on;
      });
      if (moveFocus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
    });

    list.addEventListener("keydown", (event) => {
      const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (current === -1) return;

      // Home/End and wrapping arrows are what the tablist pattern promises once
      // role="tab" is on the element.
      const next = {
        ArrowRight: (current + 1) % tabs.length,
        ArrowDown: (current + 1) % tabs.length,
        ArrowLeft: (current - 1 + tabs.length) % tabs.length,
        ArrowUp: (current - 1 + tabs.length) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      }[event.key];

      if (next === undefined) return;
      event.preventDefault();
      select(next, true);
    });
  }
</script>
