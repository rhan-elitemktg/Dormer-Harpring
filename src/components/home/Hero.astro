---
// The homepage hero: full-bleed photograph, four stacked scrims, the
// transparent header, headline block and the four-up stat row.
//
// The header renders HERE rather than in Layout because the comp makes it a
// normal flex child of this section, stacked above the absolutely positioned
// photo on z-index alone. Emitting it from Layout would put it outside this
// stacking context, with nothing to sit on.
import { getImage } from "astro:assets";
import Header from "../Header.astro";
import PlayButton from "../media/PlayButton.astro";
import VideoPopover from "../media/VideoPopover.astro";
import { videoWatchUrl } from "../../lib/video";
import HeroStats from "./hero/HeroStats.astro";
import type { HomeHero } from "../../data/home";
import type { FirmStat } from "../../data/stats";
import heroPhoto from "../../assets/team/skyline.jpg";
import heroTeam from "../../assets/team/skyline-crop.jpg";

interface Props {
  hero: HomeHero;
  stats: FirmStat[];
}

const { hero, stats } = Astro.props;

// Art direction, so this is a hand-built <picture> rather than <Picture>: the
// two sources are DIFFERENT CROPS, not resolutions of one image. The panorama's
// team sits in its right third and gets sliced off in a portrait viewport, so
// below 980px the source swaps to a crop framed on the team (cut in
// scripts/prep-assets.mjs). Everything else on the site still uses <Picture>.
const [desktop, teamCrop] = await Promise.all([
  getImage({ src: heroPhoto, widths: [1200, 1800, 2400], format: "webp" }),
  getImage({ src: heroTeam, widths: [500, 800, 1400], format: "webp" }),
]);
---

<section class="hero">
  {
    /* The clipping lives on this wrapper, NOT on the section. The comp puts
       `overflow: hidden` on an ancestor of the header, which would slice the
       nav's dropdown panels off at the section edge. Only the photo and scrims
       need clipping, and they are all in here. */
  }
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source media="(min-width: 981px)" srcset={desktop.srcSet.attribute} sizes="100vw" />
      <img
        src={teamCrop.src}
        srcset={teamCrop.srcSet.attribute}
        sizes="100vw"
        alt=""
        width={teamCrop.attributes.width}
        height={teamCrop.attributes.height}
        fetchpriority="high"
        decoding="sync"
        class="hero__photo"
      />
    </picture>
    {/* Four stacked scrims, in the comp's order: a left-weighted horizontal
        wash that carries the headline, a flat tint, then top and bottom
        gradients that seat the header and the stat row. */}
    <div class="hero__scrim hero__scrim--side"></div>
    <div class="hero__scrim hero__scrim--flat"></div>
    <div class="hero__scrim hero__scrim--top"></div>
    <div class="hero__scrim hero__scrim--bottom"></div>
  </div>

  <Header variant="transparent" />

  <div class="hero__inner container">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <span class="hero__rule" aria-hidden="true"></span>

    <h1 class="hero__title">
      {
        hero.headline.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </h1>

    <p class="hero__lede">{hero.lede}</p>

    <div class="hero__ctas">
      <a class="btn btn--red btn--lg" href={hero.primaryCta.href}>
        {hero.primaryCta.label}
      </a>

      {
        /* WAS AN INERT <button> — rendered as designed and doing nothing at all,
           because no video source existed. It has one now, and VideoPopover
           makes it an <a>: Wistia binds the click and opens the popover, and if
           its runtime is blocked or JS is off the href still reaches the film.
           The `.btn` classes are unchanged, so it looks exactly as drawn. */
      }
      <VideoPopover video={hero.videoCta.video}>
        <a
          class="btn btn--light btn--lg hero__video"
          href={videoWatchUrl(hero.videoCta.video)}
        >
          <PlayButton tone="dark" size={38} />
          {hero.videoCta.label}
        </a>
      </VideoPopover>
    </div>

    <HeroStats stats={stats} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    /* svh, not vh: on mobile `vh` measures the viewport with browser chrome
       retracted, so a 100vh hero is taller than the screen on first paint. */
    min-height: clamp(560px, 88svh, 880px);
    background: var(--dh-forest-500);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* <picture> is display:inline with no height of its own, so without this the
     img's `height: 100%` resolves against it, computes to auto, and the photo
     renders at its natural aspect across the top of the hero — leaving a hard
     edge partway down where the section background shows through. The wrapper
     has to carry the box; only the img can carry object-fit. */
  .hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Plain selector, not :global() — the <img> is in this component's own
     template now that art direction means a hand-built <picture>. */
  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right top;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
  }

  .hero__scrim--side {
    background: linear-gradient(
      90deg,
      rgba(18, 29, 22, 0.97) 0%,
      rgba(20, 32, 25, 0.92) 30%,
      rgba(24, 37, 29, 0.6) 46%,
      rgba(26, 39, 31, 0.16) 60%,
      rgba(26, 39, 31, 0) 70%
    );
  }

  .hero__scrim--flat {
    background: rgba(23, 36, 28, 0.18);
  }

  .hero__scrim--top {
    background: linear-gradient(180deg, rgba(20, 26, 22, 0.5) 0%, rgba(20, 26, 22, 0) 16%);
  }

  .hero__scrim--bottom {
    background: linear-gradient(0deg, rgba(18, 24, 20, 0.62) 0%, rgba(18, 24, 20, 0) 24%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-11) var(--space-16);
  }

  .hero__eyebrow {
    margin-bottom: var(--space-4);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--text-base);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #ede8db;
  }

  .hero__rule {
    display: block;
    width: 340px;
    max-width: 60%;
    height: 1px;
    margin-bottom: var(--space-7);
    background: rgba(244, 239, 231, 0.4);
  }

  .hero__title {
    margin-bottom: var(--space-7);
    font-size: var(--display-hero);
    /* The comp sets 0.9; this inherits the site's display default instead,
       which opens the two lines up a little. */
    line-height: var(--leading-display);
    letter-spacing: 0.005em;
    color: #f6f2e8;
  }

  .hero__lede {
    max-width: 60ch;
    margin-bottom: var(--space-10);
    font-size: var(--text-2xl);
    line-height: var(--leading-normal);
    color: #cdd4c8;
    text-wrap: balance;
  }

  .hero__ctas {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  /* Plain, not `:global()`: the <a> is in THIS template — VideoPopover wraps
     it rather than rendering it, for exactly this reason. */
  .hero__video {
    gap: var(--space-4);
  }

  @media (max-width: 980px) {
    /* The photo stops being a full-bleed background and becomes a fixed band,
       with the copy on the gradient beside it. `cover` on a portrait hero always
       takes its crop out of the SIDES, which is what cut the outer two attorneys
       off; and because the hero's height is set by its content, no
       `object-position` value stays correct as that content changes. A band is
       deterministic: --band is the one number that positions the photo and
       reserves the space, so the two cannot drift.

       The band sits at the TOP and the copy runs beneath it — by request, and
       matching the interior photo headers, which now use the same construction.
       It reads as a photograph the page opens with rather than a strip the copy
       stands on, and it puts the four of them above the fold instead of below
       three paragraphs of it. */
    .hero {
      --band: min(104vw, 520px);
      /* FLAT, not the radial. The wash below has to end in exactly the colour
         sitting behind the band's foot or the join shows as a hard edge, and
         `--grad-forest` is a different green at every y — around `--forest-100`
         near the top, where this band ends. */
      background: var(--dh-forest-500);
    }

    .hero__media picture {
      position: absolute;
      inset: 0 0 auto;
      height: var(--band);
    }

    /* Anchored top: the crop is 1.03, so on a wide tablet the band is shorter
       than the photo and something has to go. Keep the faces, lose the shoes. */
    .hero__photo {
      object-position: center top;
    }

    /* The dark green wash, bottom to top. Clear across the top third, where the
       faces are; opaque enough by 50% to carry the copy that overlaps the lower
       half; and fully `--dh-forest-500` by 80%, so it reaches the section
       background before the photo's own bottom edge does and there is nothing
       left to see a seam at.

       That last stop moved out from 68% when the copy moved down to 72%: at 68%
       the copy would have landed on flat colour with no picture left behind it,
       which is the overlap this is for. */
    .hero__media::after {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: var(--band);
      background: linear-gradient(
        180deg,
        rgba(25, 34, 28, 0) 34%,
        rgba(25, 34, 28, 0.55) 50%,
        var(--dh-forest-500) 80%
      );
    }

    /* The left-weighted wash and the flat tint both existed to carry copy over
       the picture. Nothing sits on it now, so both go and the photograph is left
       at full strength. The top scrim comes BACK, though — unlike the interior
       headers, this hero's header is transparent and does sit on the picture. */
    .hero__scrim--side,
    .hero__scrim--flat,
    .hero__scrim--bottom {
      display: none;
    }

    .hero__scrim--top {
      display: block;
      background: linear-gradient(180deg, rgba(20, 26, 22, 0.62) 0%, rgba(20, 26, 22, 0) 20%);
    }

    /* The copy OVERLAPS the photograph, starting 72% down the band — below the
       faces, which end at 32%, and inside the wash that carries it. A fraction
       of the band rather than a fixed offset, because the band itself is a
       fraction of the viewport: the relationship that has to hold is to the
       faces, not to a pixel count.

       The subtraction is the TRANSPARENT HEADER's height, not a nudge: it is a
       flex child of this section sitting above `.hero__inner`, so it has
       already pushed the copy down by its own ~70px before this padding
       applies. The interior headers need no equivalent, because there the
       header is rendered by the layout and sits outside the section entirely.
       Worth re-checking if the mobile header's 20px padding or 30px logo ever
       change. */
    .hero__inner {
      justify-content: flex-start;
      padding-top: calc(var(--band) * 0.72 - var(--space-18));
    }
  }

  @media (max-width: 640px) {
    /* No cap on a phone: at this width the band is already near the crop's own
       1:1, which is what keeps all four of them in frame. */
    .hero {
      --band: 104vw;
    }

    .hero__ctas {
      gap: var(--space-3);
    }
  }
</style>
