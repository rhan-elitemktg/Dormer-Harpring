---
// The homepage hero: full-bleed photograph, four stacked scrims, the
// transparent header, headline block and the four-up stat row.
//
// The header renders HERE rather than in Layout because the comp makes it a
// normal flex child of this section, stacked above the absolutely positioned
// photo on z-index alone. Emitting it from Layout would put it outside this
// stacking context, with nothing to sit on.
import { getImage } from "astro:assets";
import Header from "../Header.astro";
import PlayButton from "../media/PlayButton.astro";
import HeroStats from "./hero/HeroStats.astro";
import type { HomeHero, HomeStat } from "../../data/home";
import heroPhoto from "../../assets/home/hero.jpg";
import heroTeam from "../../assets/home/hero-team.jpg";

interface Props {
  hero: HomeHero;
  stats: HomeStat[];
}

const { hero, stats } = Astro.props;

// Art direction, so this is a hand-built <picture> rather than <Picture>: the
// two sources are DIFFERENT CROPS, not resolutions of one image. The panorama's
// team sits in its right third and gets sliced off in a portrait viewport, so
// below 980px the source swaps to a crop framed on the team (cut in
// scripts/prep-assets.mjs). Everything else on the site still uses <Picture>.
const [desktop, teamCrop] = await Promise.all([
  getImage({ src: heroPhoto, widths: [1200, 1800, 2400], format: "webp" }),
  getImage({ src: heroTeam, widths: [500, 800, 1400], format: "webp" }),
]);
---

<section class="hero">
  {
    /* The clipping lives on this wrapper, NOT on the section. The comp puts
       `overflow: hidden` on an ancestor of the header, which would slice the
       nav's dropdown panels off at the section edge. Only the photo and scrims
       need clipping, and they are all in here. */
  }
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source media="(min-width: 981px)" srcset={desktop.srcSet.attribute} sizes="100vw" />
      <img
        src={teamCrop.src}
        srcset={teamCrop.srcSet.attribute}
        sizes="100vw"
        alt=""
        width={teamCrop.attributes.width}
        height={teamCrop.attributes.height}
        fetchpriority="high"
        decoding="sync"
        class="hero__photo"
      />
    </picture>
    {/* Four stacked scrims, in the comp's order: a left-weighted horizontal
        wash that carries the headline, a flat tint, then top and bottom
        gradients that seat the header and the stat row. */}
    <div class="hero__scrim hero__scrim--side"></div>
    <div class="hero__scrim hero__scrim--flat"></div>
    <div class="hero__scrim hero__scrim--top"></div>
    <div class="hero__scrim hero__scrim--bottom"></div>
  </div>

  <Header variant="transparent" />

  <div class="hero__inner container">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <span class="hero__rule" aria-hidden="true"></span>

    <h1 class="hero__title">
      {
        hero.headline.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </h1>

    <p class="hero__lede">{hero.lede}</p>

    <div class="hero__ctas">
      <a class="btn btn--red btn--lg btn--block-sm" href={hero.primaryCta.href}>
        {hero.primaryCta.label}
      </a>

      {
        /* TODO(video): no source exists for any of the homepage's play buttons
           yet. Rendered as designed but inert — it gets a data-video-id and the
           lightbox once we have a host and IDs. */
      }
      <button type="button" class="btn btn--light btn--lg btn--block-sm hero__video">
        <PlayButton tone="dark" size={38} />
        {hero.videoCta.label}
      </button>
    </div>

    <HeroStats stats={stats} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    /* svh, not vh: on mobile `vh` measures the viewport with browser chrome
       retracted, so a 100vh hero is taller than the screen on first paint. */
    min-height: clamp(560px, 88svh, 880px);
    background: var(--dh-forest-500);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* <picture> is display:inline with no height of its own, so without this the
     img's `height: 100%` resolves against it, computes to auto, and the photo
     renders at its natural aspect across the top of the hero — leaving a hard
     edge partway down where the section background shows through. The wrapper
     has to carry the box; only the img can carry object-fit. */
  .hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Plain selector, not :global() — the <img> is in this component's own
     template now that art direction means a hand-built <picture>. */
  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right top;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
  }

  .hero__scrim--side {
    background: linear-gradient(
      90deg,
      rgba(18, 29, 22, 0.97) 0%,
      rgba(20, 32, 25, 0.92) 30%,
      rgba(24, 37, 29, 0.6) 46%,
      rgba(26, 39, 31, 0.16) 60%,
      rgba(26, 39, 31, 0) 70%
    );
  }

  .hero__scrim--flat {
    background: rgba(23, 36, 28, 0.18);
  }

  .hero__scrim--top {
    background: linear-gradient(180deg, rgba(20, 26, 22, 0.5) 0%, rgba(20, 26, 22, 0) 16%);
  }

  .hero__scrim--bottom {
    background: linear-gradient(0deg, rgba(18, 24, 20, 0.62) 0%, rgba(18, 24, 20, 0) 24%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-11) var(--space-16);
  }

  .hero__eyebrow {
    margin-bottom: var(--space-4);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--text-base);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #ede8db;
  }

  .hero__rule {
    display: block;
    width: 340px;
    max-width: 60%;
    height: 1px;
    margin-bottom: var(--space-7);
    background: rgba(244, 239, 231, 0.4);
  }

  .hero__title {
    margin-bottom: var(--space-7);
    font-size: var(--display-hero);
    /* The comp sets 0.9; this inherits the site's display default instead,
       which opens the two lines up a little. */
    line-height: var(--leading-display);
    letter-spacing: 0.005em;
    color: #f6f2e8;
  }

  .hero__lede {
    max-width: 60ch;
    margin-bottom: var(--space-10);
    font-size: var(--text-2xl);
    line-height: var(--leading-normal);
    color: #cdd4c8;
    text-wrap: balance;
  }

  .hero__ctas {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .hero__video {
    gap: var(--space-4);
  }

  @media (max-width: 980px) {
    /* The photo stops being a full-bleed background and becomes a fixed band
       anchored to the hero's bottom, with the copy in the gradient above it.
       `cover` on a portrait hero always takes its crop out of the SIDES, which
       is what cut the outer two attorneys off; and because the hero's height is
       set by its content, no `object-position` value stays correct as that
       content changes. A band is deterministic: --band is the one number that
       positions the photo and reserves the space, so the two cannot drift. */
    .hero {
      --band: min(97vw, 520px);
      background: var(--grad-forest);
    }

    .hero__media picture {
      position: absolute;
      inset: auto 0 0;
      height: var(--band);
    }

    /* Anchored top: the crop is 1.03, so on a wide tablet the band is shorter
       than the photo and something has to go. Keep the faces, lose the shoes. */
    .hero__photo {
      object-position: center top;
    }

    /* Feathers the band's bright sky into the gradient above it, so the join
       reads as one image rather than a seam. */
    .hero__media::after {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: var(--band);
      background: linear-gradient(
        180deg,
        var(--dh-forest-500) 0%,
        rgba(25, 34, 28, 0) 34%
      );
    }

    /* The left-weighted wash only works while there is empty space on the left
       to darken; with the team centred there isn't. It becomes a top-down wash
       instead — heavy under the copy, clearing before it reaches the faces. The
       comp's separate top scrim would double up on that, so it goes. */
    .hero__scrim--side {
      background: linear-gradient(
        180deg,
        rgba(18, 29, 22, 0.9) 0%,
        rgba(19, 30, 23, 0.7) 55%,
        rgba(22, 34, 27, 0.2) 100%
      );
    }

    .hero__scrim--top {
      display: none;
    }

    .hero__inner {
      justify-content: flex-start;
      padding-bottom: var(--band);
    }
  }

  @media (max-width: 640px) {
    /* Phones get a shallower band, cutting the photo at the waist so it reads
       as a portrait of the four of them rather than a full-length group shot —
       at this width the legs are a third of the hero and carry nothing. The
       band is anchored top, so shortening it trims from the bottom. */
    .hero {
      --band: 52vw;
    }

    .hero__inner {
      padding-top: var(--space-8);
    }

    .hero__ctas {
      gap: var(--space-3);
    }
  }
</style>
