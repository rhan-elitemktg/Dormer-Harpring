---
// "Outstanding results." — the first forest section, carrying three case-result
// cards.
import ResultCard from "./results/ResultCard.astro";
import type { CaseResult } from "../../data/home";
import { ROUTES } from "../../lib/routePaths";

interface Props {
  results: CaseResult[];
}

const { results } = Astro.props;
---

<section class="section section--forest results">
  <div class="container">
    <header class="results__head">
      <h2 class="results__title">Outstanding results.</h2>
      <a class="results__all arrow-link" href={ROUTES.results}>
        See all results <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </header>

    <div class="results__grid">
      {results.map((result) => <ResultCard result={result} />)}
    </div>
  </div>
</section>

<style>
  .results__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .results__title {
    font-size: var(--display-1);
  }

  .results__all {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: var(--text-sm);
    line-height: 1;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: #c8a55f;
  }

  .results__all:hover {
    color: var(--dh-gold-light);
  }

  .results__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 980px) {
    .results__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .results__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
