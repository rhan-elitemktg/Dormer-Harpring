---
// One blog teaser: the post's own card art, its category, its title.
//
// IT WAS A TINTED ICON PLATE, and the icon was a hand-typed `iconKey` matched
// against a glyph set, with the tint chosen in CSS off the same key. That is
// gone with the fields behind it — these cards reference real posts now, so the
// art is the post's, chosen once on the post rather than a fifth thing to fill
// in per card. `components/icons/InsightIcon.astro` had no other caller and was
// deleted with it; the four `[data-icon]` tint rules went the same way.
//
// `PostThumb` rather than a `<Picture>` of its own: 125 of the 186 posts have
// no card image, so the placeholder is the COMMON case here, and it is the same
// branded placeholder every other post card on the site falls back to. Two
// copies of that would drift the first time one was tweaked.
import PostThumb from "../../blog/PostThumb.astro";
import type { InsightTeaser } from "../../../data/news";

interface Props {
  post: InsightTeaser;
}

const { post } = Astro.props;
---

{
  /* <div>, not <span>: a span is phrasing content and cannot legally contain
     the <h3>. An <a> may wrap flow content, so the divs are fine inside it. */
}
<a class="artcard" href={post.href}>
  <div class="artcard__plate">
    <PostThumb
      image={post.image}
      widths={[400, 600, 800]}
      sizes="(max-width: 760px) 100vw, (max-width: 1180px) 50vw, 25vw"
      class="artcard__img"
    />
  </div>
  <div class="artcard__body">
    <span class="artcard__meta">{post.category}</span>
    <h3 class="artcard__title">{post.title}</h3>
    <span class="artcard__more arrow-link">
      Read article <span class="arrow" aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>

<style>
  .artcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--dh-white);
    border-radius: var(--radius-6);
    overflow: hidden;
    box-shadow: 0 14px 40px rgba(60, 52, 32, 0.08);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .artcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 48px rgba(60, 52, 32, 0.14);
  }

  /* The 16/11 frame is kept from the icon plate it replaces, so the card's
     proportions did not move when the art did. `overflow: hidden` is on
     `.artcard`, which already has the radius. */
  .artcard__plate {
    aspect-ratio: 16 / 11;
    background: var(--dh-cream-200);
  }

  /* Bound by an element in THIS template, not by the class handed to PostThumb
     — a passed-in class lands on the child's markup and never carries this
     file's cid. See README's note; `check:styles` exists for exactly this. */
  .artcard__plate :global(.artcard__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .artcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-6) var(--space-6) var(--space-7);
  }

  .artcard__meta {
    margin-bottom: var(--space-3);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #9a8c6e;
  }

  .artcard__title {
    flex: 1;
    margin-bottom: var(--space-5);
    font-size: var(--display-7);
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
    color: var(--dh-forest-300);
  }

  .artcard__more {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
