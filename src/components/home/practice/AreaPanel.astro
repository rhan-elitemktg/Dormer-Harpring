---
// One practice-area panel in the selector.
//
// EVERY panel is rendered server-side and hidden with the `hidden` attribute
// rather than swapped in by JS. This is six practice areas of copy: it has to
// be in the HTML for crawlers, and it has to survive JS failing to load.
import Picture from "../../media/Picture.astro";
import PracticeIcon from "../../icons/PracticeIcon.astro";
import type { PracticeAreaSummary } from "../../../data/practiceAreas";

interface Props {
  area: PracticeAreaSummary;
  promise: string;
  active: boolean;
}

const { area, promise, active } = Astro.props;
---

<div
  class="panel"
  id={`area-panel-${area._key}`}
  role="tabpanel"
  aria-labelledby={`area-tab-${area._key}`}
  hidden={!active}
  tabindex="0"
>
  <div class:list={["panel__media", !area.image && "panel__media--plate"]}>
    {
      area.image ? (
        <Picture
          src={area.image}
          alt={area.name}
          widths={[600, 900]}
          sizes="(max-width: 980px) 100vw, 55vw"
          class="panel__img"
        />
      ) : (
        /* No photograph yet — an icon plate rather than an empty box, so the
           card keeps its proportions while the library is filled in. */
        <div class="panel__plate">
          <PracticeIcon name={area.iconKey} size={64} />
          <span class="panel__plate-label">Photo</span>
        </div>
      )
    }
  </div>

  <div class="panel__body">
    <p class="panel__eyebrow">Practice Area</p>
    <h3 class="panel__name">{area.name}</h3>
    <p class="panel__detail">{area.blurb}</p>
    <p class="panel__promise">{promise}</p>
    <a class="btn btn--outline-ink arrow-link" href={area.href}>
      Learn more <span class="arrow" aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>

<style>
  .panel {
    background: var(--dh-white);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-panel);
  }

  .panel[hidden] {
    display: none;
  }

  .panel__media {
    background: #ede7db;
  }

  .panel__media--plate {
    background: #f0ece2;
  }

  .panel :global(.panel__img) {
    display: block;
    width: 100%;
    height: 238px;
    object-fit: cover;
  }

  .panel__plate {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    height: 340px;
    color: #9da79a;
  }

  .panel__plate-label {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .panel__body {
    /* Comp is 44px 52px 52px; 52 snaps to the scale's 48. */
    padding: var(--space-11) var(--space-12) var(--space-12);
  }

  .panel__eyebrow {
    margin-bottom: var(--space-4);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  .panel__name {
    margin-bottom: var(--space-4);
    font-size: var(--display-4);
    line-height: 1;
    color: var(--dh-forest-400);
  }

  .panel__detail {
    max-width: 62ch;
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--dh-ink-body);
  }

  .panel__promise {
    max-width: 62ch;
    margin-bottom: var(--space-8);
    font-size: var(--text-md);
    line-height: var(--leading-prose);
    color: #5a6258;
  }

  @media (max-width: 980px) {
    .panel__body {
      padding: var(--space-8) var(--space-7) var(--space-9);
    }
  }

  @media (max-width: 640px) {
    .panel :global(.panel__img) {
      height: 180px;
    }

    .panel__plate {
      height: 220px;
    }
  }
</style>
