---
// "We do it for these moments." — a horizontally scrolling rail alternating
// client videos and written reviews.
import Eyebrow from "../Eyebrow.astro";
import VideoCard from "./testimonials/VideoCard.astro";
import QuoteCard from "./testimonials/QuoteCard.astro";
import type { Testimonial, ReviewSummary } from "../../data/testimonials";
import { ROUTES } from "../../lib/routePaths";

interface Props {
  testimonials: Testimonial[];
  reviews: ReviewSummary;
}

const { testimonials, reviews } = Astro.props;
---

<section class="section section--forest-flat tmv">
  <div class="container">
    <header class="tmv__head">
      <div>
        <Eyebrow tone="on-dark" class="tmv__eyebrow">Testimonials</Eyebrow>
        <h2 class="tmv__title">We do it for these moments.</h2>
      </div>

      {
        /* Presentational only. This must NOT become AggregateRating JSON-LD —
           self-serving review markup on an organization is a Google policy
           violation, and it is one of the things wrong with the current site. */
      }
      <div class="tmv__rating">
        <svg class="tmv__google" width="34" height="34" viewBox="0 0 48 48" aria-hidden="true">
          <path
            fill="#4285F4"
            d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"
          ></path>
          <path
            fill="#34A853"
            d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"
          ></path>
          <path
            fill="#FBBC05"
            d="M11.69 28.18c-.44-1.32-.69-2.73-.69-4.18s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"
          ></path>
          <path
            fill="#EA4335"
            d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"
          ></path>
        </svg>
        <div>
          <span
            class="tmv__stars"
            role="img"
            aria-label={`${reviews.rating} out of 5 stars`}>★★★★★</span
          >
          <span class="tmv__count">
            <strong>{reviews.count}</strong> Client Reviews &middot; {reviews.rating} on {
              reviews.source
            }
          </span>
        </div>
      </div>
    </header>

    {
      /* tabindex makes the rail focusable, so a keyboard user can scroll it with
         the arrow keys — without it the only way through is tabbing card by
         card. aria-label explains what the focus stop is. */
    }
    <div
      class="tmv__rail noscroll"
      data-rail
      tabindex="0"
      role="group"
      aria-label="Client testimonials, scrollable"
    >
      <div class="tmv__track">
        {
          testimonials.map((testimonial) =>
            testimonial.kind === "video" ? (
              <VideoCard testimonial={testimonial} />
            ) : (
              <QuoteCard testimonial={testimonial} />
            )
          )
        }
      </div>
    </div>

    <div class="tmv__foot">
      <a class="btn btn--ghost arrow-link" href={ROUTES.testimonials}>
        Read all reviews <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
      <div class="tmv__nav">
        <button type="button" class="tmv__arrow" data-rail-prev aria-label="Previous testimonials">
          <span aria-hidden="true">&larr;</span>
        </button>
        <button type="button" class="tmv__arrow" data-rail-next aria-label="Next testimonials">
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .tmv {
    position: relative;
    overflow: hidden;
  }

  .tmv__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .tmv :global(.tmv__eyebrow) {
    margin-bottom: var(--space-4);
  }

  .tmv__title {
    font-size: var(--display-1);
  }

  .tmv__rating {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background: var(--dh-white);
    border-radius: var(--radius-5);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28);
  }

  .tmv__google {
    display: block;
    flex-shrink: 0;
  }

  .tmv__stars {
    display: block;
    font-size: var(--text-xl);
    line-height: 1;
    letter-spacing: 2px;
    color: #e8b84b;
  }

  .tmv__count {
    display: block;
    margin-top: var(--space-1);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.3;
    color: #3a342b;
  }

  .tmv__count strong {
    font-weight: 800;
  }

  /* Negative margin plus matching padding lets the rail bleed to the viewport
     edge while its first card still lines up with the container. */
  .tmv__rail {
    overflow-x: auto;
    margin-inline: calc(var(--container-pad) * -1);
    padding: 0 var(--container-pad) var(--space-2);
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-pad);
    overscroll-behavior-x: contain;
  }

  .tmv__track {
    display: flex;
    align-items: stretch;
    gap: var(--space-6);
    width: max-content;
  }

  .tmv__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-10);
  }

  .tmv__nav {
    display: flex;
    gap: var(--space-3);
  }

  .tmv__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 47px;
    height: 47px;
    padding: 0;
    border: 1px solid rgba(244, 239, 231, 0.4);
    border-radius: var(--radius-2);
    background: transparent;
    font-weight: 800;
    font-size: var(--text-base);
    line-height: 1;
    color: var(--dh-parchment);
    cursor: pointer;
    transition: border-color var(--transition), background-color var(--transition);
  }

  .tmv__arrow:hover:not(:disabled) {
    border-color: var(--dh-gold-light);
    color: var(--dh-gold-light);
  }

  .tmv__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  @media (max-width: 1280px) {
    .tmv__rail {
      margin-inline: calc(var(--space-8) * -1);
      padding-inline: var(--space-8);
      scroll-padding-inline: var(--space-8);
    }
  }

  @media (max-width: 760px) {
    /* Arrows stay on touch, rather than swapping to dots: there are nine cards,
       so a dot per card would be nine 8px targets in a row — unreadable as
       position and unhittable as controls. The arrows also already report the
       ends by disabling, which dots cannot do. */
    .tmv__foot {
      margin-top: var(--space-8);
    }

    .tmv__arrow {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 420px) {
    /* Stack rather than let the CTA and the arrows collide. */
    .tmv__foot {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
    }

    .tmv__nav {
      justify-content: flex-end;
    }
  }

  @media (max-width: 640px) {
    .tmv__rail {
      margin-inline: calc(var(--space-6) * -1);
      padding-inline: var(--space-6);
      scroll-padding-inline: var(--space-6);
    }
  }
</style>

<script>
  // The comp puts `onclick="document.getElementById('tRail').scrollBy(...)"` on
  // each button with a hardcoded 344px step. Moved onto data hooks here: inline
  // handlers break a Content-Security-Policy, and the step is derived from the
  // real card width so it stays correct when the card resizes at 640px.
  for (const rail of document.querySelectorAll<HTMLElement>("[data-rail]")) {
    const scope = rail.parentElement;
    const prev = scope?.querySelector<HTMLButtonElement>("[data-rail-prev]");
    const next = scope?.querySelector<HTMLButtonElement>("[data-rail-next]");
    const track = rail.firstElementChild;

    const step = () => {
      const card = track?.firstElementChild as HTMLElement | null;
      if (!card) return rail.clientWidth * 0.8;
      const gap = parseFloat(getComputedStyle(track as Element).gap) || 0;
      return card.offsetWidth + gap;
    };

    // Disable an arrow once the rail can go no further, so the control reflects
    // what it will actually do. 1px of slack absorbs sub-pixel scroll positions.
    const sync = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      if (prev) prev.disabled = rail.scrollLeft <= 1;
      if (next) next.disabled = rail.scrollLeft >= max - 1;
    };

    prev?.addEventListener("click", () => rail.scrollBy({ left: -step() }));
    next?.addEventListener("click", () => rail.scrollBy({ left: step() }));
    rail.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync, { passive: true });
    sync();
  }
</script>
