---
// Article-card icons, lifted from the comps' `bIcon()` helper (viewBox 0 0 24 24,
// stroke width 1.5, round caps and joins).
//
// The comp pairs each post with a built SVG *and* a `tint` hex on the data
// record. Both are functions of the category, so the data carries only an
// `iconKey`; the colours live here and in the card's CSS, where they belong.

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 52, class: className } = Astro.props;

type Shape = { d: string } | { cx: number; cy: number; r: number };

const ICONS: Record<string, Shape[]> = {
  // Claim value — a struck currency mark.
  value: [{ d: "M12 3v18" }, { d: "M6 7h9a3 3 0 010 6H6" }, { d: "M6 13h11" }],
  // The first 48 hours — a stopwatch.
  clock: [{ cx: 12, cy: 13, r: 8 }, { d: "M12 9v4l2.5 2" }, { d: "M9 3h6" }],
  // Dealing with insurers — a shield and tick.
  shield: [
    { d: "M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6z" },
    { d: "M9.2 11.8l2 2 3.4-3.8" },
  ],
  // The process — a checklist.
  steps: [
    { d: "M4 6h16" },
    { d: "M4 12h16" },
    { d: "M4 18h10" },
    { cx: 19, cy: 18, r: 1.6 },
  ],
};

const shapes = ICONS[name];

if (!shapes) {
  console.warn(`[InsightIcon] no icon for "${name}" — add it to ICONS.`);
}
---

{
  shapes && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={className}
    >
      {shapes.map((shape) =>
        "d" in shape ? <path d={shape.d} /> : <circle cx={shape.cx} cy={shape.cy} r={shape.r} />
      )}
    </svg>
  )
}
