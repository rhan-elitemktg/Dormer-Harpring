---
// The four glyphs on the contact page's info cards, lifted from the comp's
// `ico()` helper (viewBox 0 0 24 24, stroke width 1.8, round caps and joins).

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 17, class: className } = Astro.props;

type Shape =
  | { d: string }
  | { cx: number; cy: number; r: number }
  | { x: number; y: number; width: number; height: number; rx: number };

const ICONS: Record<string, Shape[]> = {
  phone: [
    { d: "M6 3h3l2 5-2.2 1.3a12 12 0 005.9 5.9L16 13l5 2v3a2 2 0 01-2.2 2A16.5 16.5 0 014 6.2 2 2 0 016 3z" },
  ],
  message: [{ d: "M21 12a8 8 0 01-11.6 7.1L4 20l.9-5.4A8 8 0 1121 12z" }],
  mail: [{ x: 3, y: 5, width: 18, height: 14, rx: 2 }, { d: "M21 7l-9 6-9-6" }],
  pin: [
    { d: "M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0116 0z" },
    { cx: 12, cy: 10, r: 2.5 },
  ],
};

const shapes = ICONS[name];

if (!shapes) {
  console.warn(`[ContactIcon] no icon for "${name}" — add it to ICONS.`);
}
---

{
  shapes && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={className}
    >
      {shapes.map((shape) =>
        "d" in shape ? (
          <path d={shape.d} />
        ) : "r" in shape ? (
          <circle cx={shape.cx} cy={shape.cy} r={shape.r} />
        ) : (
          <rect x={shape.x} y={shape.y} width={shape.width} height={shape.height} rx={shape.rx} />
        )
      )}
    </svg>
  )
}
