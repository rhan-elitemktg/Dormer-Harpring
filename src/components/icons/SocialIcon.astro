---
// Social glyphs, lifted verbatim from the comps' `soc()` helper (18×18,
// viewBox 0 0 24 24, fill: currentColor).
//
// A lookup rather than one file per glyph: the caller only ever has a platform
// name (which becomes a Sanity string field on `firmDetails.socials[]`), so a
// name→markup map is the shape the data already has.

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

const PATHS: Record<string, string[]> = {
  facebook: ["M15 8h-2c-.6 0-1 .4-1 1v2h3l-.5 3H12v7H9v-7H7v-3h2V8.5C9 6.6 10.6 5 12.5 5H15v3z"],
  linkedin: [
    "M6.5 8A1.5 1.5 0 116.5 5a1.5 1.5 0 010 3zM5 10h3v9H5v-9zm5 0h2.8v1.3h.04c.4-.7 1.4-1.5 2.9-1.5 3 0 3.6 2 3.6 4.6V19h-3v-4c0-1-.02-2.3-1.4-2.3s-1.6 1.1-1.6 2.2V19h-3v-9z",
  ],
  youtube: [
    "M21.6 8.2a2.5 2.5 0 00-1.7-1.8C18.3 6 12 6 12 6s-6.3 0-7.9.4A2.5 2.5 0 002.4 8.2 26 26 0 002 12a26 26 0 00.4 3.8 2.5 2.5 0 001.7 1.8C5.7 18 12 18 12 18s6.3 0 7.9-.4a2.5 2.5 0 001.7-1.8A26 26 0 0022 12a26 26 0 00-.4-3.8zM10 15V9l5 3-5 3z",
  ],
  tiktok: [
    "M16 4c.3 2 1.5 3.4 3.5 3.6v2.5c-1.2 0-2.4-.4-3.5-1.1v5.4A5.3 5.3 0 1110.7 9v2.7a2.6 2.6 0 102.6 2.6V4H16z",
  ],
  instagram: [
    "M12 8.7a3.3 3.3 0 100 6.6 3.3 3.3 0 000-6.6zm0 5.4a2.1 2.1 0 110-4.2 2.1 2.1 0 010 4.2z",
    "M16 3H8a5 5 0 00-5 5v8a5 5 0 005 5h8a5 5 0 005-5V8a5 5 0 00-5-5zm3.5 13A3.5 3.5 0 0116 19.5H8A3.5 3.5 0 014.5 16V8A3.5 3.5 0 018 4.5h8A3.5 3.5 0 0119.5 8v8z",
  ],
};

const key = name.toLowerCase();
const paths = PATHS[key];

// A social account whose glyph we don't have would otherwise render an empty
// 18px box. Better to render nothing and make the gap obvious in review.
if (!paths) {
  console.warn(`[SocialIcon] no glyph for "${name}" — add it to PATHS.`);
}
---

{
  paths && (
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      class={className}
    >
      {paths.map((d) => (
        <path d={d} />
      ))}
      {key === "instagram" && <circle cx="16.5" cy="7.5" r="1" />}
    </svg>
  )
}
