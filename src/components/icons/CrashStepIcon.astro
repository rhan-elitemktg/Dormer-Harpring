---
// The eight line icons on the "What to do after a car accident" timeline.
//
// A key→path lookup, the same construction as `PracticeIcon` and for the same
// reason: the caller holds an `iconKey` string, which is what a Sanity field
// will contain. The comp stores each of these as a `data:image/svg+xml` URI
// inside its `crashSteps` array — SVG markup in the data layer, which is the
// one thing AGENTS.md says the data layer must never carry, and which no editor
// could ever fill in. The geometry below is that markup, unchanged; only the
// stroke colour moves to `currentColor` so the caller owns it.

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 26, class: className } = Astro.props;

const ICONS: Record<string, string[]> = {
  police: ["M12 3l7 3v6c0 4-3 6.5-7 9-4-2.5-7-5-7-9V6z"],
  stethoscope: ["M6 3v6a6 6 0 0012 0V3M18 15a3 3 0 006 0"],
  camera: ["M3 8h4l2-3h6l2 3h4v11H3zM12 16a3.5 3.5 0 100-7 3.5 3.5 0 000 7z"],
  witnesses: [
    "M8 11a3.5 3.5 0 100-7 3.5 3.5 0 000 7zM2 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 5.5a3 3 0 010 6M18 20c0-2.5-1-4.6-2.6-5.6",
  ],
  "shield-check": ["M4 5h16v9c0 3.5-4 5.5-8 6-4-.5-8-2.5-8-6zM9 12l2.2 2.2L16 9.5"],
  "mic-off": ["M4 4l16 16M12 3a3 3 0 013 3v4M9 8v2a3 3 0 004.4 2.6M6 11v1a6 6 0 008.5 5.4M12 19v2"],
  "calendar-check": ["M4 5h16v15H4zM8 3v4M16 3v4M4 10h16M9 15l2 2 4-4"],
  pencil: ["M4 20h4L20 8l-4-4L4 16zM14 6l4 4"],
};

const paths = ICONS[name];
if (!paths) {
  throw new Error(
    `CrashStepIcon: no icon named "${name}". Add it here or fix the iconKey in the data.`
  );
}
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {paths.map((d) => <path d={d} />)}
</svg>
