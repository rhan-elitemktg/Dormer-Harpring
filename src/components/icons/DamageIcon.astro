---
// The ten line icons in the "What money can I actually get?" grid.
//
// Same construction as `PracticeIcon` and `CrashStepIcon`. Here the comp inlines
// the SVG directly in its markup rather than in its data, so nothing had to be
// lifted out of a data array — but the shapes still belong in a component
// rather than in ten copies of a <path>, and the caller still holds a key.
//
// Two shapes carry a `circle`, so the lookup is the tagged union `PracticeIcon`
// uses rather than a bare list of `d` strings.

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 23, class: className } = Astro.props;

type Shape = { d: string } | { cx: number; cy: number; r: number };

const ICONS: Record<string, Shape[]> = {
  bills: [{ d: "M5 3h14v18H5z" }, { d: "M12 8v7M8.5 11.5h7" }],
  "future-care": [
    { d: "M4 12a8 8 0 0 1 16 0" },
    { d: "M4 12v4a2 2 0 0 0 2 2h2v-6H4zM20 12v4a2 2 0 0 1-2 2h-2v-6h4z" },
    { d: "M12 20h4" },
  ],
  clock: [{ cx: 12, cy: 12, r: 8.5 }, { d: "M12 7.5V12l3 2" }],
  earning: [{ d: "M3 20l6-7 4 3 8-9" }, { d: "M21 7v4h-4" }],
  briefcase: [
    { d: "M3 7h18v12H3z" },
    { d: "M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" },
    { d: "M3 12h18" },
  ],
  heart: [{ d: "M12 20s-7-4.3-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.7-7 9-7 9z" }],
  mind: [
    { d: "M12 3a6 6 0 0 0-6 6c0 2 1 3 1 5h10c0-2 1-3 1-5a6 6 0 0 0-6-6z" },
    { d: "M9 17h6M10 20h4" },
  ],
  activity: [
    { cx: 12, cy: 5, r: 2 },
    { d: "M12 7v6M12 13l-3 7M12 13l3 7M7 10l10 0" },
  ],
  impairment: [
    { d: "M9 3v7a3 3 0 0 0 6 0V3" },
    { d: "M12 13v8" },
    { d: "M8.5 21h7" },
  ],
  scarring: [{ d: "M4 4l16 16" }, { d: "M8 4l-2 3 3 2-3 2 3 2-3 2 2 3" }],
};

const shapes = ICONS[name];
if (!shapes) {
  throw new Error(
    `DamageIcon: no icon named "${name}". Add it here or fix the iconKey in the data.`
  );
}
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {
    shapes.map((shape) =>
      "d" in shape ? (
        <path d={shape.d} />
      ) : (
        <circle cx={shape.cx} cy={shape.cy} r={shape.r} />
      )
    )
  }
</svg>
