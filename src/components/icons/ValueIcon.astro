---
// Core-value icons, lifted from the comps (viewBox 0 0 24 24, stroke
// currentColor, width 1.5, round caps and joins).
//
// The comp stores each icon as a raw SVG string on the data record and renders
// it through `dangerouslySetInnerHTML`. Here the data carries only an
// `iconKey` — markup in a content field is not something an editor can fill in,
// and it becomes an injection surface the moment the field is CMS-backed.

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 38, class: className } = Astro.props;

type Shape =
  | { t: "path"; d: string }
  | { t: "circle"; cx: number; cy: number; r: number; dash?: string; opacity?: number };

const p = (d: string): Shape => ({ t: "path", d });
const c = (cx: number, cy: number, r: number, dash?: string, opacity?: number): Shape => ({
  t: "circle",
  cx,
  cy,
  r,
  dash,
  opacity,
});

const ICONS: Record<string, Shape[]> = {
  commitment: [
    p("M12 8c0-2 1.5-3.5 3.5-3.5S19 6 19 8c0 .8-.3 1.5-.8 2"),
    p("M12 8c0-2-1.5-3.5-3.5-3.5S5 6 5 8c0 3 4 5.5 7 8 1-.8 2-1.6 2.8-2.4"),
    c(17.5, 15.5, 3.5),
    p("M16 15.5l1 1 2-2"),
  ],
  integrity: [
    p("M12 3v16M7 20h10"),
    p("M5 7h14M5 7l-2.2 5a2.2 2.2 0 0 0 4.4 0L5 7zM19 7l-2.2 5a2.2 2.2 0 0 0 4.4 0L19 7z"),
    p("M8 5l4-1 4 1"),
  ],
  compassion: [
    p("M12 20s-6.5-4.3-8.5-8.2C2.2 9.3 3.3 6.5 6 6c1.8-.3 3.2.8 4 2 .8-1.2 2.2-2.3 4-2 2.7.5 3.8 3.3 2.5 5.8"),
    p("M13 14l2.5-2.4 2.5 2.4"),
  ],
  community: [
    c(12, 7, 2.2),
    c(6, 9, 1.8),
    c(18, 9, 1.8),
    p("M8.5 17c0-2 1.5-3.5 3.5-3.5s3.5 1.5 3.5 3.5M3.5 16.5c0-1.6 1-2.8 2.5-2.8M20.5 16.5c0-1.6-1-2.8-2.5-2.8"),
  ],
  innovation: [
    p("M9 18h6M10 21h4"),
    p("M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.1 1 1.8v.3h5v-.3c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z"),
  ],
  teamwork: [
    c(12, 8, 2.2),
    c(6.5, 10, 1.8),
    c(17.5, 10, 1.8),
    p("M9 16c0-1.8 1.3-3 3-3s3 1.2 3 3M4 15c0-1.4.9-2.5 2.2-2.5M20 15c0-1.4-.9-2.5-2.2-2.5"),
    c(12, 17, 6.5, "2.5 2.5", 0.55),
  ],
};

const shapes = ICONS[name];

if (!shapes) {
  console.warn(`[ValueIcon] no icon for "${name}" — add it to ICONS.`);
}
---

{
  shapes && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={className}
    >
      {shapes.map((shape) =>
        shape.t === "path" ? (
          <path d={shape.d} />
        ) : (
          <circle
            cx={shape.cx}
            cy={shape.cy}
            r={shape.r}
            stroke-dasharray={shape.dash}
            opacity={shape.opacity}
          />
        )
      )}
    </svg>
  )
}
