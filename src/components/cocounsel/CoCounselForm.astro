---
// "Refer a case." — the co-counsel referral form.
//
// A REAL form, on the same terms as ContactForm: method="post", the browser's
// own validation, a server redirect to /thank-you. The comp's fake success
// panel is not ported here either — telling a referring lawyer their case is
// under review while discarding it is the same lie, told to someone who will
// follow up.
//
// It posts to the SAME endpoint as the consultation form, distinguished by a
// hidden `kind`. The payloads differ and probably want different inboxes, but
// that is a branch inside one handler rather than a second adapter and a second
// mail integration to stand up.
import type { CoCounselPage } from "../../data/coCounsel";
import { ROUTES } from "../../lib/routePaths";

interface Props {
  form: CoCounselPage["form"];
}

const { form } = Astro.props;
---

<section class="ccform" id="contact">
  <div class="container">
    <div class="ccform__card">
      <header class="ccform__head">
        <div>
          <h2 class="ccform__title">{form.title}</h2>
          <p class="ccform__lede">{form.lede}</p>
        </div>
        <p class="ccform__required">{form.requiredNote}</p>
      </header>

      <form method="post" action={ROUTES.consult} aria-describedby="ccform-disclaimer">
        <input type="hidden" name="kind" value="co-counsel" />
        <input type="hidden" name="redirectTo" value={ROUTES.thankYou} />
        <input type="hidden" name="source" value={Astro.url.pathname} />

        {
          /* Span comes from a data attribute rather than an inline style: a
             closed set of four widths, so CSS can enumerate it. */
        }
        <div class="ccform__grid">
          <label class="ccform__field" data-span="1">
            <span class="ccform__label">First name</span>
            <input
              class="ccform__input"
              type="text"
              name="first"
              autocomplete="given-name"
              maxlength="60"
              required
            />
          </label>

          <label class="ccform__field" data-span="1">
            <span class="ccform__label">Last name</span>
            <input
              class="ccform__input"
              type="text"
              name="last"
              autocomplete="family-name"
              maxlength="60"
              required
            />
          </label>

          <label class="ccform__field" data-span="2">
            <span class="ccform__label">Email</span>
            <input
              class="ccform__input"
              type="email"
              name="email"
              autocomplete="email"
              placeholder="you@firm.com"
              pattern="[^@\s]+@[^@\s]+\.[A-Za-z]{2,}"
              title="Enter a full email address, e.g. you@firm.com"
              maxlength="254"
              required
            />
          </label>

          <label class="ccform__field" data-span="2">
            <span class="ccform__label">Phone</span>
            <input
              class="ccform__input"
              type="tel"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              placeholder="(303) 555-0100"
              pattern="\(\d{3}\) \d{3}-\d{4}"
              title="Enter a phone number as (303) 555-0100"
              data-phone-mask
              required
            />
          </label>

          <label class="ccform__field" data-span="3">
            <span class="ccform__label">Name of law firm</span>
            <input
              class="ccform__input"
              type="text"
              name="firm"
              autocomplete="organization"
              maxlength="120"
              required
            />
          </label>

          <label class="ccform__field" data-span="2">
            <span class="ccform__label">Practice area of your case</span>
            <input class="ccform__input" type="text" name="area" maxlength="80" required />
          </label>

          <label class="ccform__field" data-span="1">
            <span class="ccform__label">Estimated worth</span>
            <input
              class="ccform__input"
              type="text"
              name="value"
              inputmode="numeric"
              placeholder="$250,000"
              maxlength="20"
              required
            />
          </label>

          <label class="ccform__field" data-span="6">
            <span class="ccform__label">Incident summary</span>
            <textarea
              class="ccform__input ccform__input--area"
              name="summary"
              rows="4"
              placeholder="What happened, where, and where the case stands today."
              required></textarea>
          </label>

          <label class="ccform__field" data-span="6">
            <span class="ccform__label">Why does this case need co-counsel?</span>
            <textarea
              class="ccform__input ccform__input--area"
              name="why"
              rows="4"
              placeholder="Trial support, venue, resources, expertise — tell us what you need."
              required></textarea>
          </label>
        </div>

        {/* Honeypot — see ContactForm for why it is clipped rather than hidden. */}
        <div class="ccform__trap" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="ccform__foot">
          <button type="submit" class="btn btn--red btn--lg arrow-link">
            {form.submitLabel} <span class="arrow" aria-hidden="true">&rarr;</span>
          </button>
          <p class="ccform__disclaimer" id="ccform-disclaimer">{form.disclaimer}</p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .ccform {
    padding-block: var(--space-section);
    background: var(--surface-page);
  }

  .ccform__card {
    padding: var(--space-14) var(--space-14) var(--space-12);
    border: 1px solid var(--dh-line);
    border-radius: var(--radius-8);
    background: var(--dh-white);
    box-shadow: 0 24px 60px rgba(60, 52, 32, 0.08);
  }

  .ccform__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-bottom: var(--space-9);
  }

  .ccform__title {
    margin-bottom: var(--space-3);
    font-size: var(--display-4);
    line-height: 1.02;
    color: var(--dh-ink);
  }

  .ccform__lede {
    max-width: 64ch;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--dh-ink-3);
  }

  .ccform__required {
    font-weight: 800;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--dh-gold-muted);
  }

  .ccform__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .ccform__field[data-span="1"] {
    grid-column: span 1;
  }

  .ccform__field[data-span="2"] {
    grid-column: span 2;
  }

  .ccform__field[data-span="3"] {
    grid-column: span 3;
  }

  .ccform__field[data-span="6"] {
    grid-column: span 6;
  }

  .ccform__label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 700;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--dh-ink-3);
  }

  .ccform__input {
    width: 100%;
    padding: var(--space-4);
    border: 1px solid #e4dcc8;
    border-radius: var(--radius-input);
    background: var(--surface-input);
    font-family: var(--font-body);
    /* 16px minimum: iOS Safari zooms the viewport on focus below that. */
    font-size: 1rem;
    line-height: 1.3;
    color: var(--dh-ink);
    transition: border-color var(--transition), background-color var(--transition);
  }

  .ccform__input::placeholder {
    color: var(--dh-ink-5);
  }

  .ccform__input:focus {
    border-color: var(--accent-gold);
    background: var(--dh-white);
    outline: none;
  }

  /* `:user-invalid`, NOT `:not(:placeholder-shown):invalid`. That older trick
     leans on the placeholder as a proxy for "has been typed in", and four
     fields here have no placeholder at all — `:placeholder-shown` can never
     match them, so they reddened the moment the page loaded, before anyone had
     touched them. `:user-invalid` means what we actually want: the visitor
     interacted with this field and left it wrong. */
  .ccform__input:user-invalid {
    border-color: var(--accent);
  }

  .ccform__input--area {
    resize: vertical;
    line-height: 1.5;
  }

  .ccform__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ccform__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-8);
    margin-top: var(--space-8);
  }

  .ccform__disclaimer {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: #9a917e;
  }

  /* Two columns, every field full width. The six-track grid only means anything
     while the short fields can sit beside each other. */
  @media (max-width: 900px) {
    .ccform__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ccform__field[data-span="1"],
    .ccform__field[data-span="2"],
    .ccform__field[data-span="3"],
    .ccform__field[data-span="6"] {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .ccform__card {
      padding: var(--space-10) var(--space-6) var(--space-9);
    }

    .ccform__foot .btn {
      width: 100%;
    }
  }
</style>

<script>
  // Shared with the consultation form.
  import "../../scripts/phoneMask";
</script>
