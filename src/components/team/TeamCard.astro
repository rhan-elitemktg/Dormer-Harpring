---
// One person in the team grid. An <a> when they have a page, a <div> when they
// do not — rather than an <a href="#">, which is a link that goes nowhere and
// which a keyboard user still has to tab through.
import Picture from "../media/Picture.astro";
import { initialsOf, type TeamMember } from "../../data/team";

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const Tag = member.href ? "a" : "div";
---

<Tag class="tcard" href={member.href}>
  <div class="tcard__thumb">
    {
      member.photo ? (
        <Picture
          src={member.photo}
          alt=""
          widths={[260, 400, 600]}
          sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, (max-width: 1180px) 33vw, 25vw"
          class="tcard__photo"
        />
      ) : (
        /* No photograph exists for this person. Their initials on the hatched
           ground, which reads as a placeholder rather than a failure. */
        <span class="tcard__initials" aria-hidden="true">
          {initialsOf(member.name)}
        </span>
      )
    }
    <span class="tcard__shade" aria-hidden="true"></span>
  </div>

  <p class="tcard__name">{member.name}</p>
  {member.memorial && <p class="tcard__memorial">In loving memory</p>}
  <p class="tcard__role">{member.role}</p>
</Tag>

<style>
  .tcard {
    display: flex;
    flex-direction: column;
  }

  /* The hatch shows through wherever there is no photograph, and sits under
     every thumb so a slow-loading image lands on it rather than on white. */
  .tcard__thumb {
    position: relative;
    aspect-ratio: 3 / 4;
    border: 1px solid #d2c7af;
    border-radius: var(--radius-4);
    overflow: hidden;
    background: repeating-linear-gradient(
      45deg,
      #e0d8c6,
      #e0d8c6 9px,
      #dad1bd 9px,
      #dad1bd 18px
    );
  }

  .tcard__thumb :global(.tcard__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .tcard__initials {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--display-4);
    letter-spacing: 0.04em;
    color: rgba(44, 59, 49, 0.32);
  }

  .tcard__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(31, 40, 34, 0) 55%,
      rgba(31, 40, 34, 0.45) 100%
    );
  }

  /* Newsreader here rather than the display face — the comps set the team
     names in the serif, which reads as people where Anton reads as signage. */
  .tcard__name {
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--display-7);
    line-height: 1.2;
    color: var(--dh-forest-100);
    transition: color var(--transition);
  }

  a.tcard:hover .tcard__name {
    color: var(--accent);
  }

  .tcard__memorial {
    margin-top: var(--space-1);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1.2;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-gold-deep);
  }

  .tcard__role {
    margin-top: 3px;
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: #8a806e;
  }
</style>
