---
// "Trial lawyers, and the team behind every case." — everyone but the two
// founding partners, who get their own cards above.
import TeamCard from "./TeamCard.astro";
import type { TeamMember } from "../../data/team";

interface Props {
  eyebrow: string;
  title: string;
  members: TeamMember[];
}

const { eyebrow, title, members } = Astro.props;
---

<section class="team">
  <div class="container">
    <header class="team__head">
      <p class="team__eyebrow">{eyebrow}</p>
      <h2 class="team__title">{title}</h2>
    </header>

    <ul class="team__grid">
      {
        members.map((member) => (
          <li>
            <TeamCard member={member} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team {
    padding-block: var(--space-section);
    background: var(--surface-sunk);
  }

  .team__head {
    max-width: 760px;
    margin-bottom: var(--space-13);
  }

  /* No rule on this one — the comp sets it as a plain tracked label rather than
     the site's standard eyebrow, and it opens a section that already has a
     heading doing the work. */
  .team__eyebrow {
    margin-bottom: var(--space-4);
    font-weight: 700;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dh-gold-deep);
  }

  .team__title {
    font-size: var(--display-3);
    line-height: 1;
    color: var(--dh-forest-100);
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-7);
    list-style: none;
    padding: 0;
  }

  @media (max-width: 1180px) {
    .team__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
</style>
