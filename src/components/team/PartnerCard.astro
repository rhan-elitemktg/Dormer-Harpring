---
// A founding partner: square portrait, clamped bio, link to their page.
//
// Their award badges came out by request. `member.awards` is still populated —
// the attorney bio renders the same six as a rail — so this is a display
// decision here, not a gap in the data.
import Picture from "../media/Picture.astro";
import Prose from "../prose/Prose.astro";
import type { TeamMember } from "../../data/team";

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
// One portrait per person now — this used to prefer a separate wider crop.
const portrait = member.photo;
---

<article class="pcard">
  {
    portrait && (
      <div class="pcard__frame">
        <Picture
          src={portrait}
          alt={member.name}
          widths={[400, 600, 900]}
          sizes="(max-width: 900px) 100vw, 45vw"
          class="pcard__photo"
        />
      </div>
    )
  }

  <div class="pcard__body">
    <h3 class="pcard__name">{member.name}</h3>
    <p class="pcard__role">{member.role}</p>

    {/* Clamped to three lines — the full bio is on their page. */}
    <Prose value={member.bio} class="pcard__bio" />

    {
      member.href && (
        <a class="btn btn--outline-ink pcard__cta arrow-link" href={member.href}>
          Read {member.name.split(" ")[0]}'s story{" "}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      )
    }
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--dh-line);
    border-radius: var(--radius-4);
    overflow: hidden;
    background: var(--dh-white);
  }

  /* `position: relative` + an absolutely positioned image, not just
     `aspect-ratio` on the box. On its own the ratio only sets a PREFERRED
     height: the in-flow <img> still contributes its intrinsic 3:4, the box
     grows to fit, and the crop never happens — which is why the portrait ran
     to the waist instead of stopping at the tie. Taking the image out of flow
     is what makes the ratio binding. */
  .pcard__frame {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--surface-sunk);
  }

  .pcard__frame :global(.pcard__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-9) var(--space-10) var(--space-10);
  }

  .pcard__name {
    margin-bottom: var(--space-2);
    font-size: var(--display-5);
    line-height: 1;
    color: var(--dh-ink);
  }

  .pcard__role {
    margin-bottom: var(--space-5);
    font-weight: 800;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--dh-gold-deep);
  }

  /* Three lines and no more. The rest is on their own page, and an unclamped
     790-word bio makes the two cards different heights on a two-up row. */
  .pcard :global(.pcard__bio .prose__p) {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--dh-ink-3);
    text-wrap: pretty;
  }

  /* The gap above the button belongs to the BIO, not the button. Setting it as
     the button's own `padding-top` overrides one half of `.btn`'s symmetric
     `padding: var(--space-5) var(--space-8)`, which pushes the label off centre
     inside a taller box — and the outline variant draws a border, so it shows.
     Flex item margins never collapse, so this is a guaranteed minimum. */
  .pcard :global(.pcard__bio) {
    margin-bottom: var(--space-7);
  }

  /* `margin-top: auto` so the CTA sits on the floor of the card and the pair
     line up across the row — it absorbs whatever slack the clamped bio leaves,
     on top of the minimum above. */
  .pcard__cta {
    align-self: flex-start;
    margin-top: auto;
  }

  @media (max-width: 640px) {
    .pcard__body {
      padding: var(--space-8) var(--space-6) var(--space-8);
    }

    .pcard__cta {
      align-self: stretch;
    }
  }
</style>
