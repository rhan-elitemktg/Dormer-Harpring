---
// "Areas we serve" — the eyebrow, headline and 18 city chips above the footer
// proper. Split out because it is a distinct band with its own grid behaviour,
// and because the chips become `serviceCity` references (with real landing
// pages) in the CMS phase.
import Eyebrow from "../Eyebrow.astro";
import { ROUTES } from "../../lib/routePaths";

interface Props {
  areas: string[];
}

const { areas } = Astro.props;
---

<div class="areas">
  <div class="container">
    <div class="areas__head">
      <div>
        <Eyebrow tone="on-dark" class="areas__eyebrow">Areas we serve</Eyebrow>
        <h2 class="areas__title">
          Serving injured Coloradans<br />across the Front Range.
        </h2>
      </div>
      <p class="areas__note">
        Based in Denver's RiNo district — representing clients throughout the metro
        area and statewide. Don't see your city? Call us.
      </p>
    </div>

    <ul class="areas__grid">
      {
        areas.map((area) => (
          <li>
            <a class="areas__chip" href={ROUTES.contact}>
              <svg
                class="areas__pin"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0116 0z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
              {area}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .areas {
    border-bottom: 1px solid var(--dh-line-dark);
    padding-block: var(--space-section-sm);
  }

  .areas__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    margin-bottom: var(--space-10);
  }

  .areas :global(.areas__eyebrow) {
    margin-bottom: var(--space-4);
  }

  .areas__title {
    font-size: var(--display-3);
    /* Overrides the h2 default (0.98) — this heading always wraps to two lines,
       and Anton's tight default closes the gap between them too far. */
    line-height: var(--leading-display-2);
    color: var(--text-on-dark);
  }

  .areas__note {
    max-width: 34ch;
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--text-on-dark-muted);
  }

  .areas__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .areas__chip {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-chip);
    background: rgba(255, 255, 255, 0.03);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-md);
    line-height: 1.2;
    color: var(--text-on-dark-2);
    transition: background-color var(--transition), color var(--transition);
  }

  .areas__chip:hover {
    background: rgba(199, 154, 84, 0.16);
    color: var(--dh-white);
  }

  .areas__pin {
    flex: none;
    color: var(--accent-gold);
  }

  @media (max-width: 1100px) {
    .areas__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 760px) {
    .areas__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .areas__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
