---
// "Areas we serve" — the eyebrow, headline and 18 city chips above the footer
// proper. Split out because it is a distinct band with its own grid behaviour,
// and because the chips become `serviceCity` references in the CMS phase.
//
// THE CHIPS ARE NOT LINKS, by request, and that is the whole point of them.
// They used to be <a href={ROUTES.contact}> — eighteen chips all pointing at
// the same page. Nothing was dead, but a linked city chip promises one of two
// things and the firm has neither: a landing page for that city (only nine of
// the eighteen have practice-area pages, and none has a page of its own) or an
// office there (there is one office, in Denver's RiNo district, which the note
// beside these chips already says).
//
// So they are <span>s. Same convention TeamCard.astro records for an attorney
// with no bio and AreaLinkList for the current page's own row: a control that
// looks like a link and does not behave like one is worse than plain text.
// The hover state went with the anchor — a hover on something that cannot be
// clicked reads as a broken control.
//
// If city landing pages are ever built, this goes back to being a link list
// and `ROUTES`/`routePaths` comes back with it.
import Eyebrow from "../Eyebrow.astro";

interface Props {
  areas: string[];
}

const { areas } = Astro.props;
---

<div class="areas">
  <div class="container">
    <div class="areas__head">
      <div>
        <Eyebrow tone="on-dark" class="areas__eyebrow">Areas we serve</Eyebrow>
        <h2 class="areas__title">
          Serving injured Coloradans<br />across the Front Range.
        </h2>
      </div>
      <p class="areas__note">
        Based in Denver's RiNo district — representing clients throughout the metro
        area and statewide. Don't see your city? Call us.
      </p>
    </div>

    <ul class="areas__grid">
      {
        areas.map((area) => (
          <li>
            <span class="areas__chip">
              <svg
                class="areas__pin"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0116 0z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
              {area}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .areas {
    border-bottom: 1px solid var(--dh-line-dark);
    padding-block: var(--space-section-sm);
  }

  .areas__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    margin-bottom: var(--space-10);
  }

  .areas :global(.areas__eyebrow) {
    margin-bottom: var(--space-4);
  }

  .areas__title {
    font-size: var(--display-3);
    /* Overrides the h2 default (0.98) — this heading always wraps to two lines,
       and Anton's tight default closes the gap between them too far. */
    line-height: var(--leading-display-2);
    color: var(--text-on-dark);
  }

  .areas__note {
    max-width: 34ch;
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--text-on-dark-muted);
  }

  .areas__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .areas__chip {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-chip);
    background: rgba(255, 255, 255, 0.03);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-md);
    line-height: 1.2;
    color: var(--text-on-dark-2);
    /* No transition and no :hover — nothing about this element changes on
       pointer-over now that it is a <span>. Both went with the anchor. */
  }

  .areas__pin {
    flex: none;
    color: var(--accent-gold);
  }

  @media (max-width: 1100px) {
    .areas__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 760px) {
    .areas__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .areas__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
