---
// The gold rule + uppercase label that opens roughly twenty sections across the
// comps. The rule is part of the mark, not decoration — never render the label
// without it.
//
// Styling lives in global.css (`.eyebrow`) rather than here because the same
// treatment is needed inside Portable Text renderers later, which sit outside
// this component's scoped-style boundary.
interface Props {
  /**
   * `gold`        the deep gold most light sections use (#B0873C)
   * `gold-bright` the brighter #C79A54 — News, Insights and Community only
   * `on-dark`     on a forest section
   */
  tone?: "gold" | "gold-bright" | "on-dark";
  /** Rules on both sides, for centred section openers. */
  center?: boolean;
  class?: string;
}

const { tone = "gold", center = false, class: className } = Astro.props;
---

<p
  class:list={[
    "eyebrow",
    tone === "on-dark" && "eyebrow--on-dark",
    tone === "gold-bright" && "eyebrow--gold-bright",
    center && "eyebrow--center",
    className,
  ]}
>
  <span><slot /></span>
</p>
