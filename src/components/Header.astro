---
// The site header. ONE component with two variants, because the comps' solid
// and transparent headers are byte-identical apart from the wrapper background:
//   solid        interior pages — #151E19 with a bottom hairline
//   transparent  homepage — absolutely positioned over the full-bleed hero
import Picture from "./media/Picture.astro";
import MobileNav from "./MobileNav.astro";
import { getNavItems } from "../data/navigation";
import { getFirmDetails } from "../data/site";
import { ROUTES, normalizePath } from "../lib/routePaths";
import logoWhite from "../assets/logo-white.webp";

interface Props {
  variant?: "solid" | "transparent";
}

const { variant = "solid" } = Astro.props;

const [nav, firm] = await Promise.all([getNavItems(), getFirmDetails()]);

// The caret marks an item that IS MEANT to have a submenu, which is a different
// question from whether one has been authored yet — `children: []` is "menu
// coming", `children` absent is "no menu". Testing `item.children` alone would
// conflate them only by accident, since an empty array is truthy.
const hasMenu = (item: (typeof nav)[number]) => item.children !== undefined;

// Mark the current page so the nav can show it as active. BOTH SIDES go
// through `normalizePath`, so the match cannot break on a trailing slash —
// ROUTES carries one and `Astro.url.pathname` may or may not, depending on how
// the page was reached. Comparing a stripped pathname against a raw ROUTES
// value silently dropped aria-current from every item when the site moved to
// trailing slashes.
const current = normalizePath(Astro.url.pathname);
---

<header class:list={["header", `header--${variant}`]}>
  <div class="header__inner container">
    <a href={ROUTES.home} class="header__logo" aria-label="Dormer Harpring — home">
      <Picture src={logoWhite} alt="Dormer Harpring" eager class="header__logo-img" />
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul class="header__list">
        {
          nav.map((item) => (
            <li class:list={["header__item", hasMenu(item) && "header__item--menu"]}>
              {item.href ? (
                <a
                  href={item.href}
                  class="header__link"
                  aria-current={current === normalizePath(item.href) ? "page" : undefined}
                >
                  {item.label}
                  {hasMenu(item) && <span class="header__caret" aria-hidden="true">▾</span>}
                </a>
              ) : (
                /* No destination authored yet — plain text, not a dead link. */
                <span class="header__link header__link--inert">
                  {item.label}
                  {hasMenu(item) && <span class="header__caret" aria-hidden="true">▾</span>}
                </span>
              )}

              {
                item.children && item.children.length > 0 && (
                  <ul class="header__menu">
                    {item.children.map((child) => (
                      <li>
                        <a
                          class="header__menu-link"
                          href={child.href ?? "#"}
                          target={child.external ? "_blank" : undefined}
                          rel={child.external ? "noopener" : undefined}
                          {...(child.href && current === normalizePath(child.href)
                            ? { "aria-current": "page" as const }
                            : {})}
                        >
                          {child.label}
                          {child.external && (
                            <span class="header__ext" aria-hidden="true">
                              ↗
                            </span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__aside">
      {/* NO "EN ESPAÑOL" BUTTON, and its absence is deliberate — removed by
          request. Every comp draws one, but no Spanish page exists and the
          button was a <button> with no handler: it announced a language the
          site cannot serve and did nothing when pressed. Re-add it as a real
          link, not a button, if a Spanish landing page is ever built. */}
      {
        /* aria-label is set unconditionally and matches the visible text,
           because below 420px the number is replaced by the icon and the link
           would otherwise have no accessible name at all. */
      }
      <a
        href={`tel:${firm.phoneE164}`}
        class="header__phone"
        aria-label={`Call ${firm.phone}`}
      >
        <svg
          class="header__phone-icon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M6.5 3h3l1.5 4-2 1.4a12 12 0 005.6 5.6L16 12l4 1.5v3a2 2 0 01-2.2 2A16.5 16.5 0 013.9 5.2 2 2 0 016 3z"
          ></path>
        </svg>
        <span class="header__phone-number">{firm.phone}</span>
        <span class="header__phone-note">Free Consultation. Available 24/7</span>
      </a>

      <MobileNav items={nav} phone={firm.phone} phoneE164={firm.phoneE164} />
    </div>
  </div>
</header>

<style>
  .header {
    position: relative;
    z-index: 20;
  }

  .header--solid {
    background: var(--surface-chrome);
    border-bottom: 1px solid var(--dh-line-dark);
  }

  /* Over the hero. Not absolute — the comp makes it a normal flex child of the
     hero <section>, sitting above the hero's absolutely positioned photo and
     gradient scrims on z-index alone. Rendered by Hero.astro, not Layout. */
  .header--transparent {
    z-index: 3;
    background: transparent;
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    padding-block: var(--space-6);
  }

  .header--transparent .header__inner {
    padding-block: var(--space-8);
  }

  .header__logo {
    flex: none;
    display: block;
  }

  .header__logo :global(.header__logo-img) {
    height: 44px;
    width: auto;
  }

  .header__nav {
    margin-left: var(--space-5);
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    white-space: nowrap;
  }

  .header__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--dh-cream-300);
    transition: color var(--transition);
  }

  .header__link:hover {
    color: var(--dh-gold-light);
  }

  .header__link[aria-current="page"] {
    color: var(--dh-gold-light);
  }

  .header__link--inert {
    cursor: default;
  }

  /* The comp sets 8px, which is too small to read as a chevron at all — it
     just looks like a speck. Bumped to the label size and given the gold so it
     reads as an affordance rather than punctuation. The glyph sits high in its
     em box, so a small nudge down optically centres it against the label. */
  .header__caret {
    font-size: var(--text-md);
    line-height: 1;
    color: var(--dh-gold-light);
    transform: translateY(1px);
  }

  .header__link:hover .header__caret {
    color: var(--dh-gold-light);
  }

  /* ---- Dropdowns -------------------------------------------
     Opened by :hover and :focus-within — no JS, and tabbing into the submenu
     keeps it open for keyboard users for free. Plain nested lists rather than
     role="menu"/menuitem: these are navigation links, not application menu
     commands, and the ARIA menu roles would promise arrow-key semantics we
     deliberately don't implement. */
  .header__item {
    position: relative;
  }

  .header__item--menu {
    /* Bridges the gap between the label and the panel so the pointer can cross
       without the menu closing under it. */
    padding-bottom: var(--space-4);
    margin-bottom: calc(var(--space-4) * -1);
  }

  .header__menu {
    position: absolute;
    top: 100%;
    left: calc(var(--space-4) * -1);
    z-index: 30;
    min-width: 230px;
    padding: var(--space-3);
    margin: 0;
    list-style: none;
    background: var(--surface-chrome);
    border: 1px solid var(--dh-line-dark);
    border-top: 2px solid var(--accent-gold);
    border-radius: var(--radius-chip);
    box-shadow: var(--shadow-card-dark);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease), visibility var(--dur-fast);
  }

  .header__item--menu:hover .header__menu,
  .header__item--menu:focus-within .header__menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__menu-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-2);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-md);
    line-height: 1.3;
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
    color: var(--text-on-dark-2);
    transition: background-color var(--transition), color var(--transition);
  }

  /* The page you are on, shown exactly as hover shows it — by request. A
     dropdown is closed until you reach for it, so this is not competing with
     the hover state, it is telling you where you already are the moment the
     menu opens.

     `aria-current` carries it rather than a class: the styling and the thing a
     screen reader announces are the same fact, and the top-level items in this
     same nav already work that way. A child with no href cannot be current —
     `child.href` is nullable, and normalizePath(undefined) would throw. */
  .header__menu-link:hover,
  .header__menu-link:focus-visible,
  .header__menu-link[aria-current="page"] {
    background: rgba(199, 154, 84, 0.16);
    color: var(--dh-white);
  }

  .header__ext {
    font-size: var(--text-sm);
    color: var(--accent-gold);
  }

  .header__aside {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .header__phone {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    text-align: right;
    white-space: nowrap;
    color: var(--dh-white);
  }

  .header--transparent .header__phone {
    text-shadow: 0 1px 10px rgba(20, 26, 22, 0.6);
  }

  .header__phone-number {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-phone);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--dh-white);
  }

  .header__phone-note {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #dce2d6;
  }

  .header__phone:hover .header__phone-number {
    color: var(--dh-gold-light);
  }

  /* MEASURED, not guessed: logo 144 + nav 640 + aside 300, plus the gaps and
     2×32px of container padding, needs 1192px. Below that the row cannot
     shrink — the logo is `flex: none`, the phone is nowrap — so it pushes the
     document wider than the viewport rather than wrapping. Hand off to the
     drawer at 1200.
     Re-measure this if a nav label changes length: "Testimonials" replacing
     "Attorneys" is what moved it from ~1150 to 1192. */
  @media (max-width: 1200px) {
    .header__nav {
      display: none;
    }
  }

  /* Hidden until the number itself has to go — see the 420px block. */
  .header__phone-icon {
    display: none;
  }

  @media (max-width: 640px) {
    .header__inner,
    .header--transparent .header__inner {
      padding-block: var(--space-5);
      gap: var(--space-4);
    }

    .header__aside {
      gap: var(--space-3);
    }

    .header__logo :global(.header__logo-img) {
      height: 30px;
    }

    /* Nothing in this bar can shrink — the logo is flex:none, the number is
       nowrap, and the drawer toggle is a fixed 44px — so the row has to be
       sized down deliberately or it simply overflows the viewport. At 375px the
       untrimmed row measures about 393px. */
    .header__phone-number {
      font-size: var(--text-xl);
    }

    /* The number is the only thing worth keeping at thumb size; the
       reassurance line costs a whole row and earns nothing. */
    .header__phone-note {
      display: none;
    }
  }

  @media (max-width: 420px) {
    /* Even trimmed, logo + number + toggle cannot fit a 320–390px viewport.
       The number becomes an icon: click-to-call is the single most valuable
       control in this header for an injury firm, so it stays put while the
       digits go. */
    .header__phone-icon {
      display: block;
    }

    .header__phone-number {
      display: none;
    }

    .header__phone {
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--dh-line-dark);
      border-radius: var(--radius-chip);
      background: rgba(255, 255, 255, 0.04);
    }
  }
</style>

<script>
  // The dropdowns are pure CSS (:hover / :focus-within). The one thing CSS
  // can't do is dismiss an open menu on Escape, because the menu is held open
  // by focus living inside it — so move focus back out to the parent link.
  document.querySelector(".header__nav")?.addEventListener("keydown", (event) => {
    const e = event as KeyboardEvent;
    if (e.key !== "Escape") return;

    const item = (e.target as HTMLElement).closest(".header__item--menu");
    if (!item) return;

    e.stopPropagation();
    item.querySelector<HTMLElement>(".header__link")?.focus();
  });
</script>
