---
// "You only get one shot at this." — the heading spans both columns, then a
// photograph beside three paragraphs.
//
// Its own component rather than a variant of WhoWeAre: see the note there.
import Eyebrow from "../Eyebrow.astro";
import Picture from "../media/Picture.astro";
import Prose from "../prose/Prose.astro";
import type { AboutStory } from "../../data/aboutPage";

interface Props {
  story: AboutStory;
}

const { story } = Astro.props;
---

{
  /* Not `.section`: this band and WhatToExpect below it share one cream field
     and the gap between them is a single section's worth, not two. This one
     pads the top, that one pads the bottom. */
}
<section class="shot">
  <div class="container">
    <header class="shot__head">
      <Eyebrow class="shot__eyebrow">{story.eyebrow}</Eyebrow>
      <h2 class="shot__title">{story.title}</h2>
    </header>

    <div class="shot__grid">
      {
        /* The photograph is wrapped rather than being the grid item itself.
           <Picture> emits the source's intrinsic `width`/`height` attributes,
           and a bare `width: 100%` on that leaves the HEIGHT at the attribute —
           1377px for this square source, which `object-fit: cover` then crops
           into a tall strip and which sets the whole band's height. The frame
           owns the box; the image fills it. Same shape as WhoWeAre. */
      }
      <div class="shot__frame">
        <Picture
          src={story.photo}
          alt={story.photoAlt}
          widths={[600, 900, 1300]}
          sizes="(max-width: 980px) 100vw, 45vw"
          class="shot__photo"
        />
      </div>
      <Prose value={story.body} class="shot__body" />
    </div>
  </div>
</section>

<style>
  .shot {
    padding-top: var(--space-section);
    background: var(--surface-page);
  }

  .shot__head {
    max-width: 1000px;
    margin-bottom: var(--space-12);
  }

  .shot :global(.shot__eyebrow) {
    margin-bottom: var(--space-4);
  }

  .shot__title {
    font-size: var(--display-3);
    text-wrap: balance;
  }

  /* `minmax(0, …)` on both tracks: the copy column holds unbreakable words and
     would otherwise widen its track past the container. */
  .shot__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 660px);
    column-gap: var(--space-18);
    align-items: center;
  }

  /* An aspect ratio rather than the comp's `min-height: 500px`. The height is
     then a function of the column, so it stays proportionate at every width and
     there is no magic number to re-tune — and 4:3 is a gentle crop of a square
     source, where 500px against a ~510px column was very nearly none at all.
     The copy runs shorter than this and centres beside it, which is what the
     comp's `align-items: center` intends. */
  .shot__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-7);
    overflow: hidden;
    /* The comp's placeholder ground, behind a photograph that has not decoded
       yet rather than as a state of its own. */
    background: #efe7d6;
  }

  /* Absolutely positioned, so the frame alone decides the box: a percentage
     height on a replaced element resolves against an auto-height parent as
     `auto`, which is what let the intrinsic 1377px through in the first place. */
  .shot__frame :global(.shot__photo) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot :global(.shot__body) {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .shot :global(.shot__body .prose__p) {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--text-body);
  }

  @media (max-width: 980px) {
    .shot__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-10);
    }

    /* Nothing to undo on the photograph now — the frame's aspect ratio already
       follows the column, which at one column is the container. */
  }
</style>
