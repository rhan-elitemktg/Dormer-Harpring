---
// The ONE place the site opens a video.
//
// It marks the caller's trigger and nothing else. `scripts/videoLightbox.ts`
// delegates the click, builds a <dialog> and drops one <iframe> into it —
// `videoEmbedUrl()` in lib/video.ts owns that URL, as it owns every video URL
// on this site.
//
// NOTHING MUTATES THE TRIGGER, and that is the whole point of this shape.
// This used to be Wistia's class-based popover: its runtime parsed config off
// the wrapper's class names and then REPLACED the caller's <a> with a clone
// inside a `div.wistia_click_to_play`. Three separate bugs came out of that one
// behaviour, and they are recorded in `scripts/videoLightbox.ts` and
// `lib/video.ts` so nobody reintroduces it:
//
//   · it mounted a player per popover at load (1,010ms of blocking time on the
//     homepage, 10.7s of its 11.4s of main-thread work);
//   · deferring the load to first hover traded that for a VISIBLE rewrite —
//     a flash, and cards that changed height under the cursor;
//   · and it is why `.faq__video` and `.vcard` still declare `display: block`
//     and the `<li>` on /testimonials is `display: grid`. Those are correct on
//     their own merits now, but they were written for Wistia's div.
//
// `RailVideoCard`'s `height: 100%` was NOT correct on its own merits and is
// gone — see the comment there. It disabled `align-items: stretch` and then
// could not resolve, which is why those cards sat short until Wistia's div
// arrived and gave the percentage something to resolve against.
//
// THE TRIGGER IS THE CALLER'S <a> WITH A REAL href, still. The lightbox
// `preventDefault()`s it; with JS off, or if the module fails, the href reaches
// Wistia's hosted player. An inert control is the shape `TeamCard.astro` and
// `ProseLink.astro` argue against.
//
// YOUTUBE GETS NO LIGHTBOX, deliberately — `videoEmbedUrl` would hand back a
// `-nocookie` URL happily, but no record says `youtube` any more and shipping
// an untested branch is worse than shipping none. A `youtube` record renders
// its link with nothing around it.
import type { VideoRef } from "../../lib/video";

interface Props {
  video: VideoRef;
}

const { video } = Astro.props;
const isWistia = video.provider === "wistia";
---

{
  isWistia ? (
    <span class="vpop" data-video-lightbox={video.id}>
      <slot />
    </span>
  ) : (
    <slot />
  )
}

{/* NOT conditional, and that is deliberate rather than sloppy: Astro hoists
    `<script>` at COMPILE time, so it ships on any page that renders this
    component whatever the expression around it says — a `{isWistia && …}`
    guard here would read as a saving it cannot make. Hoisting is also what
    gives a page with nineteen popovers ONE copy. On a `youtube` record the
    module finds no triggers and does nothing, and the 302 pages that render no
    popover at all never load it. */}
<script>
  import "../../scripts/videoLightbox";
</script>


<style>
  /* Carries the trigger's id and nothing else, so it must not affect layout:
     `display: contents` takes it out of the box tree and the caller's <a> keeps
     its own place in its parent's grid or flex row.

     THAT IS NOW TRUE FOR THE LIFE OF THE PAGE. Under Wistia's runtime this was
     only true until it initialised, at which point a real div appeared here and
     became the layout box instead. Nothing replaces this element any more. */
  .vpop {
    display: contents;
  }
</style>
