---
// The ONE place the site opens a video in a popover.
//
// Same reasoning as `Picture.astro` and `PlayButton.astro`: the markup is not
// interesting, but having one owner is. Switching provider, changing the
// popover options, or replacing Wistia's runtime with a hand-rolled lightbox is
// one file rather than a grep for `wistia_` across nine components.
//
// THIS RENDERS THE WRAPPER, NOT THE TRIGGER. The caller supplies its own <a>
// as the slotted child. That looks like more work at each call site and it is
// the only shape that works:
//
//   Astro scopes a component's <style> to elements in THAT component's
//   template. Make this component render the trigger and the caller's class
//   lands on markup carrying THIS file's cid — so `.vcard`, `.trvid`,
//   `.bio__video` and the rest silently stop being styled. That is not
//   theoretical: the first cut of this component did exactly that and
//   check:styles caught 35 unmatchable rules across 25 pages.
//
//   For most of them the fix would be `:global()` bounded by an ancestor in
//   the caller's own template — but these classes ARE the caller's root
//   element, so there is no ancestor to bind to. `.vcard` is also rendered by
//   TWO different components with different styles, so an unbounded
//   `:global(.vcard)` would have them overwrite each other.
//
// So the caller keeps its element and its cid, and this keeps the Wistia
// contract. The href still comes from `videoWatchUrl()` — nothing outside
// `lib/video.ts` composes a video URL.
//
// THE TRIGGER MUST BE AN <a> WITH A REAL href. Wistia's `popoverContent=link`
// binds the anchor inside this wrapper; if its runtime is blocked, slow, or JS
// is off, that href still reaches the film. An inert <button> is the shape
// `TeamCard.astro` and `ProseLink.astro` both argue against.
//
// YOUTUBE GETS NO POPOVER, deliberately. Wistia's runtime only plays Wistia
// media, and adding YouTube's iframe API would mean a second video runtime plus
// the cookie conversation `videoEmbedUrl` documents. A `youtube` record renders
// its link untouched — this component simply adds nothing around it.
import {
  WISTIA_RUNTIME,
  wistiaMediaScript,
  wistiaPopoverClass,
  type VideoRef,
} from "../../lib/video";

interface Props {
  video: VideoRef;
}

const { video } = Astro.props;
const isWistia = video.provider === "wistia";
---

{
  isWistia ? (
    <span class:list={["vpop", wistiaPopoverClass(video.id)]}>
      <slot />
    </span>
  ) : (
    <slot />
  )
}

{
  /* `is:inline`, so Astro leaves a third-party runtime it cannot see alone.
     Both are `async`; neither blocks paint. Loaded per embed rather than from
     Layout, so the ~300 pages with no video never fetch a video player.

     KNOWN COST: a page with N popovers emits N identical pairs of these —
     15 on the homepage, 20 on /denver-car-accident-lawyer/. It is markup waste
     rather than a bug: same URL, so the browser fetches each once, and E-v1.js
     is idempotent by design. The .jsonp duplication disappears on its own once
     the placeholders are replaced and the ids actually differ.

     TODO(video): if the runtime tag is worth deduping, the fix is a `hasVideo`
     prop on Layout emitting it once in <head>. NOT a module-level "already
     emitted" flag in this file — Astro renders every page in one process, so
     that state leaks across pages and the second page onward silently loses
     its player. */
  isWistia && (
    <>
      <script is:inline async src={wistiaMediaScript(video.id)} />
      <script is:inline async src={WISTIA_RUNTIME} />
    </>
  )
}

<style>
  /* Carries Wistia's config classes and nothing else, so it must not affect
     layout: `display: contents` takes it out of the box tree entirely and the
     caller's <a> sits exactly where its own element used to.

     NOTE those config classes are PARSED BY WISTIA, not matched by CSS.
     Nothing anywhere may target `.wistia_embed` or `wistia_async_*` — they are
     data wearing a class attribute. */
  .vpop {
    display: contents;
  }
</style>
