---
// The pulsing play circle. Built as its own component because the homepage
// alone has ten of them (hero, five testimonial cards, the firm video, the FAQ
// panel), each needing the same ring animation on one of two backgrounds.
//
// `dark` is the glyph on a light surface (the hero's cream CTA); `light` is the
// glyph on a photo, where the ring has to carry a drop shadow to stay visible.

// `size` reaches CSS as an inline custom property, which is the one carve-out
// from the project's no-inline-styles rule. Elsewhere a data-driven value gets
// a `data-` attribute and an attribute selector, but that only works for a
// closed set (the community mosaic's six span widths). Diameter is an open
// numeric range, so enumerating it in CSS is not possible — and a custom
// property is a parameter the stylesheet reads, not a style overriding it.

interface Props {
  /**
   * `dark`   glyph on a light surface (the hero's cream CTA) — pulses
   * `light`  glyph on a photo, ring carries a shadow to stay visible — pulses
   * `accent` solid red on a photo. Deliberately static: these sit on a
   *          horizontally scrolling rail of five, and five rings pulsing at
   *          once is noise rather than emphasis.
   */
  tone?: "dark" | "light" | "accent";
  /** Diameter in px. The comps use 38 in buttons and 60–88 on video posters. */
  size?: number;
  class?: string;
}

const { tone = "dark", size = 38, class: className } = Astro.props;
---

<span
  class:list={["play", `play--${tone}`, className]}
  style={`--play-size:${size}px`}
  aria-hidden="true"
>
  <span class="play__glyph"></span>
</span>

<style>
  .play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--play-size);
    height: var(--play-size);
    border-radius: var(--radius-full);
    flex: none;
  }

  /* Longhands, not the `animation` shorthand. The shorthand resets every
     sub-property it doesn't name — including animation-play-state, which it
     would force back to `running` — and it does so at a higher specificity
     than the global `.play` rule that parks the pulse. That rule then silently
     loses and the ring loops on its own. Whether it runs is decided by the
     `.play` rules in global.css — which alone give a no-JS fallback of pulse
     on hover, freeze on leave; the script below upgrades that to finishing the
     cycle. This block only describes the animation itself. */
  .play--dark {
    background: var(--dh-parchment);
    border: 1.5px solid rgba(27, 36, 30, 0.45);
    animation-name: playPulseDark;
    animation-duration: 1.8s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .play--light {
    background: rgba(244, 239, 231, 0.94);
    animation-name: playPulseLight;
    animation-duration: 1.8s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .play--accent {
    background: var(--accent);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  /* The triangle is a CSS border trick rather than an SVG: it scales off the
     circle's size with no extra markup, and there is only ever one of them. */
  .play__glyph {
    width: 0;
    height: 0;
    border-left: calc(var(--play-size) * 0.29) solid var(--glyph, var(--dh-forest-400));
    border-top: calc(var(--play-size) * 0.185) solid transparent;
    border-bottom: calc(var(--play-size) * 0.185) solid transparent;
    margin-left: calc(var(--play-size) * 0.08);
  }

  .play--accent {
    --glyph: var(--dh-white);
  }

  @keyframes playPulseDark {
    0% {
      box-shadow: 0 0 0 0 rgba(27, 36, 30, 0.32);
    }
    70% {
      box-shadow: 0 0 0 13px rgba(27, 36, 30, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(27, 36, 30, 0);
    }
  }

  @keyframes playPulseLight {
    0% {
      box-shadow: 0 0 0 0 rgba(246, 242, 232, 0.65), 0 10px 30px -8px rgba(0, 0, 0, 0.45);
    }
    70% {
      box-shadow: 0 0 0 18px rgba(246, 242, 232, 0), 0 10px 30px -8px rgba(0, 0, 0, 0.45);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(246, 242, 232, 0), 0 10px 30px -8px rgba(0, 0, 0, 0.45);
    }
  }
</style>

<script>
  // Let the ring finish the cycle it is in when the pointer leaves.
  //
  // `animation-play-state: paused` freezes at the CURRENT frame, so a ring
  // caught mid-expansion just stops there — it reads as a glitch rather than a
  // rest state. CSS has no way to say "stop at the end of this iteration", so
  // the pause is deferred until the next `animationiteration` event.
  //
  // The inline style set here outranks the stylesheet, which is what keeps the
  // animation running after :hover has already stopped matching.
  for (const play of document.querySelectorAll<HTMLElement>(".play")) {
    const control = play.closest<HTMLElement>("a, button, [data-video]");
    if (!control) continue;

    let hovered = false;

    const start = () => {
      hovered = true;
      play.style.animationPlayState = "running";
    };

    const stop = () => {
      hovered = false;
      play.addEventListener(
        "animationiteration",
        () => {
          // Re-entered before the cycle closed — leave it running.
          if (!hovered) play.style.animationPlayState = "paused";
        },
        { once: true }
      );
    };

    control.addEventListener("pointerenter", start);
    control.addEventListener("pointerleave", stop);
    control.addEventListener("focusin", start);
    control.addEventListener("focusout", stop);
  }
</script>
