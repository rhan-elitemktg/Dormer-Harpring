---
// The mobile drawer. Entirely net-new: no comp has a mobile navigation, and the
// desktop nav's `▾` carets are decorative spans with no menus behind them.
//
// Sub-levels use <details>/<summary> rather than a drill-down panel stack.
// With no submenu IA authored yet, a panel stack would be machinery built for a
// shape we haven't been given; <details> costs no JS, is keyboard- and
// screen-reader-correct for free, and absorbs `children` unchanged the day the
// IA lands.
import type { NavItem } from "../data/navigation";
import { ROUTES } from "../lib/routePaths";

interface Props {
  items: NavItem[];
  phone: string;
  phoneE164: string;
}

const { items, phone, phoneE164 } = Astro.props;

// A parent with children renders as a <summary>, which TOGGLES rather than
// navigates — so unless one of its children points at the parent's own page,
// that page is unreachable from the drawer entirely. The header has no such
// problem: there the parent is a real link with the caret beside it.
//
// Most menus author that link themselves (Practice Areas ends with "View all
// practice areas"). This supplies one where none exists, so removing an entry
// that is redundant in the header cannot silently strip the only way in on a
// phone — and so a menu authored in the CMS later never depends on an editor
// remembering to add a link back to the section they are already inside.
const subItemsOf = (item: NavItem) => {
  const children = item.children ?? [];
  if (!item.href || children.some((child) => child.href === item.href)) return children;
  return [{ label: item.label, href: item.href }, ...children];
};
---

<div class="mnav">
  <button
    type="button"
    class="mnav__toggle"
    aria-expanded="false"
    aria-controls="mobile-drawer"
    data-drawer-toggle
  >
    <span class="visually-hidden">Open menu</span>
    <span class="mnav__bars" aria-hidden="true"></span>
  </button>

  <div class="mnav__overlay" data-drawer-overlay hidden></div>

  <div id="mobile-drawer" class="mnav__drawer" aria-label="Main" inert>
    <div class="mnav__bar">
      <span class="mnav__bar-title">Menu</span>
      <button type="button" class="mnav__close" data-drawer-close>
        <span class="visually-hidden">Close menu</span>
        {/* An SVG rather than the &times; glyph: a text × renders at an
            unpredictable size and optical weight per font, and this has to line
            up with the rows' chevrons below it. */}
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <nav class="mnav__body">
      <ul class="mnav__list">
        {
          items.map((item) => (
            <li>
              {item.children && item.children.length > 0 ? (
                <details class="mnav__group">
                  <summary class="mnav__summary">
                    {item.label}
                    <span class="mnav__chev" aria-hidden="true" />
                  </summary>
                  <ul class="mnav__sublist">
                    {subItemsOf(item).map((child) => (
                      <li>
                        <a class="mnav__sublink" href={child.href ?? "#"}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : item.href ? (
                <a class="mnav__link" href={item.href}>
                  {item.label}
                </a>
              ) : (
                <span class="mnav__link mnav__link--inert">{item.label}</span>
              )}
            </li>
          ))
        }
      </ul>

      <div class="mnav__foot">
        <a class="btn btn--red mnav__cta" href={ROUTES.contact}>Free case review</a>
        <a class="mnav__call" href={`tel:${phoneE164}`}>
          <span class="mnav__call-label">Call us — free, 24/7</span>
          <span class="mnav__call-number">{phone}</span>
        </a>
      </div>
    </nav>
  </div>
</div>

<style>
  /* The whole component only exists below the nav-collapse breakpoint. */
  .mnav {
    display: none;
  }

  @media (max-width: 1100px) {
    .mnav {
      display: block;
    }
  }

  .mnav__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--dh-line-dark);
    border-radius: var(--radius-chip);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-on-dark);
    cursor: pointer;
  }

  /* Three bars from one element: the middle is the box, the outer two are
     pseudo-elements offset from it. */
  .mnav__bars,
  .mnav__bars::before,
  .mnav__bars::after {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--dur-fast) var(--ease);
  }

  .mnav__bars::before,
  .mnav__bars::after {
    content: "";
    position: absolute;
  }

  .mnav__bars {
    position: relative;
  }

  .mnav__bars::before {
    transform: translateY(-6px);
  }

  .mnav__bars::after {
    transform: translateY(6px);
  }

  .mnav.is-open .mnav__bars {
    background: transparent;
  }

  .mnav.is-open .mnav__bars::before {
    transform: translateY(0) rotate(45deg);
  }

  .mnav.is-open .mnav__bars::after {
    transform: translateY(0) rotate(-45deg);
  }

  .mnav__overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(10, 16, 12, 0.6);
    opacity: 0;
    transition: opacity var(--transition);
  }

  .mnav.is-open .mnav__overlay {
    opacity: 1;
  }

  .mnav__drawer {
    position: fixed;
    inset-block: 0;
    right: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    width: min(380px, 86vw);
    background: var(--surface-chrome);
    color: var(--text-on-dark);
    transform: translateX(100%);
    transition: transform var(--transition);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mnav.is-open .mnav__drawer {
    transform: translateX(0);
  }

  .mnav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* Vertical padding trimmed because the close button now carries its own —
       keeps the bar the same height it was with the smaller 40px button. */
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--dh-line-dark);
  }

  .mnav__bar-title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  /* The bar and the nav list share the same 24px content edge, but a centred
     icon inside a padded button sits inboard of it — which left the × out of
     line with the chevrons on the rows below. Padding sets the touch target
     (22 + 2×16 = 54px), and an equal negative margin pulls that box back out so
     the icon itself lands flush on the content edge, in the chevrons' column. */
  .mnav__close {
    --close-inset: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--close-inset);
    margin-right: calc(var(--close-inset) * -1);
    border: 0;
    border-radius: var(--radius-chip);
    background: transparent;
    line-height: 0;
    color: var(--text-on-dark);
    cursor: pointer;
  }

  .mnav__close:hover {
    color: var(--dh-gold-light);
  }

  .mnav__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-4) var(--space-6) var(--space-8);
  }

  .mnav__list {
    list-style: none;
    padding: 0;
  }

  /* 56px rows: comfortably above the 44px touch-target minimum. */
  .mnav__link,
  .mnav__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 56px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--dh-line-dark);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--text-on-dark);
    cursor: pointer;
  }

  .mnav__link:hover,
  .mnav__summary:hover {
    color: var(--dh-gold-light);
  }

  .mnav__link--inert {
    color: var(--text-on-dark-muted);
    cursor: default;
  }

  .mnav__summary {
    list-style: none;
  }

  .mnav__summary::-webkit-details-marker {
    display: none;
  }

  .mnav__chev {
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--accent-gold);
    border-bottom: 2px solid var(--accent-gold);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform var(--transition);
    flex: none;
  }

  .mnav__group[open] .mnav__chev {
    transform: rotate(-135deg) translate(-3px, -3px);
  }

  .mnav__sublist {
    list-style: none;
    padding: var(--space-3) 0 var(--space-4) var(--space-4);
  }

  .mnav__sublink {
    display: block;
    padding-block: var(--space-3);
    font-size: var(--text-lg);
    color: var(--text-on-dark-2);
  }

  .mnav__sublink:hover {
    color: var(--dh-gold-light);
  }

  .mnav__foot {
    margin-top: auto;
    padding-top: var(--space-8);
  }

  .mnav__cta {
    width: 100%;
  }

  .mnav__call {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-6);
    text-align: center;
  }

  .mnav__call-label {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-micro);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
  }

  .mnav__call-number {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-phone);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--dh-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .mnav__drawer,
    .mnav__overlay {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".mnav");

  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>("[data-drawer-toggle]")!;
    const overlay = root.querySelector<HTMLElement>("[data-drawer-overlay]")!;
    const closeBtn = root.querySelector<HTMLButtonElement>("[data-drawer-close]")!;
    const drawer = root.querySelector<HTMLElement>(".mnav__drawer")!;

    const FOCUSABLE =
      'a[href], button:not([disabled]), summary, input, select, textarea, [tabindex]:not([tabindex="-1"])';

    const isOpen = () => root.classList.contains("is-open");

    const open = () => {
      // `hidden` is removed a frame before `is-open` is added, so the overlay
      // has a painted opacity:0 state to transition *from*. Setting both at
      // once makes it appear instantly instead of fading.
      overlay.hidden = false;
      requestAnimationFrame(() => root.classList.add("is-open"));
      document.body.classList.add("drawer-open");
      // `inert` (not just aria-hidden) so the closed drawer's links stay out of
      // the tab order and out of the accessibility tree entirely.
      drawer.removeAttribute("inert");
      toggle.setAttribute("aria-expanded", "true");
      toggle.querySelector(".visually-hidden")!.textContent = "Close menu";
      closeBtn.focus();
    };

    const close = () => {
      root.classList.remove("is-open");
      document.body.classList.remove("drawer-open");
      drawer.setAttribute("inert", "");
      toggle.setAttribute("aria-expanded", "false");
      toggle.querySelector(".visually-hidden")!.textContent = "Open menu";
      toggle.focus();
      // Keep the overlay painted until its fade-out finishes.
      window.setTimeout(() => {
        if (!isOpen()) overlay.hidden = true;
      }, 300);
    };

    toggle.addEventListener("click", () => (isOpen() ? close() : open()));
    overlay.addEventListener("click", close);
    closeBtn.addEventListener("click", close);

    document.addEventListener("keydown", (e) => {
      if (!isOpen()) return;

      if (e.key === "Escape") {
        close();
        return;
      }

      // Focus trap. `inert` keeps the page behind the drawer unreachable, but
      // it does not stop Tab from walking out to the browser chrome, so the
      // cycle is closed manually.
      if (e.key === "Tab") {
        const items = [...drawer.querySelectorAll<HTMLElement>(FOCUSABLE)].filter(
          (el) => el.offsetParent !== null
        );
        if (items.length === 0) return;

        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement;

        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Resizing past the breakpoint hides the toggle; without this the body
    // would stay scroll-locked with no visible way to unlock it.
    const wide = window.matchMedia("(min-width: 1101px)");
    wide.addEventListener("change", (e) => {
      if (e.matches && isOpen()) close();
    });
  }
</script>
