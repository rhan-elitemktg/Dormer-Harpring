---
// The site footer: service-area band, then a three-column body (brand/contact,
// practice areas, office + explore), then the legal bottom bar.
import Picture from "./media/Picture.astro";
import SocialIcon from "./icons/SocialIcon.astro";
import ServiceAreaBand from "./footer/ServiceAreaBand.astro";
import { getFirmDetails } from "../data/site";
import {
  getFooterNav,
  getFooterPracticeAreas,
  getServiceAreas,
} from "../data/navigation";
import { ROUTES } from "../lib/routePaths";
import logoWhite from "../assets/logo-white.webp";
import eliteMark from "../assets/elite-white.svg";

const [firm, practiceAreas, footerNav, serviceAreas] = await Promise.all([
  getFirmDetails(),
  getFooterPracticeAreas(),
  getFooterNav(),
  getServiceAreas(),
]);

const year = new Date().getFullYear();
// `firm.mapUrl`, not an address search: the short link opens the firm's own
// Google Business Profile, where an address query opens a dropped pin with no
// hours, no reviews and no "Directions" already primed.
const directionsUrl = firm.mapUrl;
---

<footer class="footer">
  <ServiceAreaBand areas={serviceAreas} />

  <div class="footer__body container">
    <div class="footer__brand">
      <Picture
        src={logoWhite}
        alt="Dormer Harpring — Denver personal injury lawyers"
        class="footer__logo"
      />
      <p class="footer__blurb">
        Denver personal injury lawyers who treat every client like a person, not a
        case number — and try cases other firms settle.
      </p>

      <div class="footer__contacts">
        <div>
          <p class="footer__label">Call</p>
          <a class="footer__number" href={`tel:${firm.phoneE164}`}>{firm.phone}</a>
        </div>
        <div>
          <p class="footer__label">Text</p>
          <a class="footer__number" href={`sms:${firm.smsE164}`}>{firm.sms}</a>
        </div>
      </div>

      <ul class="footer__socials">
        {
          firm.socials.map((social) => (
            <li>
              <a
                class="footer__social"
                href={social.href}
                aria-label={social.name}
                rel="noopener"
                target="_blank"
              >
                <SocialIcon name={social.name} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="footer__col" aria-labelledby="footer-practice">
      <h2 class="footer__heading" id="footer-practice">Practice Areas</h2>
      <ul class="footer__links">
        {
          practiceAreas.map((item) => (
            <li>
              <a class="footer__link" href={item.href ?? "#"}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading">Our Office</h2>
      <p class="footer__address">
        {firm.address.street}, {firm.address.unit}<br />
        {/* One line: a newline between two expressions is stripped rather than
            collapsed to a space, which rendered "Denver, CO80216". */}
        {firm.address.city}, {firm.address.region} {firm.address.postalCode}
      </p>
      <a class="footer__directions arrow-link" href={directionsUrl} rel="noopener" target="_blank">
        Get directions <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>

      <nav aria-labelledby="footer-explore">
        <h2 class="footer__heading footer__heading--spaced" id="footer-explore">
          Explore
        </h2>
        <ul class="footer__links footer__links--two">
          {
            footerNav.map((item) => (
              <li>
                <a class="footer__link" href={item.href ?? "#"}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__bottom-inner container">
      {/* The general-purposes / prior-results disclaimer was REMOVED from this
          bar by request. It is not gone from the site: the three pages that
          actually publish outcomes keep their own copy of it — `/results`
          (caseResults.ts), `/co-counsel` (coCounsel.ts) and `/testimonials`
          (testimonials.ts). Deliberate, not an oversight. */}
      <p class="footer__legal">
        &copy; {year} {firm.legalName}. All rights reserved.
      </p>
      {/* Editorial Guidelines was REMOVED from this list by request. The route
          stays in ROUTES and in RESERVED_PATHS, and the blog and practice-area
          fact-check bands still name "our comprehensive editorial guidelines"
          in prose without linking it — so if the page is ever built, this is
          where its link goes back. No comp ever carried this item. */}
      <ul class="footer__legal-links">
        <li><a href={ROUTES.privacy}>Privacy Policy</a></li>
        {/* The HUMAN sitemap. This was `/sitemap.xml` — a crawler file, linked
            from a footer, and never built: 328 dead links. The XML one belongs
            to /new-seo-setup with robots.txt, because every URL in it is
            absolute off `site:`, which is still an open www-vs-apex call. */}
        <li><a href={ROUTES.sitemap}>Sitemap</a></li>
        {/* The agency mark, last in the row so it sits bottom-right. External,
            so `rel="noopener" target="_blank"` — the same pair the socials and
            "Get directions" above already carry. The image's alt IS the link's
            accessible name here, because the <a> holds nothing else. */}
        <li class="footer__by">
          <a
            class="footer__by-link"
            href="https://www.elitelegalmarketing.com/"
            rel="noopener"
            target="_blank"
          >
            <Picture src={eliteMark} alt="Built by Elite Legal Marketing" class="footer__by-mark" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--surface-chrome);
    color: var(--text-on-dark-2);
    overflow: hidden;
  }

  .footer__body {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-14);
    padding-block: var(--space-section-sm) var(--space-16);
  }

  .footer :global(.footer__logo) {
    height: 52px;
    width: auto;
    margin-bottom: var(--space-6);
  }

  .footer__blurb {
    max-width: 38ch;
    margin-bottom: var(--space-8);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-on-dark-muted);
  }

  .footer__contacts {
    display: flex;
    gap: var(--space-10);
    margin-bottom: var(--space-8);
  }

  .footer__label {
    margin-bottom: var(--space-2);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-micro);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dh-on-dark-4);
  }

  .footer__number {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
    color: var(--text-on-dark);
  }

  .footer__number:hover {
    color: var(--dh-gold-light);
  }

  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .footer__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-on-dark-2);
    transition: background-color var(--transition), color var(--transition);
  }

  .footer__social:hover {
    background: var(--accent);
    color: var(--dh-white);
  }

  .footer__heading {
    margin-bottom: var(--space-5);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  .footer__heading--spaced {
    margin-top: var(--space-8);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .footer__links--two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3) var(--space-5);
  }

  .footer__link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-base);
    line-height: 1.2;
    color: var(--text-on-dark-2);
  }

  .footer__link:hover {
    color: var(--dh-white);
  }

  .footer__address {
    margin-bottom: var(--space-2);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-on-dark-2);
  }

  /* Layout comes from `.arrow-link` in global.css — don't restate it here. */
  .footer__directions {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: var(--text-label);
    line-height: 1;
    letter-spacing: var(--tracking-btn);
    text-transform: uppercase;
    color: var(--dh-gold-bright);
  }

  .footer__bottom {
    border-top: 1px solid var(--dh-line-dark);
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-7);
    padding-block: var(--space-6);
  }

  .footer__legal {
    max-width: 78ch;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--dh-on-dark-4);
  }

  .footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    white-space: nowrap;
  }

  .footer__legal-links a {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
  }

  .footer__legal-links a:hover {
    color: var(--dh-white);
  }

  /* The agency mark closes the row. `margin-left` rather than a wrapper: the
     list is already a flex row and this is its last item, so pushing it right
     inside the list keeps it aligned with the links' baseline row rather than
     floating it against the legal paragraph. */
  .footer__by {
    display: flex;
    align-items: center;
    margin-left: var(--space-2);
  }

  /* `flex`, not the inline default: an <img> in an inline box sits on the text
     baseline and leaves a few pixels of descender space under it, which would
     push the mark off the row's centre line. */
  .footer__by-link {
    display: flex;
    align-items: center;
  }

  /* Bounded by an element in THIS template — `.footer__by-mark` is a class
     handed to Picture, so it lands on Picture's <img> and carries Picture's
     cid, not this file's. A bare `.footer__by-mark {}` rule here would compile
     and match nothing; check:styles catches exactly this. */
  .footer__by-link :global(.footer__by-mark) {
    width: auto;
    height: 32px;
    /* The mark is white artwork on transparency and this bar is the chrome
       surface, so it needs no colour treatment — only the same muting the
       links beside it carry, so it reads as a credit and not as a third
       navigation item. It comes up to full strength on hover, which is this
       row's existing idiom: the links beside it go to --dh-white. */
    opacity: 0.55;
    transition: opacity var(--transition);
  }

  .footer__by-link:hover :global(.footer__by-mark) {
    opacity: 1;
  }

  @media (max-width: 980px) {
    .footer__body {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12) var(--space-10);
    }

    /* The brand column carries the logo, blurb, both numbers and the socials —
       it needs the full width once there are only two columns. */
    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer__body {
      grid-template-columns: 1fr;
    }

    .footer__contacts {
      gap: var(--space-8);
    }
  }
</style>
