  "faqs": [
    {
      "_key": "q1",
      "question": "Do I have to sue my neighbor after a dog bite?",
      "answer": [
        {
          "_type": "block",
          "_key": "bcfb",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "scfa",
              "text": "No, nearly all dog bite claims are filed against the owner’s insurance company, not the individual personally.",
              "marks": []
            }
          ]
        }
      ]
    },
    {
      "_key": "q2",
      "question": "What if the dog has never bitten anyone before?",
      "answer": [
        {
          "_type": "block",
          "_key": "bcfd",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "scfc",
              "text": "Colorado’s strict liability law still applies. The owner’s lack of knowledge about the dog’s temperament does not prevent recovery for serious bodily injury.",
              "marks": []
            }
          ]
        }
      ]
    },
    {
      "_key": "q3",
      "question": "Can children recover damages for a dog bite?",
      "answer": [
        {
          "_type": "block",
          "_key": "bcff",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "scfe",
              "text": "Yes, children often face additional non-economic damages tied to trauma, and parents may pursue claims on the child’s behalf.",
              "marks": []
            }
          ]
        }
      ]
    },
    {
      "_key": "q4",
      "question": "What if I was on the dog owner's property when bitten?",
      "answer": [
        {
          "_type": "block",
          "_key": "bcfh",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "scfg",
              "text": "You may still recover if you were lawfully present, such as an invited guest, though posted warning signs can affect the claim.",
              "marks": []
            }
          ]
        }
      ]
    }
  ],
