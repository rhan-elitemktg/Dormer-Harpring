      "children": [
        {
          "_type": "span",
          "_key": "sc8i",
          "text": "Every claim is different, but there are a few steps that tend to make a real difference along the way. Here’s where to start:",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "bc8p",
      "style": "normal",
      "markDefs": [
        {
          "_key": "lc8m",
          "_type": "link",
