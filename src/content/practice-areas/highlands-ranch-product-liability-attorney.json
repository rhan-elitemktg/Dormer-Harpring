    },
    {
      "_type": "block",
      "_key": "b89l",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s89k",
          "text": "What is Product Liability?",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b89n",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s89m",
          "text": "Product liability law is a part of personal injury law that serves to hold product manufacturers, designers, and retailers responsible for dangerous and defective products. When a consumer uses a product and gets hurt, they can sue for their injuries under product liability laws.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b89p",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s89o",
          "text": "There are three ways in which a product is dangerous or defective in its manufacturing, design, or in failure to warn on its use.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b89s",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s89q",
          "text": "Defective design.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s89r",
          "text": " The product was designed in an inherently dangerous or hazardous way",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b89v",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s89t",
          "text": "Manufacturing defect.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s89u",
          "text": " An error or problem in the manufacturing process led to a defective product",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b89y",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s89w",
          "text": "Failure to warn.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s89x",
          "text": " The retailer or distributor did not warn or instruct on the proper care or use of the product",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b8a0",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s89z",
          "text": "Colorado holds manufacturers, designers, and distributors liable for a consumer’s injuries when they use a product in any foreseeable way.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b8a2",
