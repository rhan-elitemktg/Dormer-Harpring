      "_key": "b79w",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s79v",
          "text": "Cell phone use prohibited except in emergencies",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b79y",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s79x",
          "text": "There are rules that must be obeyed by the trucking company, cargo company and truck driver. Unfortunately, many trucking companies break the rules and take shortcuts to save on time and money. Violating trucking laws increases the risk of truck accidents.",
          "marks": []
        }
      ]
    },
