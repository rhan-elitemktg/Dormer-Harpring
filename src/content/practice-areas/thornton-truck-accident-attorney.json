    {
      "_type": "block",
      "_key": "b79g",
      "style": "normal",
      "markDefs": [
        {
          "_key": "l79d",
          "_type": "link",
          "href": "https://www.fmcsa.dot.gov/"
        }
      ],
      "children": [
        {
          "_type": "span",
          "_key": "s79c",
          "text": "Unlike standard motor vehicles, commercial trucks come with special state and federal regulations to improve safety. These regulations are enforced by the ",
          "marks": []
        },
        {
          "_type": "span",
          "_key": "s79e",
          "text": "Federal Motor Carrier Safety Administration",
          "marks": [
            "l79d"
          ]
        },
        {
          "_type": "span",
          "_key": "s79f",
          "text": ". They include:",
          "marks": []
