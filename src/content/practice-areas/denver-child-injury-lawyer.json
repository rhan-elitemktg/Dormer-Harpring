    {
      "_type": "block",
      "_key": "b56c",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s56b",
          "text": "Hiring a lawyer could benefit you during any type of personal injury case in Colorado. However, it can be especially important to use a lawyer for a childhood injury claim due to unique elements involved in these cases, such as:",
          "marks": []
        }
      ]
    },
