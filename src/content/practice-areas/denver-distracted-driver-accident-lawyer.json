      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s5er",
          "text": "As a car accident victim in Denver, you may be eligible for several different types of financial compensation from a distracted driver’s insurance company. Obtaining a fair settlement or judgment award can make it easier for you to move forward with your life.",
          "marks": []
        }
