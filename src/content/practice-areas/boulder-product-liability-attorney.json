        {
          "_type": "span",
          "_key": "sa1q",
          "text": "What is Product Liability?",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "ba1t",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "sa1s",
          "text": "Product liability is an area of personal injury law. It refers to a defect or inherent dangerousness in the design or manufacture of a product. The defect or dangerousness of the product causes someone an injury even when the person uses the product correctly and for its true purpose.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "ba1v",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "sa1u",
          "text": "There are three types of product defects: design defects, manufacturing defects, and marketing defects.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "ba1y",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "sa1w",
          "text": "Design defect.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "sa1x",
          "text": " The product design itself is dangerous",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "ba21",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "sa1z",
          "text": "Manufacturing defect.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "sa20",
          "text": " The way the manufacturer created the product is dangerous",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "ba24",
