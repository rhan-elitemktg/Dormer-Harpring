      "children": [
        {
          "_type": "span",
          "_key": "s5iq",
          "text": "Pet insurance is meant to give pet owners peace of mind, especially as their pets get older and require more veterinary care. Pet insurance companies offer financial benefits for pet owners in exchange for premium payments made by the policyholder. If a pet insurance company fails to pay a legitimate claim, it is acting in bad faith. The Denver pet insurance bad faith lawyers at ",
          "marks": []
        },
        {
          "_type": "span",
          "_key": "s5is",
          "text": "Dormer Harpring, LLC",
          "marks": [
            "l5ir"
          ]
        },
        {
          "_type": "span",
          "_key": "s5it",
          "text": " can help you fight for fair financial benefits in this situation. ",
          "marks": []
        },
        {
          "_type": "span",
          "_key": "s5iv",
          "text": "Contact us",
          "marks": [
            "l5iu"
          ]
        },
        {
          "_type": "span",
          "_key": "s5iw",
          "text": " for a free case consultation with one of our attorneys.",
          "marks": []
        }
      ]
    },
