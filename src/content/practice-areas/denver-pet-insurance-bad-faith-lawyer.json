      "children": [
        {
          "_type": "span",
          "_key": "s5j9",
          "text": "Our Denver pet insurance bad faith lawyers operate on a contingency fee basis. This means you won’t pay us unless we secure financial compensation for your bad faith claim.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
