    {
      "_type": "block",
      "_key": "b8iq",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8ip",
          "text": "To file a premises liability claim, a visitor must meet specific qualifications and suffer an actual injury.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b8is",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8ir",
          "text": "Damages in a Premises Liability Claim",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b8iu",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8it",
          "text": "Colorado recognizes three types of visitors to a premises (Colorado Revised Statutes §13-21-115). These are trespassers, licensees, and invitees. A property owner owes each of these a different standard of care.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b8ix",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8iv",
          "text": "Trespassers.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s8iw",
          "text": " A trespasser enters a premises without the landowner’s consent.",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b8j0",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8iy",
          "text": "Licensees.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s8iz",
          "text": " A licensee is on land to advance the licensee’s interests but with permission.",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b8j3",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8j1",
          "text": "Invitees.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s8j2",
          "text": " An invitee is on a landowner’s property with their permission or at their request for mutual interests.",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b8j5",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8j4",
          "text": "Damages in a premises liability claim depend on which of the three legal visitor statuses a person was at the time of their injury.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b8j8",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8j6",
          "text": "Trespassers.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s8j7",
          "text": " A trespasser only receives damages when injuries were willfully or deliberately caused by the property owner.",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b8jb",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8j9",
          "text": "Licensees.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s8ja",
          "text": " A licensee recovers when the property owner failed to use reasonable care concerning dangers he or she knew about or unreasonably failed to warn of hazards he or she did not create and are not ordinarily present on the property.",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b8je",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8jc",
          "text": "Invitees.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s8jd",
          "text": " An invitee may recover damages caused by a landowner’s failure to use reasonable care to protect the invitee from dangers the landowner knew or should have known about.",
          "marks": []
        }
      ],
      "listItem": "number",
      "level": 1
    },
