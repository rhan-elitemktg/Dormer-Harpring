        {
          "_type": "span",
          "_key": "s9yi",
          "text": "At Dormer Harpring, we take on the tough cases that other firms refuse. If your concern is legal fees, we operate on a contingency fee basis. This means we only fees based on what we recover on your behalf.",
          "marks": []
        }
