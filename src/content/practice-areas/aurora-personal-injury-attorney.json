      "children": [
        {
          "_type": "span",
          "_key": "s9xu",
          "text": "Call Dormer Harpring today and schedule your free consultation. Even if you already have a settlement offer, one of our personal injury attorneys can review the offer to ensure it is fair and covers your current and future compensation needs.",
          "marks": []
        }
      ]
    },
