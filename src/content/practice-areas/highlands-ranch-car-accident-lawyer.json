        {
          "_type": "span",
          "_key": "s8pg",
          "text": "Traumatic brain injury (TBI).",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s8ph",
          "text": " Traumatic brain injury is either mild, moderate, or severe and ranges from a mild concussion to a loss of physical and cognitive function.",
