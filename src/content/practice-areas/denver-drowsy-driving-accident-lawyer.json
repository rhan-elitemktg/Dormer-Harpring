          "marks": [
            "l4hr"
          ]
        },
        {
          "_type": "span",
          "_key": "s4ht",
          "text": " compares it to drunk driving in how dangerous drowsy driving is, as both conditions affect reaction times, alertness and decision-making.",
          "marks": []
        }
      ]
