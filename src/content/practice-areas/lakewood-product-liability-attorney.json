        {
          "_type": "span",
          "_key": "s8w0",
          "text": "Our product liability lawyers will update you on your case and respond promptly to your calls, texts, and emails. We maintain a small case volume to provide you with the one-on-one service you deserve. Contact us today to schedule your free claim review.",
          "marks": []
        }
