      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8ve",
          "text": "Product liability cases are some of the most complex, time, and resource-consuming personal injury cases. They require seasoned product liability lawyers to prepare and persevere against large corporations and their legal departments. Dormer Harpring takes on tough product liability claims that other firms turn down.",
          "marks": []
        }
      ]
    },
