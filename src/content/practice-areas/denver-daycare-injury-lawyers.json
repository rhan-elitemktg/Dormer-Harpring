    {
      "_type": "block",
      "_key": "b23s",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s23r",
          "text": "Meet Laura Browne: Our Lead Daycare Injury Attorney",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b23u",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s23t",
          "text": "When a child has been injured, families deserve an attorney who understands both the legal issues and the emotional impact these cases have on parents.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b23w",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s23v",
          "text": "Laura Browne leads our firm’s daycare injury practice and is dedicated to representing children and families harmed by negligent daycare providers. She understands that daycare injury cases require more than simply proving an accident occurred—they often involve investigating staffing practices, licensing violations, safety protocols, surveillance footage, and whether a facility failed to meet Colorado’s standards for childcare.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b23y",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s23x",
          "text": "Laura works closely with families from the very beginning of a case, helping them understand what happened, preserve critical evidence, and pursue accountability against daycare centers, caregivers, and other responsible parties.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b240",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s23z",
          "text": "Whether a case involves negligent supervision, abuse, unsafe practices, or preventable incidents, Laura is committed to advocating for children and helping families secure the resources they need for recovery.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b242",
      "style": "h3",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s241",
