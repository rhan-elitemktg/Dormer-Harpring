    {
      "_type": "block",
      "_key": "b21k",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s21j",
          "text": "While minor scrapes and bruises are a normal part of childhood, serious injuries often point to preventable safety failures. Many daycare injury claims involve negligence that could have been avoided through proper staffing, supervision, or adherence to safety standards.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b21m",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
