          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b248",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s247",
          "text": "If your child has been seriously injured while at daycare:",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b24a",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s249",
          "text": "1. Seek immediate medical care.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b24c",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s24b",
          "text": "2. Document your child’s injuries",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b24e",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s24d",
          "text": "3. Request a written incident report from the daycare.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b24g",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s24f",
          "text": "4. Save all medical records and bills.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b24i",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s24h",
          "text": "5. Do not sign releases or settlement agreements without legal advice.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b24k",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s24j",
          "text": "6. Contact an experienced daycare injury attorney as soon as possible.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b24m",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s24l",
          "text": "Early action can make a significant difference in preserving evidence and protecting your child’s legal rights.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b24p",
      "style": "h2",
