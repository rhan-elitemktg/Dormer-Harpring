        {
          "_type": "span",
          "_key": "s930",
          "text": "What is Premises Liability?",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b933",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s932",
          "text": "Premises liability is an area of personal injury law. A premises liability claim arises when the negligence of a property owner or manager results in injuries to a visitor on that property. The most common premises liability claim is a slip and fall claim.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b935",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s934",
          "text": "Other premises liability claims are as follows:",
          "marks": []
        }
      ]
    },
