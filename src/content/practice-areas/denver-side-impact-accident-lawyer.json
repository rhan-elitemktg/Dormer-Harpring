          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b4fs",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s4fr",
          "text": "What Causes Side-Impact Accidents in Denver?",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b4fu",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s4ft",
          "text": "Side-impact collisions are often traced back to driver error. They frequently take place in intersections when one driver is careless, reckless or breaks a traffic law.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
