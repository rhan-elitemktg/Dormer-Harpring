      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s6dw",
          "text": "If a widely distributed product injures multiple victims, they may have grounds to join a mass tort or class action lawsuit for a more efficient legal process. Our lawyers can help you with these types of product liability claims in Thornton.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
