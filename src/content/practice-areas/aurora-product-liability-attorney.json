        }
      ],
      "children": [
        {
          "_type": "span",
          "_key": "s9i5",
          "text": "Call Dormer Harpring’s product liability attorneys as soon as possible. We will begin building your product liability claim right away. The sooner we start working on your case, the faster we can request compensation on your behalf. ",
          "marks": []
        },
        {
          "_type": "span",
          "_key": "s9i7",
          "text": "Contact us",
          "marks": [
