      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s9g7",
          "text": "Aurora Product Liability Attorneys Can Help You",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b9ga",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s9g9",
          "text": "Never face a product liability claim alone. Corporations have teams of lawyers and aggressive insurance adjusters working to protect their shareholders. You need your own legal team fighting for you. At Dormer Harpring, our product liability lawyers will start building your claim immediately after we meet.",
          "marks": []
        }
      ]
    },
