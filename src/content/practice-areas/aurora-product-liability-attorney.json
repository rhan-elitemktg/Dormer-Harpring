    {
      "_type": "block",
      "_key": "b9g6",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s9g5",
          "text": "Product liability cases compensate victims and hold companies responsible for placing dangerous products in consumers’ hands. Have your claim reviewed by Dormer Harpring at no cost and find out any legal options you may have available. We do not charge fees until we win your claim, so contact our office today.",
          "marks": []
        }
      ]
    },
    {
