      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s6wt",
          "text": "If you recently suffered an injury while on someone else’s property, such as at a grocery store, school, workplace, or a friend’s house, you may be entitled to financial compensation from the owner of the property or their insurance company. At Dormer Harpring, LLC, our Thornton premises liability attorneys will carefully investigate your accident and explain your legal rights. If we believe that you have a case, we can help you navigate the legal process for maximum financial compensation. Contact us today for a free case evaluation in Thornton, Colorado.",
          "marks": []
        }
      ]
    },
