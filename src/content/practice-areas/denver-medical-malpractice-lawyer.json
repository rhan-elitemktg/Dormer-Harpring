        }
      ],
      "children": [
        {
          "_type": "span",
          "_key": "scvf",
          "text": "If you have seen a patient you believe may have been the victim of medical malpractice, our ",
          "marks": []
        },
        {
          "_type": "span",
          "_key": "scvh",
