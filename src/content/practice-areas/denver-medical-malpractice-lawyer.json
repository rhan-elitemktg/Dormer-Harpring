          "marks": [
            "lcvg"
          ]
        },
        {
          "_type": "span",
          "_key": "scvi",
          "text": " are happy to discuss the case with you and/or your patient with a mind towards advising your patient of his or her legal options. We are open to handling the following types of cases, although we are very selective with them:",
          "marks": []
        }
      ]
