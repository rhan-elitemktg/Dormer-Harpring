      "children": [
        {
          "_type": "span",
          "_key": "sau0",
          "text": "Lost income",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "bau3",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "sau2",
          "text": "Lost earning potential",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "bau5",
