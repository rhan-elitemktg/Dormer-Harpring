          "marks": [
            "larf"
          ]
        },
        {
          "_type": "span",
          "_key": "sarh",
          "text": " is that when passing a bicyclist, a motorist is to allow at least three feet of space between the widest point of their vehicle and the widest point of the bicyclist. A motorist can cross a double yellow center line if there is no oncoming traffic to pass a bicyclist.",
          "marks": []
        }
