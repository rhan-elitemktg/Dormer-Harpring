    {
      "_type": "block",
      "_key": "bol",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "sok",
          "text": "This type of claim is different from a criminal case. The state brings charges to punish a wrongdoer, while a family seeks financial compensation through the civil system. The two move forward on separate tracks, so what happens in one does not determine what happens in the other.",
          "marks": []
        }
      ]
    },
    {
