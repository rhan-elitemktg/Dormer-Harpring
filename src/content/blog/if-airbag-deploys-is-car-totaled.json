          "_key": "s25o",
          "text": "Call Dormer Harpring at (303) 756-3812",
          "marks": [
            "l25n",
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s25p",
          "text": " to discuss your situation and learn how we can help guide the next steps.",
          "marks": []
        }
      ]
    },
