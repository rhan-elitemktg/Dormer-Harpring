      "children": [
        {
          "_type": "span",
          "_key": "s71j",
          "text": "Lane filtering is now legal in Colorado",
          "marks": [
            "strong"
          ]
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b71p",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s71l",
          "text": "Lane filtering is now permitted under Colorado law, effective August 7, 2024.",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s71m",
          "text": " Under SB24-079, motorcyclists operating properly endorsed bikes may legally ride between lanes of ",
          "marks": []
        },
        {
          "_type": "span",
          "_key": "s71n",
          "text": "stopped traffic",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s71o",
          "text": ", but only when particular conditions are met to promote safety and predictability on the road.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b71r",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s71q",
          "text": "To comply with the statute, riders must follow these rules:",
          "marks": []
        }
      ]
    },
    {
