    {
      "_type": "block",
      "_key": "b74z",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s74y",
          "text": "No, lane filtering is restricted to multi-lane roads where traffic is completely stopped. Filtering on a single-lane road poses a high risk of collision.",
