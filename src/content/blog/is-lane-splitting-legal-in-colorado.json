    },
    {
      "_type": "block",
      "_key": "b70q",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s70n",
          "text": "Lane splitting and riding between ",
          "marks": []
        },
        {
          "_type": "span",
          "_key": "s70o",
          "text": "moving",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s70p",
          "text": " vehicle lanes are illegal in Colorado. Unlike filtering, which only applies to stopped traffic, splitting involves weaving through active lanes, which increases collision risk.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b70t",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s70r",
          "text": "C.R.S. § 42-4-1503 requires motorcycles to remain within a single lane and prohibits overtaking vehicles within that lane. Attempting to split lanes can result in fines or fault in a crash.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b70v",
      "style": "h3",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s70u",
