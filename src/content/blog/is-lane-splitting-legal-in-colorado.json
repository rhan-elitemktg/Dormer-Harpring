      "listItem": "bullet",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b74x",
      "style": "h3",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s74w",
          "text": "Is lane filtering allowed on one-lane roads?",
          "marks": [
            "strong"
          ]
        }
