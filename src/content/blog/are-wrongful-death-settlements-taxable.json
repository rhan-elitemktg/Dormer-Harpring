      "_key": "b1zx",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s1zv",
          "text": "Strategic allocation:",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s1zw",
          "text": " Separating compensatory damages from punitive awards helps preserve non-taxable treatment.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_type": "block",
      "_key": "b200",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s1zy",
          "text": "Structured payments:",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s1zz",
          "text": " Spreading payments over time may reduce tax impact tied to interest or income thresholds.",
