      "_key": "bc73",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "sc72",
          "text": "Property loss or damage due to a commercial vehicle",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
