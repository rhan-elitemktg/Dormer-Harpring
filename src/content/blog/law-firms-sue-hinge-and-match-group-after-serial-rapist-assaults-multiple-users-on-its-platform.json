          "_type": "link",
          "href": "https://timesofindia.indiatimes.com/world/us/women-drugged-and-raped-by-colorado-cardiologist-on-dates-sue-tinder-and-hinge-for-accommodating-rapists/articleshow/126021772.cms"
        },
        {
          "_key": "l4nk",
          "_type": "link",
          "href": "https://www.theguardian.com/technology/2025/dec/16/hinge-tinder-date-rape-lawsuit"
        },
        {
          "_key": "l4nn",
