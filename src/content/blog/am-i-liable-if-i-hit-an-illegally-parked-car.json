      "children": [
        {
          "_type": "span",
          "_key": "s27n",
          "text": "Shared Responsibility:",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s27o",
          "text": " Both actions contribute to the collision under comparative fault",
