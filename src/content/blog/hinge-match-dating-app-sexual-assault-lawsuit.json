      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s3il",
          "text": "Remarkably, recent documents produced in the Jeffrey Epstein case suggest that similar safety failures occurred almost a decade earlier and at much higher levels.",
