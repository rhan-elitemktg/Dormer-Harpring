          "marks": [
            "strong"
          ]
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b5jn",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s5ji",
          "text": "If you’ve been injured in an accident and are unsure how Colorado’s modified comparative negligence rule applies to your case, our Personal Injury Lawyers at ",
          "marks": []
        },
        {
          "_type": "span",
          "_key": "s5jj",
          "text": "Dormer Harpring",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s5jk",
          "text": " can help. We will review your situation, explain your options, and fight for the compensation you deserve. Understanding the nuances of ",
          "marks": []
        },
        {
          "_type": "span",
          "_key": "s5jl",
          "text": "contributory negligence vs comparative negligence",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s5jm",
          "text": " is crucial in determining your eligibility for compensation.",
          "marks": []
