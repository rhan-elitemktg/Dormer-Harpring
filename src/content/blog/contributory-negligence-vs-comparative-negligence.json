        {
          "_type": "span",
          "_key": "s5jb",
          "text": "Dormer Harpring",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s5jc",
          "text": ", our team examines every angle—fault percentages, medical losses, and long-term effects—to build a case that reflects the full impact of your injuries. To discuss your claim, call ",
          "marks": []
        },
        {
          "_type": "span",
          "_key": "s5jd",
          "text": "(303) 747-4407",
          "marks": [
            "strong"
          ]
        },
        {
          "_type": "span",
          "_key": "s5je",
          "text": " or contact us today for a free consultation.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b5jh",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
