      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8q7",
          "text": "Injuries can show up in different ways, depending on where and how badly you were hurt. Paying attention to the signs early can help you get the right care, avoid bigger problems, and make sure everything is documented if legal action becomes necessary.",
          "marks": []
        }
      ]
