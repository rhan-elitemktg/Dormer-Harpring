          ]
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b8qq",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s8qp",
          "text": "Some symptoms aren’t easy to spot immediately, but that doesn’t mean they should be ignored. What seems minor at first could point to a more serious injury just beneath the surface.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
