          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b9qz",
      "style": "h3",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s9qy",
          "text": "See a Doctor Right Away",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b9r1",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s9r0",
          "text": "Even if the pain seems minor, don’t ignore it. A medical evaluation—including X-rays or an MRI—can reveal hidden injuries and prevent further complications.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b9r3",
      "style": "h3",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s9r2",
          "text": "Avoid Strenuous Activities",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b9r5",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s9r4",
          "text": "Until you know the extent of your injury, refrain from heavy lifting or any movements that could make it worse.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b9r7",
      "style": "h3",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s9r6",
          "text": "Document Your Symptoms",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b9r9",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "s9r8",
          "text": "Keep track of when your pain started and how it has progressed. This record will be helpful for both medical treatment and potential legal claims.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "b9rb",
      "style": "h3",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
