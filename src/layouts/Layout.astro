---
// The shared shell: <head>, fonts, global stylesheet, site-wide JSON-LD.
//
// The `seo` prop is accepted and threaded through from day one even though
// nothing supplies it yet — pages pass `null`. That is deliberate: when the
// editable-SEO layer is added, it attaches by filling this prop, with no edits
// to any page and no change to the rendered titles.
import Font from "astro/components/Font.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getFirmDetails } from "../data/site";
import { resolveSeo, SITE_NAME, type SeoInput } from "../lib/seo";
import { legalServiceSchema } from "../lib/schema";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** The page's Sanity `seo` block, once one exists. Every field optional. */
  seo?: SeoInput | null;
  /** Transparent over a full-bleed hero (homepage) vs solid (everywhere else). */
  headerVariant?: "solid" | "transparent";
  /** Extra classes on <body>, for page-level layout hooks. */
  bodyClass?: string;
}

const {
  title,
  description,
  seo = null,
  headerVariant = "solid",
  bodyClass,
} = Astro.props;

const firm = await getFirmDetails();

const meta = resolveSeo(seo, {
  fallbackTitle: title,
  fallbackDescription: description,
  pageUrl: Astro.url,
});

// `Astro.site` is set in astro.config.mjs; the fallback keeps a bare `astro dev`
// (which can run without it) from throwing inside the template literal below.
const siteUrl = (Astro.site?.href ?? "https://www.denvertrial.com/").replace(/\/+$/, "");
const organization = legalServiceSchema(firm, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{meta.title}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    <link rel="canonical" href={meta.canonical} />
    {meta.noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={meta.title} />
    {meta.description && <meta property="og:description" content={meta.description} />}
    <meta property="og:url" content={meta.canonical} />
    {meta.ogImage && <meta property="og:image" content={meta.ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    {/* THE FIRM'S OWN MARK — the DH monogram, white on #314641, taken from the
        live site's WordPress site-icon (uploads/2020/10/cropped-favicon-1-1.jpg).
        Until now this shipped ASTRO'S DEFAULT LOGO on all 332 pages.

        Generated from the 512px original rather than from WordPress's own 32px
        crop: that one is a JPEG already downsampled once, so resizing it again
        compounds the artifacts. favicon.ico carries 16 and 32 as PNG payloads.

        NO SVG, deliberately. There is no vector source for this mark anywhere —
        not in the comps (their SVGs are the practice-area icons), not in
        src/assets — and hand-tracing a monogram is design work, not a
        conversion. If the firm produces one, it goes here first with
        `type="image/svg+xml"` and browsers prefer it over the .ico.

        TODO(launch): the mark's #314641 is NOT on this site's forest ramp — the
        nearest is --dh-forest-100 #2c3b31, and the chrome is #151e19. It is the
        legacy site's green, carried over as-is because it is the firm's asset.
        Worth a decision with the designer. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-newsreader" />
    <Font cssVariable="--font-caveat" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization)}
    />

    {/* Marks JS as available before first paint, so `.lazy-fade` can start at
        opacity 0. Without the class a no-JS visitor would never see the image,
        since nothing would ever add `.is-loaded`. Inline and synchronous by
        necessity — a deferred script would run after the first paint. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>

    {
      /* Only the solid header lives here. The transparent one is a normal flex
         child INSIDE the hero <section> (stacked above the hero's absolutely
         positioned photo and scrims), exactly as the comp has it — so the
         homepage's Hero renders it itself. Layout emitting it would put it
         outside the hero's stacking context, where it has nothing to sit on. */
      headerVariant === "solid" && <Header variant="solid" />
    }

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // Fade each lazy image in once it has actually decoded.
      //
      // DELEGATED, WITH CAPTURE — not a listener per image, and that is
      // load-bearing. `load` does not bubble, but a capturing listener on the
      // document observes it anyway, and unlike a per-node listener it survives
      // the node being REPLACED.
      //
      // It used to attach one listener per <img> at parse time, which broke in
      // two ways once videos arrived. Wistia re-creates the markup around a
      // popover trigger, so those listeners went with the old nodes; and a lazy
      // image far down the page decodes whenever the reader scrolls to it,
      // which can be minutes later. Either way `.is-loaded` never landed and
      // the poster sat at `opacity: 0` — correctly sized, fully downloaded and
      // invisible. That is what emptied the FAQ thumbnail.
      const markLoaded = (event: Event) => {
        const img = event.target;
        if (img instanceof HTMLImageElement && img.classList.contains("lazy-fade")) {
          img.classList.add("is-loaded");
        }
      };

      // `error` too: a poster that 404s should still reveal whatever sits
      // behind it rather than leaving a permanently blank box.
      document.addEventListener("load", markLoaded, true);
      document.addEventListener("error", markLoaded, true);

      // Anything already decoded before this ran (cached, or finished during
      // parse) never fires an event, so sweep those once up front.
      for (const img of document.querySelectorAll<HTMLImageElement>("img.lazy-fade")) {
        if (img.complete) img.classList.add("is-loaded");
      }
    </script>
  </body>
</html>
